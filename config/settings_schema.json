  {
    "name": "Cart",
    "settings": [
      {
        "type": "header",
        "content": "Shipping Progress Bar Motivator"
      },
      {
        "type": "checkbox",
        "id": "shipping_threshold_enabled",
        "label": "Enable Shipping Progress Bar"
      },
      {
        "type": "text",
        "id": "shipping_threshold",
        "label": "Free Shipping Threshold",
        "info": "Integer number of cents so if it's $49.99, input 4999. Do not use double quotes (\")"
      },
      {
        "type": "text",
        "id": "shipping_threshold_locked_message",
        "label": "Shipping Threshold Locked Message",
        "default": "You're ${formatMoney(amountForFreeShipping)} from free shipping!",
        "info": "IMPORTANT: wherever part you choose to insert the amount, do so like this: ${formatMoney(amountForFreeShipping)} else it will break. Do not use double quotes (\")"
      },
      {
        "type": "text",
        "id": "shipping_threshold_unlocked_message",
        "label": "Shipping Threshold Unlocked Message",
        "default": "Congratulations! You got free shipping",
        "info": "This shows once the customer has unlocked free shipping (based on threshold). Do not use double quotes (\")"
      },
      {
        "type": "header",
        "content": "Upsell",
        "info": "How it works: Upsell can have at most 6 products. Each upsell product has an optional tag associatied with it. If an upsell product has a tag associated with it, it will only show if there's an item in cart that has the same tag. If product has not tag, it will appear by default. Upsell tag 1 has priority over tag 2 and so on."
      },
      {
        "type": "text",
        "id": "upsell_title",
        "label": "Upsell Products Section Title",
        "default": "You May Also Like:"
