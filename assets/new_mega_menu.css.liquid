@media (min-width: 64.063rem) {
  .new_desktop_header .header-nav__container {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
  }
  .header-nav__container {
    display: block;
  }
}

/* Mobile navigation drawer (content: snippets/mega-menu-redesign.liquid) */
@media only screen and (max-width: 1024px) {
  .new_mobile_header drawer-component#MobileNavDrawer {
    background: #fff;
    top: var(--header-height);
  }
  .js-drawer-open .drawer-background:after {
    opacity: 0;
    visibility: visible;
    top: 76px;
  }
}
