<style>
  .featured_image.featured__image_{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .featured_image .bg_image {
    width: 100%;
  }
  .featured_image .bg_image img{
    width: 100%;
  }
</style>

<div class="featured_image featured__image_{{ section.id }}">
  <div class="container">
    {% if section.settings.bg_image != blank %}
      <div class="bg_image">
        <a href="{{ section.settings.image_url }}">
          <img src="{{ section.settings.bg_image | img_url: 'master' }}" alt="">
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Featured Product Image",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Select image"
    },
    {
      "type": "url",
      "id": "image_url",
      "label": "Image URL"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Featured Product Image"
    }
  ]
}
{% endschema %}
