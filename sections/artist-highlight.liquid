@media only screen and (max-width: 991px) {

  .iwt-50 {
    max-width: 100%;
}
  .artist-highlight .main-heading {
    font-size: 25px;
    margin-bottom: 32px;
}

    .ah-content {
      padding-top: min(5rem, calc(2rem + 4vw));
      padding-bottom: min(5rem, calc(2rem + 4vw));
      padding-left: 20px;
      padding-right: 20px;
    }

/* 
  .ah-content {
    padding: 68px 42px;
  }
 */
  .ah-heading {
    font-size: 31px;
    line-height: 37px;
  }
}

@media only screen and (max-width: 575px) {
  
  .artist-highlight-container {
    padding: 0;
    margin: 0 auto 64px;
  }

  .ah-image img {
    border-radius: 0;
  }

  .ah-heading {
    font-size: 26px;
    line-height: 32px;
  }

  .ah-button a {
    font-size: 14px;
    line-height: 14px;
    padding: 15px 24px;
  }
}
</style>

{% schema %}
  {
  "name": "Artist Highlight",
  "settings": [
     {
      "type": "color",
      "id": "bg-color",
      "label": "Background Color"
    },
    {
      "type": "text",
      "id": "main-heading",
      "label": "Main Heading"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position Desktop",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "left"
    },
     {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Image position Mobile",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "text",
      "id": "sub-heading",
      "label": "Sub-heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Artist Highlight"
    }
  ]
}  
{% endschema %}

