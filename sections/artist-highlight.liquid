<section class="artist-highlight-container artist_highlight_{{ section.id }}" >
  <div class="artist-highlight" style="background-color:{{ section.settings.bg-color }};">
  {% if section.settings.main-heading != blank %}<h2 class="main-heading">{{ section.settings.main-heading }}</h2>{% endif %}
  <div class="artist-highlight-wrapper" >
    {% if section.settings.image_position == 'left' and section.settings.main_image != blank %}
      <div class="ah-image iwt-50"><img src="{{ section.settings.main_image | img_url: 'master' }}" alt=""></div>
    {% endif %}
    <div class="ah-content iwt-50">
      {% if section.settings.sub-heading != blank %}<div class="ah-subheading">{{ section.settings.sub-heading }}</div>{% endif %}
      {% if section.settings.heading != blank %}<div class="text-30 desktop:text-46 my-12 font-canela font-thin">{{ section.settings.heading }}</div>{% endif %}
      {% if section.settings.description != blank %}<div class="ah-description text-20 font-semibold">{{ section.settings.description }}</div>{% endif %}
      {% if section.settings.button_label != blank %}<div class="ah-button">{% if section.settings.button_link != blank %}<a class="btn" href="{{ section.settings.button_link }}" title="{{ section.settings.button_label }}">{{ section.settings.button_label }}</a>{% else %}{{ section.settings.button_label }}{% endif %}</div>{% endif %}
    </div>
    {% if section.settings.image_position == 'right' and section.settings.main_image != blank %}
      <div class="ah-image iwt-50"><img src="{{ section.settings.main_image | img_url: 'master' }}" alt=""></div>
    {% endif %}
  </div>
 </div>   
</section>

<style>
@media(max-width:991px){
  .artist_highlight_{{ section.id }} .artist-highlight-wrapper {
    flex-direction: 
    {% if section.settings.image_position_mobile == 'top' and section.settings.image_position == 'left' %}column 
    {% elsif section.settings.image_position_mobile == 'top' and section.settings.image_position == 'right' %}column-reverse 
    {% elsif section.settings.image_position_mobile == 'bottom' and section.settings.image_position == 'left' %}column-reverse 
    {% elsif section.settings.image_position_mobile == 'bottom' and section.settings.image_position == 'right' %}column{% endif %};
  }
}
  
  .artist-highlight-container{
    max-width: 1450px;
    padding: 0 1rem;
    /* margin: 0 auto; */
    margin: 0rem auto 64px;
  }
.artist-highlight{
  /* background: rgb(247 246 245 / 50%); */
} 
 .artist-highlight .main-heading {
    color: #272727;
    text-align: center;
    font-size: 32px;
    font-style: italic;
    font-weight: 300;
    line-height: 31.2px;
    margin-bottom: 48px;
}
.artist-highlight-wrapper{
  display: flex;
  align-items: center;
  column-gap: 48px;
} 
.ah-image{
  width:50%;
} 
.ah-image img{
  border-radius: 4px;
  max-width:100%;
  width:100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}  
  
  .iwt-50 {
    max-width: 50%;
    width: 100%;
}
.ah-subheading{
  font-size: 12px;
  font-style: normal;
  font-weight: 700;
  line-height: 18.375px;
  letter-spacing: 0.6125px;
  text-transform: uppercase;
  /* margin-bottom:8px; */
}   
.ah-heading{
         /* font-family: canela, serif;
    font-size: 30px;
    text-transform: uppercase;
    line-height: 45px; */
    margin-bottom: 24px;
}   
.ah-description{
      /* color: #2d2d2d;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 27px; */
    margin-bottom: 32px;
}  
 
