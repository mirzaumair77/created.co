<style>
  .sbn { --sbn-gap: 10px; }
  .sbn * , .sbn *::before, .sbn *::after { box-sizing: border-box; }

   	.sbn{
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}
	@media screen and (min-width: 750px) {
		.sbn {
			padding-top: {{ section.settings.padding_top_desktop }}px;
			padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
		}
	}

  .sbn__label {
    flex-shrink: 0;
    text-transform: uppercase;
    color: #6E797F;
    font-size: 10px;
    font-weight: 700;
    line-height: 14px;
    letter-spacing: 1.2px;
  }

  .sbn__scroll {
    flex: 1 1 auto; min-width: 0;
    display: flex; gap: 8px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  .sbn__scroll::-webkit-scrollbar { display: none; }

  .sbn__pill {
    flex: 0 0 auto;
    scroll-snap-align: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    text-decoration: none;
    transition: border-color .15s ease, background .15s ease, color .15s ease;
    border-radius: 999px;
    border: 1px solid #CFD2D4;
    background: #FFF;
    padding: 9px 15px;
    color: #0E1F2A;
    font-size: 14px;
    font-weight: 500;
    line-height: 19.6px;
    cursor: pointer;
  }
  .sbn__pill:hover { border-color: #0E1F2A; }
  .sbn__pill.is-active { background: #0E1F2A; color: #fff; border-color: #0E1F2A; }
  .sbn .site-container{
        display: flex;
      align-items: center;
      gap: 8px;
  }

  @media (max-width: 749px) {
    .sbn__inner { flex-direction: column; align-items: flex-start; gap: 10px; padding-left: 16px; padding-right: 0; }
    .sbn__label { padding-left: 0; }
    .sbn__scroll { width: 100%; padding-right: 16px; }
    .sbn .site-container{ padding-right:0px; }
    .sbn__pill{ padding:7px 12px; font-size:13px; }
  }
  @media (min-width: 749px) {
    .sbn .site-container{ padding: 0 30px; }
  }
</style>

{%- comment -%}
  Pills come from the collection metafield:
    custom.need_pills = List of "Need Pill" metaobjects (label + filter_value)
  filter_value is the SAME product tag the slider uses, so a slider card and a
  pill with the same filter_value show the same products.
{%- endcomment -%}
{%- assign pills = collection.metafields.custom.need_pills.value -%}
{%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}

{%- if pills != blank and pills.size > 0 -%}
<section class="sbn" data-section-id="{{ section.id }}" data-collection-url="{{ collection.url }}">
  <div class="site-container">
    {%- if section.settings.heading != blank -%}
      <span class="sbn__label">{{ section.settings.heading }}</span>
    {%- endif -%}

    <div class="sbn__scroll" role="list">
      {%- for pill in pills -%}
        {%- assign pill_value = pill.filter_value | default: pill.filter_value.value | strip -%}
        {%- if pill_value == blank -%}
          {%- capture pill_href -%}{{ collection.url }}?sort_by={{ current_sort | url_encode }}{%- endcapture -%}
        {%- else -%}
          {%- capture pill_href -%}{{ collection.url }}?filter.p.m.custom.filter_group={{ pill_value | url_encode }}&sort_by={{ current_sort | url_encode }}{%- endcapture -%}
        {%- endif -%}
        <a
          class="sbn__pill"
          href="{{ pill_href }}"
          role="listitem"
          data-filter-tag="{{ pill_value | escape }}"
          {% if pill_value == blank %}data-show-all="true"{% endif %}
        >{{ pill.label }}</a>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Shop by need",
  "tag": "section",
  "class": "shop-by-need-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Label", "default": "Shop by need" },
    { "type": "paragraph", "content": "Pills come from the collection metafield custom.need_pills (list of Need Pill metaobjects: label + filter_value). Use the same filter_value as a slider card to show the same products." },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top_desktop", "label": "Padding top (desktop)", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Padding bottom (desktop)", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top (mobile)", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom (mobile)", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 20 }
  ],
  "presets": [ { "name": "Shop by need" } ]
}
{% endschema %}
