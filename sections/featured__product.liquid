<style>
    .featured_products_new.products_new_section_{{ section.id }} {
      background-color: {{ section.settings.bg_color }};
    }

    .featured_products_new.products_new_section_{{ section.id }} .main_heading .heading h2 {
      font-size: {{ section.settings.heading_size }}px;
      color: {{ section.settings.heading_color }};
    }

    .featured_products_new.products_new_section_{{ section.id }} .main_heading .short_description p {
      font-size: {{ section.settings.description_size }}px;
      color: {{ section.settings.description_color }};
    }

    .featured_products_new.products_new_section_{{ section.id }} .products_new_main .product__list .title h4 {
      font-size: {{ section.settings.title_size }}px;
      color: {{ section.settings.title_color }};
    }

    .featured_products_new.products_new_section_{{ section.id }} .products_new_main .product__list .product_button a, .featured_products_new.products_new_section_{{ section.id }} .products_new_main .product__list .product_button button {
      font-size: {{ section.settings.button_text_size }}px;
      color: {{ section.settings.button_text_color }};
      background-color: {{ section.settings.button_bg_color }};
    }

  @media only screen and (max-width: 500px) {

    .featured_products_new.products_new_section_{{ section.id }} .main_heading .heading h2 {
      font-size: {{ section.settings.heading_size_mb }}px;
    }

    .featured_products_new.products_new_section_{{ section.id }} .main_heading .short_description p {
      font-size: {{ section.settings.description_size_mb }}px;
    }

    .featured_products_new.products_new_section_{{ section.id }} .products_new_main .product__list .title h4 {
      font-size: {{ section.settings.title_size_mb }}px;
    }

    .featured_products_new.products_new_section_{{ section.id }} .products_new_main .product__list .product_button a, .featured_products_new.products_new_section_{{ section.id }} .products_new_main .product__list .product_button button {
      font-size: {{ section.settings.button_text_size_mb }}px;
    }
  }
 @media only screen and (max-width: 350px) {
   .featured_products_new.products_new_section_{{ section.id }} .products_new_main .product__list .product_button a, .featured_products_new.products_new_section_{{ section.id }} .products_new_main .product__list .product_button button {
      font-size: 12px;
    }
 }
@media only screen and (min-width: 581px) and (max-width: 999px) {
    .featured_products_new .flickity-viewport {
      min-height: 400px !important;
    }
}   
@media only screen and (max-width: 580px) {
    .featured_products_new .flickity-viewport {
      min-height: 335px !important;
    }
}   
</style>

<div class="featured_products_new products_new_section_{{ section.id }}">
  <div class="container">
    <div class="main_heading">
      {% if section.settings.heading != blank %}
        <div class="heading">
          <h2 class="font-thin">{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="short_description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
    <div class="products_new_main">
      {% assign collection = section.settings.collection_products %}
      {% assign limit = section.settings.product_limit %}
      {% for product in collection.products limit: limit %}
        <div class="product__list">
          {% if product.featured_image != blank %}
            <div class="image">
              <a href="{{ product.url }}">
                <img src="{{ product.featured_image | img_url: '300x300', crop: 'center' }}">
              </a>
            </div>
          {% endif %}
          <div class="title">
            <a href="{{ product.url }}">
              <h4>{{ product.title }}</h4>
            </a>
          </div>
          {% if product.metafields.product_cards.product_card_details != blank %}
            <div class="varinat_details">
              <h5>{{ product.metafields.product_cards.product_card_details }}</h5>
            </div>
          {% endif %}
          <div class="price_container">
            <span class="original_price">{{ product.selected_or_first_available_variant.price | money }}</span>
            {% if product.selected_or_first_available_variant.price < product.selected_or_first_available_variant.compare_at_price %}
              <span class="compare_price"><del>{{ product.selected_or_first_available_variant.compare_at_price | money }}</del></span>
            {% endif %}
          </div>
          {% if section.settings.button_text != blank %}
          <div class="product_button">
              <div id="buy-buttons">
                <product-card>
                  {% assign current_variant = product.selected_or_first_available_variant %}
                  {% assign productTags = product.tags | join: ', ' %}
                  <button
                    class="fl-btn relative "
                    data-variant-id="{{ current_variant.id }}"
                    {% unless current_variant.available %}
                      disabled
                    {% endunless %}
                    js-add-to-cart
                  >
                    {% if current_variant.available -%}
                      {{ section.settings.button_text }}
                    {%- elsif productTags contains 'coming_soon' -%}
                      COMING SOON
                    {%- else -%}
                      SOLD OUT
                    {%- endif %}
                    <loading-spinner style="--bg-opacity: 100%; --size: 1.5rem;"></loading-spinner>
                  </button>
                  <noscript class="no-js">
                    <a href="{{ product.url | within: collection }}" class="btn mt-20">BUY NOW</a>
                  </noscript>
                </product-card>
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#000000"
    },
    {
      "type": "collection",
      "id": "collection_products",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Product limit",
      "default": 4
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 65,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 45
    },
    {
      "type": "range",
      "id": "heading_size_mb",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size Mobile",
      "default": 32
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 0,
      "max": 42,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "description_size_mb",
      "min": 0,
      "max": 42,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size Mobile",
      "default": 18
    },
    {
      "type": "header",
      "content": "Product Style"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_size_mb",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title Font Size Mobile",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_text_size",
      "min": 0,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_text_size_mb",
      "min": 0,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size Mobile",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
