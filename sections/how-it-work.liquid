<style>
.how-work {
    background: #F5F5F5;
    padding:75px 0;
}  
.hw_{{ section.id }} .how-heading {
        margin-bottom: 30px;
    font-family: grotesque, sans-serif;
    line-height: normal;
    font-size: 36px;
    font-weight: 400;
    text-align: center;
    text-transform: uppercase;
}
 .hw_{{ section.id }}  .width-100{
    width:100%;
    max-width:100%;
  }
 .hw_{{ section.id }}  .width-50{
    width:100%;
    max-width:50%;
  }
 .hw_{{ section.id }}  .width-33{
    width:100%;
    max-width:calc(33% - 20px);
  }
 .hw_{{ section.id }}  .how-row {
    gap: 20px;
    display: flex;
    justify-content: center;
   flex-wrap: wrap;
}
  .hw_{{ section.id }} .how-item {
    padding: 32px 32px 64px;
}
  .hw_{{ section.id }} .how-item-heading h3 {
    margin-bottom: 15px;
    font-family: canela, serif;
    line-height: normal;
    font-size: 36px;
    font-weight: 100;
    text-align: left;
    margin-top: 20px;
}
  .hw_{{ section.id }} .how-item-txt p {
    font-family: grotesque, sans-serif;
    font-weight: 400;
    line-height: 1.5;
    font-size: 18px;
    text-align: left;
}

.hw_{{ section.id }} .how-it-work-section {
    display: flex;
    align-items: center;
    justify-content: center;
}
  
  @media(max-width:990px){
    .hw_{{ section.id }} .width-33{
    max-width:calc(50% - 20px);
  }
    .hw_{{ section.id }} .how-item-icon {
    max-width: 115px;
}
  }
   @media(max-width:600px){
     .hw_{{ section.id }}  .how-row{
       display:block
     }
    .hw_{{ section.id }} .width-33{
    max-width:100%;
      width:100%;
  }
    .hw_{{ section.id }} .how-item {
       padding: 0px 15px 32px;
     }
     .hw_{{ section.id }} .how-heading {
            font-size: 24px;
        text-align: left;
}
       .hw_{{ section.id }} .how-item-txt p {
    font-size: 18px;
}
     .hw_{{ section.id }} .how-it-work-section{
       display:none;
     }
       .hw_{{ section.id }} .how-item-heading h3, .hw_{{ section.id }} .how-item-txt p {
         text-align: left;
       }
   .how-it-work  .flickity-prev-next-button.next {
    right: 0;
    top: -45px;
     background: transparent;
}
.how-it-work .flickity-prev-next-button.previous {
    left: auto;
    right: 50px;
    top: -45px;
    background: transparent;
}  
     .how-work {
    padding: 45px 0;
}
     .hw_{{ section.id }} .how-item-heading h3 {
    font-size: 30px;
    margin-top: 0px;
}
  }
  @media(max-width:375px){
     .hw_{{ section.id }} .how-heading {
            font-size: 25px;
}
  }
</style>

<section class="mt-60 how-work hw_{{ section.id }}">
  <div class="how-main site-container ">
    {% if section.settings.heading != blank %}<h2 class="how-heading">{{ section.settings.heading }}</h2>{% endif %}
    <div class="how-row how-it-work">
      {% for block in section.blocks %}
        <div class="how-item {% if forloop.length == 1 %} width-100 {% elsif forloop.length == 2 %} width-50 {% else %} width-33{% endif %}">
          {% if block.settings.heading != blank %}<div class="how-item-heading"><h3>{{ forloop.index }}. {{ block.settings.heading }}</h3></div>{% endif %}
          {% if block.settings.text != blank %}<div class="how-item-txt">{{ block.settings.text }}</div>{% endif %}
        </div>
      {% endfor %}
    </div>
    {% if section.settings.button_text != blank %}<div class="how-it-work-section"><a href="{{ section.settings.button_url }}" class="how-it-work-section  {% if section.settings.button_dark == true %}btn btn--black {% else %}btn-bigger btn--filled-white{% endif %} text-16  font-grotesque font-bold ">{{ section.settings.button_text }}</a></div>{% endif %}
  </div>
</section>



{% schema %}
  {
  "name": "How It Work",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default":"How it Works"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Start Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "button_dark",
      "label": "Button Dark",
      "default": true
    }
  ],
  "blocks": [
    {
      "name": "Item",
      "type": "item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Label"
        },
        {
          "type": "richtext",
          "label": "Text",
          "id": "text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Work"
    }
  ]
}  
{% endschema %}