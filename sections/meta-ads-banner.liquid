<style>
  .meta-banner.meta_banner_section_{{ section.id }} {
    background-image: linear-gradient(45deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 70%), url({{ section.settings.deskstop_bg | img_url: 'master' }});
  }

  .meta-banner.meta_banner_section_{{ section.id }} .content_meta .heading h2 {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
  }

  .meta-banner.meta_banner_section_{{ section.id }} .content_meta .description p {
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
  }

  .meta-banner.meta_banner_section_{{ section.id }} .content_meta .buttn_meta a {
    font-size: {{ section.settings.button_text_size }}px;
    color: {{ section.settings.btn_text_color }};
    background: {{ section.settings.btn_bg_color }};
  }

  @media only screen and (max-width: 500px) {

    .meta-banner.meta_banner_section_{{ section.id }} .content_meta .heading h2 {
      font-size: {{ section.settings.heading_size_mb }}px;
    }

    .meta-banner.meta_banner_section_{{ section.id }} .content_meta .description p {
      font-size: {{ section.settings.description_size_mb }}px;
    }

    .meta-banner.meta_banner_section_{{ section.id }} .content_meta .buttn_meta a {
      font-size: {{ section.settings.button_text_size_mb }}px;
    }
  }

  .meta-banner.meta_banner_section_{{ section.id }} {
    background-size: cover;
    background-position: center;
    padding: 300px 32px 100px;
  }

  .meta-banner .container {
    max-width: 1450px;
    margin: 0 auto;
  }

  .meta-banner .content_meta {
    width: 100%;
    max-width: 688px;
  }

  .meta-banner .content_meta .heading h2 {
    font-family: canela, serif;
    line-height: normal;
    letter-spacing: normal;
    font-style: normal;
  }

  .meta-banner .content_meta .description {
    width: 100%;
    max-width: 420px;
  }

  .meta-banner .content_meta .description p {
    font-family: grotesque, sans-serif;
    font-weight: 400;
    line-height: 1.5;
    padding: 20px 0 65px;
  }

  .meta-banner .content_meta .buttn_meta a {
    display: inline-block;
    padding: 24px 50px;
    border-radius: 50px;
    font-family: grotesque, sans-serif;
    font-weight: 700;
    line-height: 30px;
    text-align: center;
    text-decoration: none;
  }


  @media only screen and (max-width: 768px) {
    .meta-banner.meta_banner_section_{{ section.id }} {
      background-image: linear-gradient(45deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 90%), url({{ section.settings.mobile_bg | img_url: 'master' }});
    }

    .meta-banner.meta_banner_section_{{ section.id }} {
      padding: 100px 16px 64px;
    }

    .meta-banner .content_meta .description p {
      padding: 20px 0 40px;
    }
  }


  @media only screen and (max-width: 500px) {
    .meta-banner .content_meta .buttn_meta a {
      padding: 16px 32px;
    }
  }
</style>

<div class="meta-banner meta_banner_section_{{ section.id }}">
  <div class="container">
    <div class="content_meta">
      {% if section.settings.heading != blank %}
        <div class="heading">
          <h2 class="font-thin">{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="description">
          {{ section.settings.description }}
        </div>
      {% endif %}
      {% if section.settings.buttn_text != blank %}
        <div class="buttn_meta">
          <a href="{{ section.settings.buttn_link }}">{{ section.settings.buttn_text }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Meta Ads Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "deskstop_bg",
      "label": "Deskstop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_bg",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "buttn_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "buttn_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 4,
      "max": 90,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 50
    },
    {
      "type": "range",
      "id": "heading_size_mb",
      "min": 4,
      "max": 90,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size Mobile",
      "default": 50
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 4,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "description_size_mb",
      "min": 4,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size Mobile",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_text_size",
      "min": 4,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_text_size_mb",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size Mobile",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Meta Ads Banner"
    }
  ]
}
{% endschema %}
