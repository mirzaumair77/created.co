{%- liquid
  assign background = section.settings.background
  assign image = section.settings.image
  assign heading_highlight = section.settings.heading_highlight
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile

  assign image_loading = 'lazy'
  if section.index <= 2
    assign image_loading = 'eager'
  endif

  assign heading_plain = heading_highlight | append: ' ' | append: heading | strip
  assign image_alt = image.alt | default: heading_plain
  assign values_markup = ''
-%}

{%- for block in section.blocks -%}
  {%- liquid
    assign value_title = block.settings.title
    assign value_text = block.settings.text
  -%}

  {%- capture value_html -%}
    <li class="our-values__item" {{ block.shopify_attributes }}>
      {%- if value_title != blank -%}
        <div class="our-values__item-title">
          <h3>{{ value_title | escape }}</h3>
        </div>
      {%- endif -%}

      {%- if value_text != blank -%}
        <div class="our-values__item-text">
          <p>{{ value_text | escape }}</p>
        </div>
      {%- endif -%}
    </li>
  {%- endcapture -%}

  {%- assign values_markup = values_markup | append: value_html -%}
{%- endfor -%}

<style>
  #shopify-section-{{ section.id }} .our-values {
    --our-values-bg: {{ background }};
    --our-values-pt: {{ padding_top }}px;
    --our-values-pb: {{ padding_bottom }}px;
    --our-values-pt-mobile: {{ padding_top_mobile }}px;
    --our-values-pb-mobile: {{ padding_bottom_mobile }}px;
  }

  .our-values {
    padding-top: var(--our-values-pt-mobile);
    padding-bottom: var(--our-values-pb-mobile);
    background: var(--our-values-bg);
    color: #111;
  }

  .our-values__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 18px;
  }

  .our-values__media {
    aspect-ratio: 1 / 1;
    margin-bottom: 28px;
    overflow: hidden;
    border-radius: 6px;
    background: #ececec;
  }

  .our-values__media img,
  .our-values__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .our-values__content {
    width: 100%;
    display: flex;
    flex-direction: column;
    row-gap: 28px;
  }

  .our-values__heading h2 {
    margin: 0;
    font-family: var(--font-canela), var(--font-body-family);
    color: #000;
    font-size: 30.222px;
    line-height: 32.036px;
    letter-spacing: -0.34px;
    font-weight: 100;
  }

  .our-values__heading strong {
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    font-size: 34px;
    letter-spacing: -0.907px;
    font-weight: 700;
  }

  .our-values__text p {
    margin: 0;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #6E797F;
    font-size: 15px;
    line-height: 24.75px;
    font-weight: 400;
  }

  .our-values__text p + p {
    margin-top: 0.8em;
  }

  .our-values__text a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .our-values__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .our-values__item {
    padding: 16px 0;
    border-top: 1px solid #E7E9EA;
  }

  .our-values__item-title {
    padding-block-end: 8px;
  }

  .our-values__item-title h3 {
    margin: 0;
    font-family: var(--font-canela), var(--font-body-family);
    color: #000;
    font-size: 24px;
    line-height: normal;
    font-weight: 100;
    text-box: cap alphabetic;
  }

  .our-values__item-text p {
    margin: 0;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #6E797F;
    font-size: 13px;
    line-height: 19.5px;
    font-weight: 400;
  }

  @media (min-width: 769px) {
    .our-values {
      padding-top: var(--our-values-pt);
      padding-bottom: var(--our-values-pb);
    }

    .our-values__container {
      display: grid;
      grid-template-columns: minmax(0, 50.6fr) minmax(0, 52fr);
      align-items: center;
      gap: clamp(40px, 5vw, 72px);
      padding: 0 36px;
    }

    .our-values__media {
      aspect-ratio: 11 / 10;
      margin-bottom: 0;
    }

    .our-values__content {
      max-width: 639px;
      row-gap: 24px;
    }

    .our-values__heading h2 {
      font-size: 51px;
      line-height: 48.053px;
      letter-spacing: -0.51px;
      font-weight: 300;
      text-transform: capitalize;
    }

    .our-values__heading strong {
      font-size: 45.333px;
      letter-spacing: -1.36px;
      font-weight: 500;
      text-transform: none;
    }

    .our-values__text {
      width: 100%;
      max-width: 565px;
    }
    
    .our-values__text p {
      color: #000000cc;
      font-size: 16px;
      line-height: 26.4px;
    }

    .our-values__list {
      display: grid;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      padding-top: 16px;
      border-top: 1px solid #E7E9EA;
    }

    .our-values__item {
      padding: 8px 20px;
      border-top: 0;
      border-left: 1px solid #E7E9EA;
    }

    .our-values__item:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .our-values__item-title h3 {
      font-weight: 300;
    }

    .our-values__item-text {
      max-width: 11em;
    }
    
    .our-values__item-text p {
      color: #000000cc;
    }
  }
</style>

<section class="our-values">
  <div class="our-values__container">
    <div class="our-values__media">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 1400
          | image_tag:
            loading: image_loading,
            widths: '375, 550, 750, 1000, 1400',
            sizes: '(min-width: 769px) 47vw, calc(100vw - 36px)',
            alt: image_alt
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="our-values__content">
      {%- if heading_highlight != blank or heading != blank -%}
        <div class="our-values__heading">
          <h2>
            {%- if heading_highlight != blank -%}
              <strong>{{ heading_highlight | escape }}</strong>
              {%- if heading != blank %}<br>{% endif -%}
            {%- endif -%}
            {{- heading | escape | newline_to_br -}}
          </h2>
        </div>
      {%- endif -%}

      {%- if text != blank -%}
        <div class="our-values__text">
          {{ text }}
        </div>
      {%- endif -%}

      {%- if values_markup != blank -%}
        <ul class="our-values__list">
          {{ values_markup }}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Our values",
  "tag": "div",
  "class": "section-our-values",
  "settings": [
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading first line",
      "default": "More than a mug.",
      "info": "Shown in bold sans-serif."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "It’s Empowerment.\nIt’s Community.",
      "info": "Serif style. Each new line starts a new heading line."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>When you’ve worked in hospitality, it’s always going to be part of who you are. We cut our teeth with entrepreneurs out to make their mark, and we’re still inspired by the drive behind creators like you. That’s why we look at you as colleagues, not clients.</p>"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Inspire"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Design that makes the everyday feel a little bigger."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Our values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "title": "Inspire",
            "text": "Design that makes the everyday feel a little bigger."
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Connect",
            "text": "Built for the cup you share across a table."
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Empower",
            "text": "Custom goods that help small businesses stand out."
          }
        }
      ]
    }
  ]
}
{% endschema %}
