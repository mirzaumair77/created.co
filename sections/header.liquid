<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if settings.predictive_search_enabled -%}
  <link
    rel="stylesheet"
    href="{{ 'component-predictive-search.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
  <link
    rel="stylesheet"
    href="{{ 'component-loading-overlay.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}

{{ 'base-modal.css' | asset_url | stylesheet_tag }}
{{ 'base-header.css' | asset_url | stylesheet_tag }}
{{ 'header-redesign.css' | asset_url | stylesheet_tag }}

<script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'header-redesign.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign sticky_mode = section.settings.sticky_mode
  assign logo_position = section.settings.logo_position
  assign menu_position = section.settings.menu_position
  assign show_account = section.settings.show_account
  assign show_search = section.settings.show_search
  assign search_position = section.settings.search_position
  assign border_width = section.settings.border_width
  assign bottom_border_color = section.settings.bottom_border_color

  assign enable_home_header = section.settings.enable_home_header
  assign enable_clp_header = section.settings.enable_clp_header
  assign enable_pdp_header = section.settings.enable_pdp_header
  assign enable_sticky_header = section.settings.enable_sticky_header

  assign solid_bg = section.settings.solid_bg
  assign solid_text = section.settings.solid_text
  assign solid_nav = section.settings.solid_nav
  assign solid_pill = section.settings.solid_pill
  assign solid_pill_hover_alpha = section.settings.solid_pill_hover_opacity | divided_by: 100.0
  assign solid_pill_hover = section.settings.solid_pill_hover | default: solid_pill | color_modify: 'alpha', solid_pill_hover_alpha
  assign solid_pill_active = section.settings.solid_pill_active | default: solid_pill | color_modify: 'alpha', solid_pill_hover_alpha
  assign logo_dark = section.settings.logo_dark

  assign home_overlay = section.settings.home_overlay
  assign home_bg = section.settings.home_bg
  assign home_bg_opacity = section.settings.home_bg_opacity
  assign home_text = section.settings.home_text
  assign home_nav = section.settings.home_nav
  assign home_pill = section.settings.home_pill
  assign home_pill_opacity = section.settings.home_pill_opacity
  assign home_pill_hover_alpha = section.settings.home_pill_hover_opacity | divided_by: 100.0
  assign home_pill_hover = section.settings.home_pill_hover | default: home_pill | color_modify: 'alpha', home_pill_hover_alpha
  assign home_pill_active = section.settings.home_pill_active | default: home_pill | color_modify: 'alpha', home_pill_hover_alpha
  assign home_logo = section.settings.home_logo

  assign clp_overlay = section.settings.clp_overlay
  assign clp_bg = section.settings.clp_bg
  assign clp_bg_opacity = section.settings.clp_bg_opacity
  assign clp_text = section.settings.clp_text
  assign clp_nav = section.settings.clp_nav
  assign clp_pill = section.settings.clp_pill
  assign clp_pill_opacity = section.settings.clp_pill_opacity
  assign clp_pill_hover_alpha = section.settings.clp_pill_hover_opacity | divided_by: 100.0
  assign clp_pill_hover = section.settings.clp_pill_hover | default: clp_pill | color_modify: 'alpha', clp_pill_hover_alpha
  assign clp_pill_active = section.settings.clp_pill_active | default: clp_pill | color_modify: 'alpha', clp_pill_hover_alpha
  assign clp_logo = section.settings.clp_logo

  assign pdp_overlay = section.settings.pdp_overlay
  assign pdp_bg = section.settings.pdp_bg
  assign pdp_bg_opacity = section.settings.pdp_bg_opacity
  assign pdp_text = section.settings.pdp_text
  assign pdp_nav = section.settings.pdp_nav
  assign pdp_pill = section.settings.pdp_pill
  assign pdp_pill_opacity = section.settings.pdp_pill_opacity
  assign pdp_pill_hover_alpha = section.settings.pdp_pill_hover_opacity | divided_by: 100.0
  assign pdp_pill_hover = section.settings.pdp_pill_hover | default: pdp_pill | color_modify: 'alpha', pdp_pill_hover_alpha
  assign pdp_pill_active = section.settings.pdp_pill_active | default: pdp_pill | color_modify: 'alpha', pdp_pill_hover_alpha
  assign pdp_logo = section.settings.pdp_logo

  assign sticky_templates = section.settings.sticky_templates
  assign sticky_overlay = section.settings.sticky_overlay
  assign sticky_bg = section.settings.sticky_bg
  assign sticky_bg_opacity = section.settings.sticky_bg_opacity
  assign sticky_text = section.settings.sticky_text
  assign sticky_nav = section.settings.sticky_nav
  assign sticky_pill = section.settings.sticky_pill
  assign sticky_pill_opacity = section.settings.sticky_pill_opacity
  assign sticky_pill_hover_alpha = section.settings.sticky_pill_hover_opacity | divided_by: 100.0
  assign sticky_pill_hover = section.settings.sticky_pill_hover | default: sticky_pill | color_modify: 'alpha', sticky_pill_hover_alpha
  assign sticky_pill_active = section.settings.sticky_pill_active | default: sticky_pill | color_modify: 'alpha', sticky_pill_hover_alpha
  assign sticky_logo = section.settings.sticky_logo

  assign search_label = 'general.search.search' | t

  comment
    Custom sticky header: when enabled, the header is sticky only on the
    templates listed (comma separated). An entry can be a template type
    ("product", "page", "blog"), an alternate template's suffix ("about-us"
    for templates/page.about-us.json) or both ("page.about-us"). A ".json"
    extension is ignored. Listed templates use the selected sticky type, or
    "always" if it is set to Never. All other templates are not sticky.

    template.name is only the type ("page"); the alternate template name
    lives in template.suffix, so both are compared.
  endcomment

  assign sticky_template_match = false
  if enable_sticky_header
    assign sticky_current = template.name | downcase
    assign sticky_current_suffix = template.suffix | downcase
    assign sticky_current_full = sticky_current
    if sticky_current_suffix != blank
      assign sticky_current_full = sticky_current | append: '.' | append: sticky_current_suffix
    endif

    assign sticky_template_list = sticky_templates | downcase | split: ','
    for sticky_template in sticky_template_list
      assign sticky_template = sticky_template | strip | remove_last: '.json'
      if sticky_template == blank
        continue
      endif

      if sticky_template == sticky_current or sticky_template == sticky_current_full
        assign sticky_template_match = true
        break
      endif

      if sticky_current_suffix != blank and sticky_template == sticky_current_suffix
        assign sticky_template_match = true
        break
      endif
    endfor

    if sticky_template_match
      if sticky_mode == 'none'
        assign sticky_mode = 'always'
      endif
    else
      assign sticky_mode = 'none'
    endif
  endif

  comment
    Initial state at the top of the page.
    Pages without a dedicated state fall back to the scrolled/solid settings.
  endcomment

  assign overlay = false
  assign init_bg = solid_bg
  assign init_text = solid_text
  assign init_nav = solid_nav
  assign init_pill = solid_pill
  assign init_pill_hover = solid_pill_hover
  assign init_pill_active = solid_pill_active
  assign init_logo = blank

  comment
    Sticky template state is the base for listed templates; the dedicated
    Homepage/CLP/PDP states below still take priority when enabled.
  endcomment

  if sticky_template_match
    assign overlay = sticky_overlay
    assign sticky_bg_alpha = sticky_bg_opacity | divided_by: 100.0
    assign sticky_pill_alpha = sticky_pill_opacity | divided_by: 100.0
    assign init_bg = sticky_bg | color_modify: 'alpha', sticky_bg_alpha
    assign init_text = sticky_text
    assign init_nav = sticky_nav
    assign init_pill = sticky_pill | color_modify: 'alpha', sticky_pill_alpha
    assign init_pill_hover = sticky_pill_hover
    assign init_pill_active = sticky_pill_active
    assign init_logo = sticky_logo
  endif

  case template.name
    when 'index'
      if enable_home_header
        assign overlay = home_overlay
        assign home_bg_alpha = home_bg_opacity | divided_by: 100.0
        assign home_pill_alpha = home_pill_opacity | divided_by: 100.0
        assign init_bg = home_bg | color_modify: 'alpha', home_bg_alpha
        assign init_text = home_text
        assign init_nav = home_nav
        assign init_pill = home_pill | color_modify: 'alpha', home_pill_alpha
        assign init_pill_hover = home_pill_hover
        assign init_pill_active = home_pill_active
        assign init_logo = home_logo
      endif
    when 'collection'
      if enable_clp_header
        assign overlay = clp_overlay
        assign clp_bg_alpha = clp_bg_opacity | divided_by: 100.0
        assign clp_pill_alpha = clp_pill_opacity | divided_by: 100.0
        assign init_bg = clp_bg | color_modify: 'alpha', clp_bg_alpha
        assign init_text = clp_text
        assign init_nav = clp_nav
        assign init_pill = clp_pill | color_modify: 'alpha', clp_pill_alpha
        assign init_pill_hover = clp_pill_hover
        assign init_pill_active = clp_pill_active
        assign init_logo = clp_logo
      endif
    when 'product'
      if enable_pdp_header
        assign overlay = pdp_overlay
        assign pdp_bg_alpha = pdp_bg_opacity | divided_by: 100.0
        assign pdp_pill_alpha = pdp_pill_opacity | divided_by: 100.0
        assign init_bg = pdp_bg | color_modify: 'alpha', pdp_bg_alpha
        assign init_text = pdp_text
        assign init_nav = pdp_nav
        assign init_pill = pdp_pill | color_modify: 'alpha', pdp_pill_alpha
        assign init_pill_hover = pdp_pill_hover
        assign init_pill_active = pdp_pill_active
        assign init_logo = pdp_logo
      endif
  endcase

  assign logo_swap = false
  if init_logo != blank
    assign logo_swap = true
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --ch-solid-bg: {{ solid_bg }};
    --ch-solid-text: {{ solid_text }};
    --ch-solid-nav: {{ solid_nav }};
    --ch-solid-pill: {{ solid_pill }};
    --ch-solid-pill-hover: {{ solid_pill_hover }};
    --ch-solid-pill-active: {{ solid_pill_active }};
    --ch-init-bg: {{ init_bg }};
    --ch-init-text: {{ init_text }};
    --ch-init-nav: {{ init_nav }};
    --ch-init-pill: {{ init_pill }};
    --ch-init-pill-hover: {{ init_pill_hover }};
    --ch-init-pill-active: {{ init_pill_active }};
    --ch-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ch-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ch-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --ch-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --ch-border-width: {{ border_width }}px;
    --ch-border-color: {{ bottom_border_color }};
    z-index: 50;

    {%- if overlay %}
      position: {% if sticky_mode == 'none' %}absolute{% else %}fixed{% endif %};
      top: {% if sticky_mode == 'none' %}var(--announcement-bar-height, 0px){% else %}var(--header-sticky-top, var(--announcement-bar-height, 0px)){% endif %};
      left: 0;
      width: 100%;
    {%- elsif sticky_mode != 'none' %}
      position: sticky;
      top: 0;
    {%- endif %}

    {%- if sticky_mode == 'scroll_up' %}
      transition: transform 220ms cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
    {%- endif %}
  }

  {%- if sticky_mode == 'scroll_up' %}
    #shopify-section-{{ section.id }}.is-hidden {
      transform: translate3d(0, calc(-100% - var(--header-sticky-top, 0px)), 0);
    }
  {%- endif %}

  #shopify-section-{{ section.id }} [data-search-mode='inline'] details {
    position: relative;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] summary {
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .created-header__search-label {
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .search-modal {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: auto;
    height: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--search-pill-radius);
    background: transparent;
    box-shadow: none;
    opacity: 1;
    transform: none;
    animation: none;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .modal-overlay {
    display: none;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .search-modal:has(predictive-search[open]) .modal-overlay {
    display: block;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .modal-overlay::after {
    position: fixed;
    top: var(--header-height, 0px);
    height: 100vh;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .search-modal__content {
    position: relative;
    top: auto;
    bottom: auto;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .search-modal__form {
    position: static;
    display: block;
    width: 100%;
    max-width: none;
    height: 100%;
    margin: 0;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .field {
    height: 100%;
    margin: 0;
    border-radius: var(--search-pill-radius);
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .field::before,
  #shopify-section-{{ section.id }} [data-search-mode='inline'] .field::after {
    display: none;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .field:focus-within {
    outline: 1px solid var(--search-pill-color, currentColor);
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .search__input {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0 var(--search-pill-end, 44px) 0 var(--search-pill-start, 16px);
    border: 0;
    border-radius: inherit;
    background: transparent;
    box-shadow: none;
    outline: 0;
    color: var(--search-pill-color);
    font-family: var(--search-pill-font-family);
    font-size: var(--search-pill-font-size);
    font-weight: var(--search-pill-font-weight);
    letter-spacing: var(--search-pill-letter-spacing);
    line-height: normal;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .search__input::placeholder {
    color: inherit;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .search__button {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: auto;
    width: var(--search-pill-end, 44px);
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .search__button svg {
    opacity: 0;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .search-modal__close-button {
    display: none;
  }

  #shopify-section-{{ section.id }} [data-search-mode='inline'] .predictive-search {
    {%- if search_position == 'left' %}
      right: auto;
      left: 0;
    {%- else %}
      right: 0;
      left: auto;
    {%- endif %}
    width: min(742px, calc(100vw - 32px));
    max-height: calc(100vh - var(--header-height, 0px));
  }

  #shopify-section-{{ section.id }} [data-search-mode='modal'],
  #shopify-section-{{ section.id }} [data-search-mode='modal'] details-modal,
  #shopify-section-{{ section.id }} [data-search-mode='modal'] details {
    position: static;
  }

  #shopify-section-{{ section.id }} [data-search-mode='modal'] .search-modal {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    width: auto;
  }

  #shopify-section-{{ section.id }} [data-search-mode='modal'] .search-modal__content {
    position: relative;
    height: 100%;
  }

  #shopify-section-{{ section.id }} [data-search-mode='modal'] .search-modal__form {
    position: static;
    width: 100%;
    max-width: none;
  }

  #shopify-section-{{ section.id }} [data-search-mode='modal'] .predictive-search {
    top: 100%;
    right: 0;
    left: 0;
    width: auto;
    max-height: calc(100vh - var(--header-height, 0px));
    max-height: calc(100dvh - var(--header-height, 0px));
  }
{% endstyle %}

<svg class="created-header__sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <symbol id="icon-search" viewBox="0 0 18 19" fill="none">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.7l5.4 5.4a.5.5 0 11-.71.7l-5.41-5.4z" fill="currentColor"/>
  </symbol>

  <symbol id="icon-close" viewBox="0 0 18 17" fill="none">
    <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor"/>
  </symbol>
</svg>

{% capture created_logo %}
  <div class="created-header__logo{% if logo_swap %} created-header__logo--swap{% endif %}">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      <div class="created-header__logo-dark">
        {%- if logo_dark != blank -%}
          {{ logo_dark | image_url: width: 400 | image_tag: loading: 'eager', alt: shop.name }}
        {%- else -%}
          {% render 'icon-logotype-black' %}
        {%- endif -%}
      </div>
      {%- if logo_swap -%}
        <div class="created-header__logo-initial">
          {{ init_logo | image_url: width: 400 | image_tag: loading: 'eager', alt: '' }}
        </div>
      {%- endif -%}
    </a>
  </div>
{% endcapture %}

{% capture created_nav %}
  {%- if section.settings.menu.links.size > 0 -%}
    <nav class="created-header__nav" aria-label="Primary">
      {%- render 'mega-menu-redesign', mmr_section: section -%}
    </nav>
  {%- endif -%}
{% endcapture %}

{% capture created_search %}
  {%- if show_search -%}
    <div class="created-header__icon created-header__icon--search">
      <details-modal class="header__search">
        <details>
          <summary class="modal__toggle" aria-haspopup="dialog" aria-label="{{ search_label }}">
            <span class="created-header__search-label">{{ search_label }}</span>
            <svg class="icon icon-search" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M8.24357 2.99805C7.55465 2.99805 6.87248 3.13374 6.23601 3.39737C5.59953 3.66101 5.02122 4.04743 4.53408 4.53457C4.04694 5.02171 3.66052 5.60002 3.39688 6.23649C3.13326 6.87297 2.99756 7.55514 2.99756 8.24406C2.99756 8.93297 3.13326 9.61514 3.39688 10.2516C3.66052 10.888 4.04694 11.4664 4.53408 11.9535C5.02122 12.4407 5.59953 12.8271 6.23601 13.0908C6.87248 13.3544 7.55465 13.4901 8.24357 13.4901C9.6349 13.4901 10.9692 12.9374 11.953 11.9535C12.9369 10.9697 13.4896 9.63539 13.4896 8.24406C13.4896 6.85273 12.9369 5.51839 11.953 4.53457C10.9692 3.55075 9.6349 2.99805 8.24357 2.99805Z" stroke="currentColor" stroke-width="1.12414" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M12.3652 12.3662L15.7377 15.7386" stroke="currentColor" stroke-width="1.12414" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>

          <div class="search-modal modal__content" role="dialog" aria-modal="true" aria-label="{{ search_label }}">
            <div class="modal-overlay"></div>

            <div
              class="search-modal__content{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} search-modal__content-top{% else %} search-modal__content-bottom{% endif %}"
              tabindex="-1"
            >
              {%- if settings.predictive_search_enabled -%}
                <predictive-search
                  class="search-modal__form"
                  data-loading-text="{{ 'accessibility.loading' | t }}"
                >
              {%- endif -%}

              <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
                <div class="field">
                  <input
                    class="search__input field__input"
                    id="Search-In-Modal"
                    type="search"
                    name="q"
                    value=""
                    placeholder="{{ search_label }}"
                    {%- if settings.predictive_search_enabled -%}
                      role="combobox"
                      aria-expanded="false"
                      aria-owns="predictive-search-results-list"
                      aria-controls="predictive-search-results-list"
                      aria-haspopup="listbox"
                      aria-autocomplete="list"
                      autocorrect="off"
                      autocomplete="off"
                      autocapitalize="off"
                      spellcheck="false"
                    {%- endif -%}
                  >
                  <input type="hidden" name="options[prefix]" value="last">
                  <button class="search__button field__button" aria-label="{{ search_label }}">
                    <svg class="icon icon-search" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                      <path d="M8.24357 2.99805C7.55465 2.99805 6.87248 3.13374 6.23601 3.39737C5.59953 3.66101 5.02122 4.04743 4.53408 4.53457C4.04694 5.02171 3.66052 5.60002 3.39688 6.23649C3.13326 6.87297 2.99756 7.55514 2.99756 8.24406C2.99756 8.93297 3.13326 9.61514 3.39688 10.2516C3.66052 10.888 4.04694 11.4664 4.53408 11.9535C5.02122 12.4407 5.59953 12.8271 6.23601 13.0908C6.87248 13.3544 7.55465 13.4901 8.24357 13.4901C9.6349 13.4901 10.9692 12.9374 11.953 11.9535C12.9369 10.9697 13.4896 9.63539 13.4896 8.24406C13.4896 6.85273 12.9369 5.51839 11.953 4.53457C10.9692 3.55075 9.6349 2.99805 8.24357 2.99805Z" stroke="currentColor" stroke-width="1.12414" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M12.3652 12.3662L15.7377 15.7386" stroke="currentColor" stroke-width="1.12414" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>

                {%- if settings.predictive_search_enabled -%}
                  <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
                    <div class="predictive-search__loading-state">
                      <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                      </svg>
                    </div>
                  </div>
                  <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                {%- endif -%}
              </form>

              {%- if settings.predictive_search_enabled -%}
                </predictive-search>
              {%- endif -%}

              <button
                type="button"
                class="search-modal__close-button modal__close-button link link--text focus-inset"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <svg class="icon icon-close" aria-hidden="true" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" focusable="false">
                  <path d="M3.5 3.5l11 11M14.5 3.5l-11 11"></path>
                </svg>
              </button>
            </div>
          </div>
        </details>
      </details-modal>
    </div>
  {%- endif -%}
{% endcapture %}

