{% comment %}
  Section: All collections page (/collections)
  - Self-contained: styles live here, no old Dawn card CSS needed
  - Card image: collection image, or its first product image when the collection has none
  - Desktop: 4 columns · Tablet: 3 · Mobile: 2
{% endcomment %}
{%- style -%}
  #ListCollections-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    color: #0e1f2b;
  }
  #ListCollections-{{ section.id }} .lc__title {
    margin: 0 0 40px;
    text-align: center;
    font-family: canela, serif;
    font-weight: 300;
    font-size: 40px;
    line-height: 1.2;
    letter-spacing: 0;
  }
  #ListCollections-{{ section.id }} .lc__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #ListCollections-{{ section.id }} .lc__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  #ListCollections-{{ section.id }} .lc__media {
    position: relative;
    aspect-ratio: {{ section.settings.image_ratio }};
    border-radius: 24px;
    overflow: hidden;
    background: #e9ecee;
  }
  #ListCollections-{{ section.id }} .lc__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  #ListCollections-{{ section.id }} .lc__card:hover .lc__img {
    transform: scale(1.04);
  }
  #ListCollections-{{ section.id }} .lc__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 16px;
    font-family: canela, serif;
    font-size: 22px;
    text-align: center;
    color: #5d6468;
  }
  #ListCollections-{{ section.id }} .lc__name {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 22px;
    font-weight: 500;
  }
  #ListCollections-{{ section.id }} .lc__arrow {
    flex: none;
    width: 6px;
    height: 10px;
    transition: transform 0.2s ease;
  }
  #ListCollections-{{ section.id }} .lc__card:hover .lc__arrow {
    transform: translateX(3px);
  }
  #ListCollections-{{ section.id }} .lc__count {
    margin: 2px 0 0;
    font-size: 14px;
    line-height: 20px;
    color: #6e797f;
  }
  @media (max-width: 989px) {
    #ListCollections-{{ section.id }} .lc__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 749px) {
    #ListCollections-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
    #ListCollections-{{ section.id }} .lc__title { margin-bottom: 24px; font-size: 30px; }
    #ListCollections-{{ section.id }} .lc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; }
    #ListCollections-{{ section.id }} .lc__media { border-radius: 16px; }
    #ListCollections-{{ section.id }} .lc__name { margin-top: 10px; font-size: 14px; line-height: 20px; }
    #ListCollections-{{ section.id }} .lc__count { font-size: 12px; line-height: 18px; }
  }
{%- endstyle -%}

{%- liquid
  case section.settings.sort
    when 'products_high' or 'products_low'
      assign collections = collections | sort: 'all_products_count'
    when 'date' or 'date_reversed'
      assign collections = collections | sort: 'published_at'
  endcase

  if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
    assign collections = collections | reverse
  endif
-%}

<section id="ListCollections-{{ section.id }}" class="lc">
  <div class="site-container">
    {%- if section.settings.title != blank -%}
      <h1 class="lc__title">{{ section.settings.title | escape }}</h1>
    {%- endif -%}

    <ul class="lc__grid" role="list">
      {%- for collection in collections -%}
        {%- if section.settings.hide_empty and collection.all_products_count == 0 -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign card_image = collection.image | default: collection.featured_image -%}
        <li>
          <a href="{{ collection.url }}" class="lc__card">
            <div class="lc__media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'lc__img',
                    widths: '300, 450, 600, 900',
                    sizes: '(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw',
                    loading: 'lazy',
                    alt: collection.title
                }}
              {%- else -%}
                <span class="lc__empty">{{ collection.title }}</span>
              {%- endif -%}
            </div>
            <p class="lc__name">
              <span>{{ collection.title }}</span>
              <svg class="lc__arrow" viewBox="0 0 6 10" fill="none" aria-hidden="true"><path d="m1 1 4 4-4 4" stroke="currentColor" stroke-width="1.2"/></svg>
            </p>
            {%- if section.settings.show_count -%}
              <p class="lc__count">{{ collection.all_products_count }} {{ collection.all_products_count | pluralize: 'product', 'products' }}</p>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list page",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Collections" },
    {
      "type": "select",
      "id": "sort",
      "label": "Sort collections by",
      "options": [
        { "value": "alphabetical", "label": "Alphabetically, A-Z" },
        { "value": "alphabetical_reversed", "label": "Alphabetically, Z-A" },
        { "value": "date_reversed", "label": "Date, new to old" },
        { "value": "date", "label": "Date, old to new" },
        { "value": "products_high", "label": "Product count, high to low" },
        { "value": "products_low", "label": "Product count, low to high" }
      ],
      "default": "alphabetical"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "4 / 3", "label": "Landscape" }
      ],
      "default": "1 / 1"
    },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "checkbox", "id": "hide_empty", "label": "Hide collections with no products", "default": true },
    { "type": "header", "content": "Desktop padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Mobile padding" },
    { "type": "range", "id": "padding_top_mobile", "label": "Top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ]
}
{% endschema %}
