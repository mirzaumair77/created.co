{%- comment -%}
  Contact page: image + "Send us a message" form.
  Uses Shopify's contact form, so messages go to the store's sender email
  (Settings → Notifications). Shopify adds its own spam protection on submit.
  Topic chips are blocks; the first one is selected by default.
{%- endcomment -%}
{{ 'unit-contact.css' | asset_url | stylesheet_tag }}

{%- assign form_id = 'UnitContactForm-' | append: section.id -%}

<section
  id="UnitContact-{{ section.id }}"
  class="uc uc-form"
  style="
    --uc-pt: {{ section.settings.padding_top }}px;
    --uc-pb: {{ section.settings.padding_bottom }}px;
    --uc-pt-m: {{ section.settings.padding_top_mobile }}px;
    --uc-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --uc-form-card: {{ section.settings.card_bg }};
  "
>
  <div class="uc__container">
    <div class="uc-form__grid">
      <div class="uc-form__media">
        {%- liquid
          assign desktop_image = section.settings.image | default: section.settings.image_mobile
          assign mobile_image = section.settings.image_mobile | default: section.settings.image
        -%}
        {%- if desktop_image != blank -%}
          <picture>
            <source
              media="(max-width: 989px)"
              srcset="{{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 900 }} 900w, {{ mobile_image | image_url: width: 1200 }} 1200w"
              sizes="100vw"
            >
            {{
              desktop_image
              | image_url: width: 1400
              | image_tag:
                widths: '600, 900, 1200, 1400',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                alt: desktop_image.alt
            }}
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="uc-form__card">
        {%- if section.settings.title != blank -%}
          <h2 class="uc-form__title font-canela">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="uc-form__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}

        {%- form 'contact', id: form_id, class: 'uc-form__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="uc-form__message uc-form__message--success" role="status" tabindex="-1" autofocus>
              {{ section.settings.success_message | escape }}
            </div>
          {%- elsif form.errors -%}
            <div class="uc-form__message uc-form__message--error" role="alert" tabindex="-1" autofocus>
              {{ section.settings.error_message | escape }}
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          {%- assign topics = section.blocks | where: 'type', 'topic' -%}
          {%- if topics.size > 0 -%}
            <fieldset class="uc-form__group">
              <legend class="uc-form__label">{{ section.settings.topic_label | escape }}</legend>
              <div class="uc-form__chips">
                {%- for block in topics -%}
                  <label class="uc-form__chip" {{ block.shopify_attributes }}>
                    <input
                      type="radio"
                      name="contact[topic]"
                      value="{{ block.settings.label | escape }}"
                      {% if forloop.first %}checked{% endif %}
                    >
                    <span>{{ block.settings.label | escape }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          <div class="uc-form__row">
            <div class="uc-form__group">
              <label class="uc-form__label" for="{{ form_id }}-first">{{ section.settings.first_name_label | escape }}</label>
              <input class="uc-form__input" type="text" id="{{ form_id }}-first" name="contact[first_name]" autocomplete="given-name" required
                placeholder="{{ section.settings.first_name_placeholder | escape }}"
                value="{{ form.first_name }}">
            </div>
            {%- if section.settings.show_last_name -%}
              <div class="uc-form__group">
                <label class="uc-form__label" for="{{ form_id }}-last">{{ section.settings.last_name_label | escape }} <em>({{ section.settings.optional_text | escape }})</em></label>
                <input class="uc-form__input" type="text" id="{{ form_id }}-last" name="contact[last_name]" autocomplete="family-name"
                  placeholder="{{ section.settings.last_name_placeholder | escape }}"
                  value="{{ form.last_name }}">
              </div>
            {%- endif -%}
          </div>

          <div class="uc-form__group">
            <label class="uc-form__label" for="{{ form_id }}-email">{{ section.settings.email_label | escape }}</label>
            <input class="uc-form__input" type="email" id="{{ form_id }}-email" name="contact[email]" autocomplete="email" required spellcheck="false" autocapitalize="off"
              placeholder="{{ section.settings.email_placeholder | escape }}"
              value="{% if form.email != blank %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
          </div>

          {%- if section.settings.show_order -%}
            <div class="uc-form__group">
              <label class="uc-form__label" for="{{ form_id }}-order">{{ section.settings.order_label | escape }}</label>
              <input class="uc-form__input" type="text" id="{{ form_id }}-order" name="contact[order_number]"
                placeholder="{{ section.settings.order_placeholder | escape }}"
                value="{{ form.order_number }}">
              {%- if section.settings.order_help != blank -%}
                <p class="uc-form__help">{{ section.settings.order_help | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="uc-form__group">
            <label class="uc-form__label" for="{{ form_id }}-body">{{ section.settings.message_label | escape }}</label>
            <textarea class="uc-form__input" id="{{ form_id }}-body" name="contact[body]" rows="5" required
              placeholder="{{ section.settings.message_placeholder | escape }}">{{ form.body }}</textarea>
          </div>

          <button type="submit" class="uc-btn uc-form__submit" data-sending-label="{{ section.settings.sending_label | escape }}">
            <span class="uc-form__spinner" aria-hidden="true"></span>
            <span class="uc-form__submit-label">{{ section.settings.button_label | escape }}</span>
          </button>
          {%- if section.settings.note != blank -%}
            <p class="uc-form__note">{{ section.settings.note | escape }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<script>
  /* Sending state: spinner + label, and no double submit while Shopify sends the message */
  (function () {
    var form = document.getElementById('{{ form_id }}');
    if (!form) return;
    form.addEventListener('submit', function () {
      var btn = form.querySelector('.uc-form__submit');
      if (!btn || btn.classList.contains('is-loading')) return;
      btn.classList.add('is-loading');
      btn.setAttribute('aria-busy', 'true');
      var label = btn.querySelector('.uc-form__submit-label');
      if (label && btn.dataset.sendingLabel) label.textContent = btn.dataset.sendingLabel;
      // disable after the browser has started sending, so the form data still goes out
      setTimeout(function () { btn.disabled = true; }, 0);
    });
    // back/forward cache: make the button usable again
    window.addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      var btn = form.querySelector('.uc-form__submit');
      if (!btn) return;
      btn.classList.remove('is-loading');
      btn.disabled = false;
      btn.removeAttribute('aria-busy');
      var label = btn.querySelector('.uc-form__submit-label');
      if (label) label.textContent = {{ section.settings.button_label | json }};
    });
  })();
</script>

{% schema %}
{
  "name": "Unit contact: form",
  "tag": "section",
  "class": "section-unit-contact-form",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Optional. Shown on tablets and phones; uses the desktop image when empty." },
    { "type": "color", "id": "card_bg", "label": "Form background", "default": "#F5F5F5" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Send Us a Message." },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Fields marked optional can be skipped." },
    { "type": "header", "content": "Fields" },
    { "type": "text", "id": "topic_label", "label": "Topic label", "default": "What's it about?" },
    { "type": "text", "id": "first_name_label", "label": "First name label", "default": "First name" },
    { "type": "text", "id": "first_name_placeholder", "label": "First name placeholder", "default": "Your first name" },
    { "type": "checkbox", "id": "show_last_name", "label": "Show last name", "default": true },
    { "type": "text", "id": "last_name_label", "label": "Last name label", "default": "Last name" },
    { "type": "text", "id": "last_name_placeholder", "label": "Last name placeholder", "default": "Your last name" },
    { "type": "text", "id": "optional_text", "label": "\"Optional\" text", "default": "optional" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "you@email.com" },
    { "type": "checkbox", "id": "show_order", "label": "Show order number", "default": true },
    { "type": "text", "id": "order_label", "label": "Order number label", "default": "Order number" },
    { "type": "text", "id": "order_placeholder", "label": "Order number placeholder", "default": "e.g. #1042" },
    { "type": "text", "id": "order_help", "label": "Order number help text", "default": "It's in your confirmation email." },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "Tell us what happened and what you'd like us to do." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "sending_label", "label": "Button label while sending", "default": "Sending…" },
    { "type": "text", "id": "note", "label": "Note under the button", "info": "Optional." },
    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "success_message", "label": "Sent message", "default": "Thanks! We got your message and will get back to you within one business day." },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "Please check the fields below and try again." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Order status" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Unit contact: form",
      "blocks": [
        { "type": "topic", "settings": { "label": "Order status" } },
        { "type": "topic", "settings": { "label": "Return or exchange" } },
        { "type": "topic", "settings": { "label": "Warranty claim" } },
        { "type": "topic", "settings": { "label": "Product question" } },
        { "type": "topic", "settings": { "label": "Something else" } }
      ]
    }
  ]
}
{% endschema %}
