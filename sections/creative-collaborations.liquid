{%- liquid
  assign background = section.settings.background
  assign heading_highlight = section.settings.heading_highlight
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign text = section.settings.text
  assign cta_heading = section.settings.cta_heading
  assign cta_text = section.settings.cta_text
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign secondary_button_label = section.settings.secondary_button_label
  assign secondary_button_link = section.settings.secondary_button_link
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile

  assign section_loading = 'lazy'
  if section.index <= 2
    assign section_loading = 'eager'
  endif

  assign partner_count = section.blocks.size
  assign partners_markup = ''
  assign media_markup = ''
-%}

{%- for block in section.blocks -%}
  {%- liquid
    assign partner_name = block.settings.name
    assign partner_category = block.settings.category
    assign partner_image = block.settings.image

    assign image_loading = 'lazy'
    if forloop.first
      assign image_loading = section_loading
    endif

    assign partner_image_alt = partner_image.alt | default: partner_name
  -%}

  {%- capture partner_html -%}
    <button
      type="button"
      class="creative-collaborations__partner"
      role="tab"
      id="CreativeCollaborationsTab-{{ block.id }}"
      aria-controls="CreativeCollaborationsPanel-{{ block.id }}"
      aria-selected="{{ forloop.first }}"
      {% unless forloop.first %}
        tabindex="-1"
      {% endunless %}
      {{ block.shopify_attributes }}
    >
      <span>{{ partner_name | escape }}</span>
      {%- if partner_category != blank -%}
        <span>{{ partner_category | escape }}</span>
      {%- endif -%}
    </button>
  {%- endcapture -%}

  {%- capture media_html -%}
    <div
      class="creative-collaborations__image"
      role="tabpanel"
      id="CreativeCollaborationsPanel-{{ block.id }}"
      aria-labelledby="CreativeCollaborationsTab-{{ block.id }}"
      {% unless forloop.first %}
        hidden
      {% endunless %}
    >
      {%- if partner_image != blank -%}
        {{
          partner_image
          | image_url: width: 1400
          | image_tag:
            loading: image_loading,
            widths: '375, 550, 750, 1000, 1400',
            sizes: '(min-width: 769px) 44vw, calc(100vw - 36px)',
            alt: partner_image_alt
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  {%- endcapture -%}

  {%- liquid
    assign partners_markup = partners_markup | append: partner_html
    assign media_markup = media_markup | append: media_html
  -%}
{%- endfor -%}

<style>
  #shopify-section-{{ section.id }} .creative-collaborations {
    --creative-collaborations-bg: {{ background }};
    --creative-collaborations-pt: {{ padding_top }}px;
    --creative-collaborations-pb: {{ padding_bottom }}px;
    --creative-collaborations-pt-mobile: {{ padding_top_mobile }}px;
    --creative-collaborations-pb-mobile: {{ padding_bottom_mobile }}px;
  }

  .creative-collaborations {
    padding-top: var(--creative-collaborations-pt-mobile);
    padding-bottom: var(--creative-collaborations-pb-mobile);
    background: var(--creative-collaborations-bg);
    color: #fff;
  }

  .creative-collaborations__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 18px;
  }

  .creative-collaborations__header {
    padding-block-end: 36px;
  }

  .creative-collaborations__heading {
    padding-block-end: 36px;
  }

  .creative-collaborations__heading h2 {
    margin: 0;
    font-family: var(--font-canela), var(--font-body-family);
    color: #FFF;
    font-size: 34px;
    line-height: 31.029px;
    letter-spacing: -0.34px;
    font-weight: 100;
  }

  .creative-collaborations__heading strong {
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    font-size: 30.421px;
    letter-spacing: -0.913px;
    font-weight: 700;
  }

  .creative-collaborations__subheading {
    margin-bottom: 28px;
  }

  .creative-collaborations__subheading p {
    margin: 0;
    font-family: var(--font-canela), var(--font-body-family);
    color: #FFF;
    font-size: 20px;
    line-height: 27px;
    font-weight: 100;
  }

  .creative-collaborations__text p {
    margin: 0;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #ffffffbf;
    font-size: 15px;
    line-height: 24.75px;
    font-weight: 400;
  }

  .creative-collaborations__text p + p {
    margin-top: 0.8em;
  }

  .creative-collaborations__text a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .creative-collaborations__body {
    display: flex;
    flex-direction: column;
  }

  .creative-collaborations__media {
    order: -1;
    margin-bottom: 36px;
  }

  .creative-collaborations__image {
    aspect-ratio: 19 / 20;
    overflow: hidden;
    border-radius: 6px;
    background: #1a1a1a;
  }

  .creative-collaborations__image[hidden] {
    display: none;
  }

  .creative-collaborations__image img,
  .creative-collaborations__image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .creative-collaborations__image svg {
    fill: #3a3a3a;
  }

  .creative-collaborations__partner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 14px 0;
    border: 0;
    border-bottom: 1px solid #ffffff99;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .creative-collaborations__partner[aria-selected='true'] {
    opacity: 1;
  }

  .creative-collaborations__partner span:first-child {
    font-family: var(--font-canela), var(--font-body-family);
    color: #fff;
    font-size: 24px;
    line-height: normal;
    font-weight: 100;
    transition: transform 0.3s ease;
  }

  .creative-collaborations__partner span + span {
    flex-shrink: 0;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #ffffff73;
    font-size: 12px;
    line-height: normal;
    font-weight: 400;
    text-align: right;
  }

  .creative-collaborations__partner[aria-selected='true'] span:first-child {
    transform: translateX(12px);
  }

  .creative-collaborations__partner:focus-visible,
  .creative-collaborations__button a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .creative-collaborations__cta {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 36px;
    padding: 22px;
    border: 1px solid #ffffff38;
    border-radius: 14px;
  }

  .creative-collaborations__cta-heading {
    padding-block-end: 16px;
  }

  .creative-collaborations__cta-heading h3 {
    margin: 0;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #FFF;
    font-size: 21.12px;
    line-height: 22.387px;
    letter-spacing: -0.634px;
    font-weight: 700;
  }

  .creative-collaborations__cta-heading em {
    font-family: var(--font-canela), var(--font-body-family);
    font-weight: 300;
    font-style: italic;
  }

  .creative-collaborations__cta-text p {
    margin: 0;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #ffffffbf;
    font-size: 15px;
    line-height: 22.5px;
    font-weight: 400;
  }

  .creative-collaborations__actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .creative-collaborations__button a {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    border: 1px solid #fff;
    border-radius: 999px;
    background: #fff;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #000;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 0.14px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .creative-collaborations__button a:hover {
    background: #e6e6e6;
  }

  .creative-collaborations__button--secondary a {
    background: none;
    color: #fff;
  }

  .creative-collaborations__button--secondary a:hover {
    background: #fff;
    color: #000;
  }

  @media (min-width: 769px) {
    .creative-collaborations {
      padding-top: var(--creative-collaborations-pt);
      padding-bottom: var(--creative-collaborations-pb);
    }

    .creative-collaborations__container {
      padding: 0 36px;
    }

    .creative-collaborations__header {
      padding-block-end: 72px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: 32px;
    }

    .creative-collaborations__heading {
      padding-block-end: 0;
    }

    .creative-collaborations__heading h2 {
      font-size: 51px;
      line-height: 46.418px;
      letter-spacing: -0.51px;
      font-weight: 300;
    }

    .creative-collaborations__heading strong {
      font-size: 45.508px;
      letter-spacing: -1.365px;
    }

    .creative-collaborations__subheading {
      display: none;
    }

    .creative-collaborations__text {
      max-width: 590px;
    }

    .creative-collaborations__body {
      display: grid;
      grid-template-columns: minmax(0, 405fr) minmax(0, 346fr);
      align-items: start;
      gap: clamp(40px, 4.5vw, 64px);
    }

    .creative-collaborations__media {
      order: 0;
      margin-bottom: 0;
    }

    .creative-collaborations__image {
      aspect-ratio: 7 / 6;
    }

    .creative-collaborations__partner {
      padding: 20px 0;
    }

    .creative-collaborations__partner span:first-child {
      font-size: 36px;
      font-weight: 300;
    }

    .creative-collaborations__partner span + span {
      font-size: 13px;
      font-weight: 700;
    }

    .creative-collaborations__partner[aria-selected='true'] span:first-child {
      transform: translateX(14px);
    }

    .creative-collaborations__cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      margin-top: 72px;
      padding: 28px 32px;
    }

    .creative-collaborations__cta-content {
      max-width: 560px;
    }

    .creative-collaborations__cta-heading {
      padding-block-end: 6px;
    }

    .creative-collaborations__cta-heading h3 {
      font-size: 22px;
      line-height: 23.32px;
      letter-spacing: -0.66px;
    }

    .creative-collaborations__cta-heading em {
      font-size: 25px;
      letter-spacing: -0.25px;
      font-style: normal;
    }

    .creative-collaborations__cta-text p {
      font-size: 14.5px;
      line-height: 21.75px;
    }

    .creative-collaborations__actions {
      flex-direction: row;
      gap: 10px;
      flex-shrink: 0;
    }
  }
</style>

<section class="creative-collaborations">
  <div class="creative-collaborations__container">
    <div class="creative-collaborations__header">
      {%- if heading_highlight != blank or heading != blank -%}
        <div class="creative-collaborations__heading">
          <h2>
            {%- if heading_highlight != blank -%}
              <strong>{{ heading_highlight | escape }}</strong>
              {%- if heading != blank %}<br>{% endif -%}
            {%- endif -%}
            {{- heading | escape -}}
          </h2>
        </div>
      {%- endif -%}

      {%- if subheading != blank or text != blank -%}
        <div class="creative-collaborations__intro">
          {%- if subheading != blank -%}
            <div class="creative-collaborations__subheading">
              <p>{{ subheading | escape }}</p>
            </div>
          {%- endif -%}

          {%- if text != blank -%}
            <div class="creative-collaborations__text">
              {{ text }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if partner_count > 0 -%}
      <creative-collaborations-list class="creative-collaborations__body">
        <div class="creative-collaborations__partners" role="tablist" aria-orientation="vertical" aria-label="Partners">
          {{ partners_markup }}
        </div>

        <div class="creative-collaborations__media">
          {{ media_markup }}
        </div>
      </creative-collaborations-list>
    {%- endif -%}

    {%- if cta_heading != blank or cta_text != blank or button_label != blank or secondary_button_label != blank -%}
      <div class="creative-collaborations__cta">
        <div class="creative-collaborations__cta-content">
          {%- if cta_heading != blank -%}
            <div class="creative-collaborations__cta-heading">
              <h3>{{ cta_heading }}</h3>
            </div>
          {%- endif -%}

          {%- if cta_text != blank -%}
            <div class="creative-collaborations__cta-text">
              <p>{{ cta_text }}</p>
            </div>
          {%- endif -%}
        </div>

        {%- if button_label != blank or secondary_button_label != blank -%}
          <div class="creative-collaborations__actions">
            {%- if button_label != blank -%}
              <div class="creative-collaborations__button">
                <a {% if button_link != blank %}href="{{ button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                  {{- button_label | escape -}}
                </a>
              </div>
            {%- endif -%}

            {%- if secondary_button_label != blank -%}
              <div class="creative-collaborations__button creative-collaborations__button--secondary">
                <a {% if secondary_button_link != blank %}href="{{ secondary_button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                  {{- secondary_button_label | escape -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% javascript %}
  if (!customElements.get('creative-collaborations-list')) {
    class CreativeCollaborationsList extends HTMLElement {
      connectedCallback() {
        this.tabs = Array.from(this.querySelectorAll('[role="tab"]'));
        this.panels = Array.from(this.querySelectorAll('[role="tabpanel"]'));
        this.canHover = window.matchMedia('(hover: hover)');

        this.handleClick = this.handleClick.bind(this);
        this.handlePointerOver = this.handlePointerOver.bind(this);
        this.handleKeydown = this.handleKeydown.bind(this);
        this.handleBlockSelect = this.handleBlockSelect.bind(this);
        this.preloadImages = this.preloadImages.bind(this);

        this.addEventListener('click', this.handleClick);
        this.addEventListener('pointerover', this.handlePointerOver);
        this.addEventListener('keydown', this.handleKeydown);
        this.addEventListener('shopify:block:select', this.handleBlockSelect);
        this.addEventListener('pointerenter', this.preloadImages, { once: true });
        this.addEventListener('focusin', this.preloadImages, { once: true });
      }

      disconnectedCallback() {
        this.removeEventListener('click', this.handleClick);
        this.removeEventListener('pointerover', this.handlePointerOver);
        this.removeEventListener('keydown', this.handleKeydown);
        this.removeEventListener('shopify:block:select', this.handleBlockSelect);
        this.removeEventListener('pointerenter', this.preloadImages);
        this.removeEventListener('focusin', this.preloadImages);
      }

      preloadImages() {
        this.querySelectorAll('img[loading="lazy"]').forEach((image) => {
          image.loading = 'eager';
        });
      }

      handleClick(event) {
        const tab = event.target.closest('[role="tab"]');
        if (tab) this.select(this.tabs.indexOf(tab));
      }

      handlePointerOver(event) {
        if (!this.canHover.matches) return;
        const tab = event.target.closest('[role="tab"]');
        if (tab) this.select(this.tabs.indexOf(tab));
      }

      handleKeydown(event) {
        const index = this.tabs.indexOf(event.target);
        if (index === -1) return;

        const last = this.tabs.length - 1;
        const keys = {
          ArrowDown: index === last ? 0 : index + 1,
          ArrowRight: index === last ? 0 : index + 1,
          ArrowUp: index === 0 ? last : index - 1,
          ArrowLeft: index === 0 ? last : index - 1,
          Home: 0,
          End: last,
        };

        if (!(event.key in keys)) return;
        event.preventDefault();
        this.select(keys[event.key]);
        this.tabs[keys[event.key]].focus();
      }

      handleBlockSelect(event) {
        const tab = event.target.closest('[role="tab"]');
        if (tab) this.select(this.tabs.indexOf(tab));
      }

      select(index) {
        if (index < 0) return;

        this.tabs.forEach((tab, i) => {
          const isActive = i === index;
          tab.setAttribute('aria-selected', isActive);
          tab.tabIndex = isActive ? 0 : -1;
          this.panels[i].hidden = !isActive;
        });
      }
    }

    customElements.define('creative-collaborations-list', CreativeCollaborationsList);
  }
{% endjavascript %}

{% schema %}
{
