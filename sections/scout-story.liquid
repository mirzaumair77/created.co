{% style %}
  .why-choose-us__{{ section.id }}{
      background-color:{{ section.settings.bg_color }};
      padding-top:{{ section.settings.top_padding }}px;
      padding-bottom:{{ section.settings.bottom_padding }}px;
  }
  @media(max-width:768px){
  .why-choose-us__{{ section.id }}{
      padding-top:{{ section.settings.top_padding_mb }}px;
      padding-bottom:{{ section.settings.bottom_padding_mb }}px;
  }
  }
  .why-choose-us__{{ section.id }} .site-container{
      padding-left:40px;
      padding-right:0px;
  }
  .why-choose-us__header{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:20px;
    padding-bottom:40px;
    padding-right:38px;
  }
  .why-choose-us__header-text{
      width:100%;
      max-width:70%;
      display:flex;
      flex-direction:column;
      gap:12px;
  }
  .why-choose-us__subtitle p{
      color: #0E1F2A;
      font-size: 10px;
      font-weight: 700;
      line-height: 14px;
      text-transform: uppercase;
      margin:0;
  }
  .why-choose-us__heading h2{
      color: #0E1F2A;
      font-size: 32px;
      font-weight: 300;
      line-height: 26px;
      text-transform: capitalize;
      margin:0;
  }
  .why-choose-us__description p{
      color: #6E797F;
      font-size: 16px;
      font-weight: 400;
      line-height: 22px;
      margin:0;
          max-width: 660px;
  }

  /* --- native carousel-component nav arrows (header) --- */
  .why-choose-us__nav{
    display:flex;
    align-items:center;
    gap:10px;
  }
  .why-choose-us__nav button{
    width:32px;
    height:32px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    cursor:pointer;
    padding:0;
    transition:background .2s ease, opacity .2s ease;
  }
  button.why-choose-us__prev {
    rotate: 180deg;
  }
  .why-choose-us__nav button:hover{
    background:#F2F2F2;
  }
   .why-choose-us__nav button:disabled{
    opacity:0.35;
    cursor:default;
  }
  .why-choose-us__nav svg{
    width:8px;
    height:28px;
    pointer-events:none;
  }
  .why-choose-us__slider.flickity-enabled{
    overflow:visible;
  }
  .why-choose-us__slider .flickity-viewport{
    overflow:hidden;
  }
  .why-choose-us__{{ section.id }} .why-choose-us__item {
      border-radius:12px;
      width:100%;
      max-width:31.5%;
      margin-right:20px;
      position:relative;
      overflow:hidden;

  }
  .why-choose-us__item-image img{
    width:100%;
    height:auto;
    display:flex;
  }
  .why-choose-us__item-content{
      display:flex;
      flex-direction:column;
      gap:15px;
      position:absolute;
      bottom:31px;
      left:40px;
      right:40px;
      z-index:2;

  }
  .why-choose-us__item-title h4{
      color: #FFF;
      font-size: 16px;
      font-weight: 700;
      line-height: 22px;
      margin:0;
  }
  .why-choose-us__item-text p{
      color: #FFF;
      font-size: 14px;
      font-weight: 400;
      line-height: 16px;
      margin:0;
  }
  .why-choose-us__item::before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(
      180deg,
      rgba(42, 21, 9, 0) 0%,
      rgba(42, 21, 9, 0.12) 12%,
      rgba(42, 21, 9, 0.78) 78%
    );
    z-index:1;
    pointer-events:none;
  }
  @media (max-width:768px){
  .why-choose-us__{{ section.id }} .site-container{
      padding:0px 16px;
  }
    .why-choose-us__{{ section.id }} .why-choose-us__item {
      border-radius:20px;
      max-width:74%;
      margin-right:16px;
    }
    .why-choose-us__header{
      padding-bottom:24px;
      padding-right:0;
    }
    .why-choose-us__heading h2{
      font-size:24px;
      line-height:26px;
    }
    .why-choose-us__description p{
      font-size:14px;
      max-width:275px;
    }
    .why-choose-us__item-content{
      gap:4px;
      left:20px;
      right:20px;
      bottom:24px;
    }
  }
{% endstyle %}
<div class="why-choose-us why-choose-us__{{ section.id }}">
  <div class="site-container">
    <div class="why-choose-us__header">
      <div class="why-choose-us__header-text">
        {%- assign product_name = product.metafields.product_cards.product_card_title | default: product.title -%}
        {% if section.settings.subtitle != blank %}
          <div class="why-choose-us__subtitle">
            <p>{{ section.settings.subtitle | replace: '[product]', product_name }}</p>
          </div>
        {% endif %}
        {% if section.settings.heading != blank %}
          <div class="why-choose-us__heading">
            <h2>{{ section.settings.heading | replace: '[product]', product_name }}</h2>
          </div>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="why-choose-us__description">
            {{ section.settings.description | replace: '[product]', product_name }}
          </div>
        {% endif %}
      </div>
      {% if section.blocks.size > 1 %}
        <div class="why-choose-us__nav">
          <button type="button" class="why-choose-us__prev" aria-label="Previous" js-prev-button>
           <svg xmlns="http://www.w3.org/2000/svg" width="5" height="10" viewBox="0 0 5 10" fill="none">
              <path d="M7.45058e-08 9.59375L3 4.75H4.78125V4.90625L1.625 9.59375H7.45058e-08ZM7.45058e-08 -3.57628e-07H1.625L4.78125 4.6875V4.84375H3L7.45058e-08 -3.57628e-07Z" fill="#0E1F2A"/>
            </svg>
          </button>
          <button type="button" class="why-choose-us__next" aria-label="Next" js-next-button>
            <svg xmlns="http://www.w3.org/2000/svg" width="5" height="10" viewBox="0 0 5 10" fill="none">
              <path d="M7.45058e-08 9.59375L3 4.75H4.78125V4.90625L1.625 9.59375H7.45058e-08ZM7.45058e-08 -3.57628e-07H1.625L4.78125 4.6875V4.84375H3L7.45058e-08 -3.57628e-07Z" fill="#0E1F2A"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    <carousel-component
      class="why-choose-us__slider"
      data-options='{"cellSelector":"[js-carousel-slide]","cellAlign":"left","contain":true,"prevNextButtons":false,"pageDots":false,"groupCells":false}'
    >
      <div js-carousel>
        {% for block in section.blocks %}
          <div class="why-choose-us__item" js-carousel-slide {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="why-choose-us__item-image">
                {{
                  block.settings.image
                  | image_url: width: 500
                  | image_tag: alt: block.settings.image.alt, loading: 'lazy'
                }}
              </div>
            {% endif %}
            <div class="why-choose-us__item-content">
              {% if block.settings.title != blank %}
                <div class="why-choose-us__item-title">
                  <h4>{{ block.settings.title | replace: '[product]', product_name }}</h4>
                </div>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="why-choose-us__item-text">
                  {{ block.settings.text | replace: '[product]', product_name }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </carousel-component>

  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var root  = document.querySelector('.why-choose-us__{{ section.id }}');
  var track = root.querySelector('[js-carousel]');
  var flkty = window.Flickity && Flickity.data(track);
  if (!flkty) return;

  flkty.option({ wrapAround: false, contain: true });

  var prevBtn = root.querySelector('.why-choose-us__prev');
  var nextBtn = root.querySelector('.why-choose-us__next');

  function updateNavState() {
    prevBtn.disabled = flkty.selectedIndex === 0;
    nextBtn.disabled = flkty.selectedIndex === flkty.slides.length - 1;
  }

  prevBtn.addEventListener('click', function () { flkty.previous(); });
  nextBtn.addEventListener('click', function () { flkty.next(); });

  flkty.on('select', updateNavState);
  updateNavState();
});
</script>
{% schema %}
{
  "name": "Scout Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top Padding Desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom Padding Desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "top_padding_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top Padding Mobile",
      "default": 40
    },
    {
      "type": "range",
      "id": "bottom_padding_mb",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom Padding Mobile",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "image-with-text",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scout Story"
    }
  ]
}
{% endschema %}
