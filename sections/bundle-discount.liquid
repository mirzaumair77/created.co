<style>
    .bundle-discount_list {
    background: #efefef;
    position: relative;
}
  
  .discount_section.bundle-discount_{{ section.id }} {
    background: {{ section.settings.bg_color }};
  }

  .discount_section.bundle-discount_{{ section.id }} .discount_heading h2 {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
  }

  .discount_section.bundle-discount_{{ section.id }} .discount_result .heading h2 {
    font-size: {{ section.settings.result_heading_size }}px;
    color: {{ section.settings.result_heading_color }};
  }

  .discount_section.bundle-discount_{{ section.id }} .discount_result .discount_button button {
    font-size: {{ section.settings.button_size }}px;
    color: {{ section.settings.button_text_color }};
    background: {{ section.settings.button_bg_color }};
  }

  @media only screen and (max-width: 500px) {

    .discount_section.bundle-discount_{{ section.id }} .discount_heading h2 {
      font-size: {{ section.settings.heading_size_mb }}px;
    }

    .discount_section.bundle-discount_{{ section.id }} .discount_result .heading h2 {
      font-size: {{ section.settings.result_heading_size_mb }}px;
    }

    .discount_section.bundle-discount_{{ section.id }} .discount_result .discount_button button {
      font-size: {{ section.settings.button_size_mb }}px;
    }
  }

  .discount_section.bundle-discount_{{ section.id }} {
    border-top: 2px solid #000000;
    padding: 13px 16px 17px;
    position: fixed;
    bottom: 0;
    left: 0;
    z-index: 10;
    width: 100%;
    background-color: #fff;
  }

  .discount_section .container {
    max-width: 1080px;
    margin: 0 auto;
  }

  .discount_section_bundle_main .discount_heading h2 {
    font-family: canela, serif;
    line-height: normal;
    text-align: center;
  }

  .discount_section_bundle_main .discount_products_main {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    padding: 15px 0 0;
    position: sticky;
    top: 0;
  }

  .discount_section_bundle_main .discount_products_main .discount_list img {
    width: 100%;
    max-width: 83px;
    display: flex;
  }

  .discount_section_bundle_main .discount_result .heading h2 {
    font-family: canela, serif;
    line-height: normal;
    text-align: center;
    padding: 20px 0 14px;
  }

  .discount_section_bundle_main .discount_result .discount_button {
    text-align: center;
  }

  .discount_section_bundle_main .discount_result .discount_button button {
    max-width: 230px;
    width: 100%;
    display: inline-block;
    padding: 15px 10px;
    font-family: grotesque, sans-serif;
    font-weight: 700;
    line-height: normal;
    text-align: center;
    min-height: 32px;
  }
    .remove_product {
    position: absolute;
    right: 12px;
    top: 2px;
}
  .remove_product svg {
    color: #000;
    width: 15px;
}
.discount_button_atc[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
}
  .bundle-total_price {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
}
  .bundle-total_price .original_price {
    text-decoration: line-through;
}
</style>

<div class="discount_section bundle-discount_{{ section.id }}">
  <div class="container">
    <div class="discount_section_bundle_main">
      {% if section.settings.heading != blank %}
        <div class="discount_heading">
          <h2 class="font-thin">{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
      <div class="discount_products_main">
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            <div class="bundle-discount_list bundle-discount_list_{{ forloop.index }}" data-original-src="{{ block.settings.image | image_url: width: 100 }}">
              <span class="remove_product" style="display: none;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z" fill="currentColor"></path></svg></span>
              <img class="bundle-discount_list_img" src="{{ block.settings.image | image_url: width: 100 }}" alt="{{ block.settings.image.alt }}">
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="discount_result">
          <div class="heading">
            <h2 class="font-thin bundle_save_heading bundle_2" data-discount="{{ section.settings.discount_percent_2 }}">{{ section.settings.result_heading_2 }}</h2>
            <h2 class="font-thin bundle_save_heading bundle_3" data-discount="{{ section.settings.discount_percent_3 }}" style="display: none;">{{ section.settings.result_heading_3 }}</h2>
            <h2 class="font-thin bundle_save_heading bundle_4" data-discount="{{ section.settings.discount_percent_4 }}" style="display: none;">{{ section.settings.result_heading_4 }}</h2>
          </div>
          <div class="discount_button">
            <button class="discount_button_atc" disabled="disabled"><span class="discount_button_text">{{ section.settings.button_text | default: "Go to checkout" }}</span> <span class="bundle-total_price"></span></button>
          </div>
      </div>
    </div>
  </div>
</div>
