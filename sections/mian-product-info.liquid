{{ 'custom-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-pdp.js' | asset_url }}" defer="defer"></script>

{%- assign product_form_id = 'cpdp-form-' | append: section.id -%}
{%- assign engrave_price = section.settings.engraving_price -%}

<section class="cpdp" data-section-id="{{ section.id }}">
  <div class="site-container cpdp__inner">

    {%- comment -%} ---------- LEFT : GALLERY ---------- {%- endcomment -%}
    <div class="cpdp__gallery">
       {%- if section.settings.show_tags -%}
      {%- if product.tags.size > 0 -%}
        <div class="cpdp-tags">
          {%- for tag in product.tags limit: 3 -%}
            <span class="cpdp-tag{% if forloop.first %} is-active{% endif %}">{{ tag }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
{%- endif -%}
      {%- if product.images.size > 1 -%}
        <carousel-component
          class="cpdp-gallery"
          data-options='{"cellSelector":"[js-carousel-slide]","cellAlign":"left","contain":true,"autoPlay": 5000 ,"wrapAround":true,"imagesLoaded":true,"prevNextButtons":false,"pageDots":false,"adaptiveHeight":true}'
        >
          <div js-carousel>
            {%- for image in product.images -%}
              <div class="cpdp-gallery__slide" js-carousel-slide data-caption="{{ image.alt | escape }}">
                {% render 'lazy-image', image: image %}
              </div>
            {%- endfor -%}
          </div>
        </carousel-component>

        <div class="cpdp-gallery__nav">
          <div class="cpdp-gallery__dots">
            {%- for image in product.images -%}
              <button
                type="button"
                class="cpdp-gallery__dot{% if forloop.first %} is-active{% endif %}"
                data-index="{{ forloop.index0 }}"
                aria-label="Go to slide {{ forloop.index }}"
              ></button>
            {%- endfor -%}
          </div>
     <span class="cpdp-gallery__caption">{{ product.tags | first | default: section.settings.title }}</span>
        </div>
      {%- else -%}
        <div class="cpdp-gallery cpdp-gallery--single">
          {% render 'lazy-image', image: product.featured_image %}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- RIGHT : BUY BOX ---------- {%- endcomment -%}
    <div class="cpdp__aside">

      <div class="cpdp-card">
        {%- if section.settings.flag_text != blank -%}
          <div class="cpdp-flag">{{ section.settings.flag_text }}</div>
        {%- endif -%}

        <div class="cpdp-card__body">
          <div class="cpdp-head">
            <h1 class="cpdp-title font-canela font-thin">
              {{ product.metafields.product_cards.product_card_title | default: product.title }}
            </h1>
            <div class="cpdp-price no-js-hidden" id="price-{{ section.id }}">
              {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}
            </div>
          </div>

          {%- if product.metafields.info.subtitle != blank -%}
            <p class="cpdp-subtitle">{{ product.metafields.info.subtitle }}</p>
          {%- endif -%}

          <div class="cpdp-rating">
            {% render 'okendo-reviews-product-rating-summary', product: product %}
          </div>

          <product-form class="product-form">
            {%- form 'product', product, id: product_form_id, class: 'cpdp-form__el', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}

              <div class="cpdp-variants">
                {%- if product.metafields.custom.product_size_options != blank -%}
                  <div class="cpdp-variants__size">{% render 'product-variants-size' %}</div>
                {%- endif -%}
                {%- if product.metafields.variants.related_product_color_1 != blank -%}
                  <div class="cpdp-variants__color">{% render 'product-variants-color' %}</div>
                {%- endif -%}
              </div>

              {%- if section.settings.show_engraving -%}
                <label class="cpdp-engrave">
                  <span class="cpdp-engrave__label">
                    {{ section.settings.engraving_label }}
                    {%- if engrave_price != blank -%}
                      <em class="cpdp-engrave__price">+ {{ engrave_price | money }}</em>
                    {%- endif -%}
                  </span>
                  <input type="checkbox" class="cpdp-engrave__input"
                         name="properties[{{ section.settings.engraving_property }}]" value="Yes">
                  <span class="cpdp-engrave__track" aria-hidden="true"></span>
                </label>
              {%- endif -%}

              <div class="cpdp-actions">
               <quantity-input class="quantity cpdp-qty flex border rounded-full p-10">
                          <button class="quantity__button cpdp-qty__btn no-js-hidden w-12" name="minus" type="button">
                            <span class="visually-hidden">
                              {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                            </span>
                            {% render 'icon-minus' %}
                          </button>
                          <input
                            class="quantity__input cpdp-qty__input text-center w-full tablet:w-90"
                            type="number"
                            name="quantity"
                            id="Quantity-{{ section.id }}"
                            min="1"
                            value="1"
                            form="{{ product_form_id }}"
                          >
                          <button class="quantity__button cpdp-qty__btn no-js-hidden w-12" name="plus" type="button">
                            <span class="visually-hidden">
                              {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                            </span>
                            {% render 'icon-plus' %}
                          </button>
                        </quantity-input>

                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

                <button type="submit" name="add" class="cpdp-add"
                        {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
                  <span class="cpdp-add__text">
                    {%- if product.selected_or_first_available_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                  <loading-spinner style="--bg-opacity:100%; --size:1.5rem; --loading-color:#fff;"></loading-spinner>
                </button>
              </div>

              {%- if section.settings.show_dynamic_checkout -%}
                <div class="cpdp-dynamic">{{ form | payment_button }}</div>
              {%- endif -%}
                  {%- if section.settings.ship_text != blank -%}
                    <p class="cpdp-ship">
                      <svg xmlns="http://www.w3.org/2000/svg" width="9" height="7" viewBox="0 0 9 7" fill="none">
                        <path d="M0.000177622 3.62635L1.20188 2.42039L3.17489 4.35931L7.55131 -6.65188e-05L8.76154 1.2059L3.17489 6.76272L0.000177622 3.62635Z" fill="#0B6B3A"/>
                      </svg>
                      <strong>{{ section.settings.ship_text }}</strong>

                      {% comment %} {%- assign min_days = section.settings.ship_min_days | default: 3 -%}
                      {%- assign max_days = section.settings.ship_max_days | default: 5 -%}
                      {%- assign sec_min = min_days | times: 86400 -%}
                      {%- assign sec_max = max_days | times: 86400 -%}
                      {%- assign date_from = 'now' | date: '%s' | plus: sec_min | date: '%b %-d' -%}
                      {%- assign date_to   = 'now' | date: '%s' | plus: sec_max | date: '%-d' -%} {% endcomment %}

                      {% comment %} <span>Arrives {{ date_from }}–{{ date_to }}</span> {% endcomment %}
                       <span> {{ section.settings.arrives_text}}</span> 
                    </p>
                  {%- endif -%}

            {%- endform -%}
          </product-form>
        </div>
      </div>

      {%- assign acc_count = section.blocks | where: 'type', 'collapsible' | size -%}
      {%- if acc_count > 0 -%}
        <div class="cpdp-acc-group">
          {%- assign acc_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collapsible' -%}
              {%- assign acc_i = acc_i | plus: 1 -%}
              <details class="cpdp-acc" {{ block.shopify_attributes }}>
                <summary class="cpdp-acc__head">
                  <span class="cpdp-acc__num">{{ acc_i | prepend: '0' | slice: -2, 2 }} /</span>
                  <span class="cpdp-acc__title">{{ block.settings.heading }}</span>
                  <span class="cpdp-acc__sign" aria-hidden="true"></span>
                </summary>
                <div class="cpdp-acc__body">{{ block.settings.content }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.ordering_title != blank -%}
        <div class="cpdp-bulk">
          <div class="cpdp-bulk__text">
            <strong>{{ section.settings.ordering_title }}</strong>
            <span>{{ section.settings.ordering_subtitle }}</span>
          </div>
          {%- if section.settings.ordering_link != blank -%}
            <a href="{{ section.settings.ordering_link }}" class="cpdp-bulk__btn">
              {{ section.settings.ordering_button | default: 'Go custom' }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- assign ben_count = section.blocks | where: 'type', 'benefit' | size -%}
      {%- if ben_count > 0 -%}
<div class="cpdp-benefits">

  {%- comment -%} Slides ka markup ek dafa capture karein, dono modes mein use hoga {%- endcomment -%}
  {%- capture benefit_slides -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'benefit' -%}
        <div class="cpdp-benefit" js-carousel-slide {{ block.shopify_attributes }}>
          <div class="cpdp-benefit__media">
            {%- if block.settings.video != blank -%}
              <video class="cpdp-benefit__video" autoplay muted loop playsinline preload="metadata"
                     {% if block.settings.image %}poster="{{ block.settings.image | image_url: width: 600 }}"{% endif %}>
                {%- for source in block.settings.video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
              <div class="cpdp-benefit__controls">
                <button type="button" class="cpdp-benefit__ctrl-btn cpdp-benefit__mute-btn" data-action="mute" aria-label="Mute or unmute">
                  <svg class="icon-unmute" viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"/><path d="M16.5 12a4.5 4.5 0 0 0-2.5-4.03v8.06A4.5 4.5 0 0 0 16.5 12z" fill="currentColor"/></svg>
                  <svg class="icon-mute" viewBox="0 0 24 24" width="16" height="16" fill="none" style="display:none"><path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"/><line x1="15" y1="9" x2="21" y2="15" stroke="currentColor" stroke-width="2"/><line x1="21" y1="9" x2="15" y2="15" stroke="currentColor" stroke-width="2"/></svg>
                </button>
                <button type="button" class="cpdp-benefit__ctrl-btn cpdp-benefit__expand-btn" data-action="expand" aria-label="Expand video">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}"
                   alt="{{ block.settings.heading | escape }}" loading="lazy"
                   width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
            {%- endif -%}
          </div>
          {%- if block.settings.heading != blank -%}
            <span class="cpdp-benefit__title">{{ block.settings.heading }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if ben_count > 2 -%}
    {%- comment -%} 3+ items: slider + arrows {%- endcomment -%}
    <carousel-component
      class="cpdp-benefits__slider"
      data-options='{"cellSelector":"[js-carousel-slide]","cellAlign":"left","contain":false,"prevNextButtons":false,"pageDots":false,"groupCells":false,"wrapAround":true,"freeScroll":false}'
    >
      <div class="cpdp-benefits__head">
        <h2 class="cpdp-benefits__title">{{ section.settings.benefits_title | default: 'Your benefits' }}</h2>
        <div class="cpdp-benefits__arrows">
          <button type="button" class="cpdp-arrow" aria-label="Previous" js-prev-button>
            {% render 'icon-arrow-left-new' %}
          </button>
          <button type="button" class="cpdp-arrow" aria-label="Next" js-next-button>
            {% render 'icon-arrow-right-new' %}
          </button>
        </div>
      </div>
      <div js-carousel>{{ benefit_slides }}</div>
    </carousel-component>
  {%- else -%}
    {%- comment -%} 1–2 items: no slider, no arrows {%- endcomment -%}
    <div class="cpdp-benefits__static">
      <div class="cpdp-benefits__head">
        <h2 class="cpdp-benefits__title">{{ section.settings.benefits_title | default: 'Your benefits' }}</h2>
      </div>
      <div class="cpdp-benefits__grid">{{ benefit_slides }}</div>
    </div>
  {%- endif -%}

</div>
        {%- if ben_count > 0 -%}
                <div class="cpdp-video-modal" data-cpdp-video-modal>
                  <div class="cpdp-video-modal__backdrop" data-cpdp-modal-close></div>
                  <div class="cpdp-video-modal__content">
                    <button type="button" class="cpdp-video-modal__close" data-cpdp-modal-close aria-label="Close">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </button>
<div class="cpdp-video-modal__video-slot" data-cpdp-modal-video-slot></div>      
              <button type="button" class="cpdp-video-modal__mute" data-cpdp-modal-mute aria-label="Mute or unmute">
                      <svg class="icon-unmute" viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"/><path d="M16.5 12a4.5 4.5 0 0 0-2.5-4.03v8.06A4.5 4.5 0 0 0 16.5 12z" fill="currentColor"/></svg>
                      <svg class="icon-mute" viewBox="0 0 24 24" width="18" height="18" fill="none" style="display:none"><path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"/><line x1="15" y1="9" x2="21" y2="15" stroke="currentColor" stroke-width="2"/><line x1="21" y1="9" x2="15" y2="15" stroke="currentColor" stroke-width="2"/></svg>
                    </button>
                  </div>
                </div>
              {%- endif -%}
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom PDP Hero",
  "tag": "section",
  "class": "cpdp-section",
  "settings": [
    { "type": "header", "content": "Purchase card" },
    { "type": "text", "id": "flag_text", "label": "Top flag text", "default": "Cupholder Friendly" },
        { "type": "header", "content": "Show Tags" },
    { "type": "checkbox", "id": "show_tags", "label": "Show tags", "default": true },
    { "type": "header", "content": "Engraving" },
    { "type": "checkbox", "id": "show_engraving", "label": "Show engraving toggle", "default": true },
    { "type": "text", "id": "engraving_label", "label": "Engraving label", "default": "Add engraving" },
    { "type": "text", "id": "engraving_property", "label": "Cart property name", "default": "Engraving", "info": "Saved on the line item. The +$10 charge must be handled by your engraving app or a linked variant." },
    { "type": "text", "id": "engraving_price", "label": "Displayed add-on price (in cents)", "default": "1000", "info": "Display only, e.g. 1000 = $10.00" },
    { "type": "header", "content": "Checkout" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": false },
    { "type": "text", "id": "ship_text", "label": "Shipping line", "default": "Ships free over $75." },
    { "type": "text", "id": "arrives_text", "label": "Arrival estimate", "default": "Arrives Aug 19–21." },
    { "type": "header", "content": "Bulk / custom order" },
    { "type": "text", "id": "ordering_title", "label": "Title", "default": "Ordering 25+?" },
    { "type": "text", "id": "ordering_subtitle", "label": "Subtitle", "default": "Add your logo — bulk pricing." },
    { "type": "text", "id": "ordering_button", "label": "Button label", "default": "Go custom" },
    { "type": "url", "id": "ordering_link", "label": "Button link" },
    { "type": "header", "content": "Your benefits slider" },
    { "type": "text", "id": "benefits_title", "label": "Heading", "default": "Your benefits" }
  ],
  "blocks": [
    { "type": "collapsible", "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Benefits" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ] },
    { "type": "benefit", "name": "Benefit card",
      "settings": [
        { "type": "text", "id": "heading", "label": "Title", "default": "12 Hours Cold" },
        { "type": "image_picker", "id": "image", "label": "Image (also used as video poster)" },
        { "type": "video", "id": "video", "label": "Video (autoplays muted, overrides image)" }
      ] }
  ],
  "presets": [
    { "name": "Custom PDP Hero",
      "blocks": [
        { "type": "collapsible", "settings": { "heading": "Benefits" } },
        { "type": "collapsible", "settings": { "heading": "Specifications" } },
        { "type": "benefit", "settings": { "heading": "12 Hours Cold" } },
        { "type": "benefit", "settings": { "heading": "100% Leakproof" } }
      ] }
  ]
}
{% endschema %}
