<section class="page__footer bg-white px-15 py-24 tablet:px-48 tablet:pb-102"{% if section.settings.bg_color != blank %} style="background-color: {{ section.settings.bg_color }};"{% endif %}>
	<div class="page-footer__container tablet:flex tablet:max-w-1440 mx-auto px-15 tablet:px-0 flex-wrap">
		<p class="page-footer__title tablet:w-1/2 mb-24 tablet:mb-0 tablet:px-48 leading-tight text-20 tablet:text-30 font-canela font-thin">
			{{ section.settings.big_text }}
		</p>
	  <div class="page-footer__info tablet:w-1/2 {% unless section.settings.main_text_padding %}tablet:{% endunless %}px-48">
	    {% if section.settings.main_text != blank %}
	      <div class="page-footer__text {% if section.settings.font == 'serif' %}text-16 tablet:text-20 font-semibold{% else %}text-20 tablet:text-30 font-canela font-thin{% endif %}">
	        {{ section.settings.main_text }}
	      </div>
	      {% if section.settings.link_url != blank and section.settings.button_below != true %}
	      	<a class="page-footer__link btn mt-24 {% if section.settings.extra_spacing %}tablet:mt-142{% else %}tablet:mt-38{% endif %} px-25" href="{{ section.settings.link_url }}">
	      		{{ section.settings.link_text }}
	      	</a>
	      {% endif %}
	    {% endif %}
	  </div>
	  {% if section.settings.link_url != blank and section.settings.button_below %}
	  	<div class="w-full text-center">
	      <a class="page-footer__link btn mt-24 {% if section.settings.extra_spacing %}tablet:mt-142{% else %}tablet:mt-38{% endif %} px-25" href="{{ section.settings.link_url }}">
	        {{ section.settings.link_text }}
	      </a>
	  	</div>
	  {% endif %}
	</div>
</section>

{% schema %}
{
	"name": "Half text",
	"settings": [
		{
			"type": "header",
			"content": "Left text"
		},
		{
			"type": "textarea",
			"id": "big_text",
			"label": "Left text",
			"info": "Canela Thin font"
		},
		{
			"type": "header",
			"content": "Right text"
		},
		{
			"type": "richtext",
			"id": "main_text",
			"label": "Right text"
		},
		{
	    	"type": "select",
	    	"id": "font",
	    	"label": "Right text font",
	    	"options": [
	    		{
	    			"value": "serif",
	    			"label": "Grotesque"
	    		},
	    		{
	    			"value": "sans-serif",
	    			"label": "Canela"
	    		}
	    	],
	    	"default": "serif"
	    },
	    {
	    	"type": "checkbox",
	    	"id": "main_text_padding",
	    	"label": "Extra padding on main text",
	    	"info": "Only effects mobile display",
	    	"default": true
	    },
	    {
	    	"type": "header",
	    	"content": "Button"
	    },
		{
			"type": "text",
			"id": "link_text",
			"label": "Link text"
		},
		{
			"type": "url",
			"id": "link_url",
			"label": "Link url"
		},
		{
	    	"type": "checkbox",
	    	"id": "extra_spacing",
	    	"label": "Extra spacing above button",
	    	"default": false
	    },
	    {
	    	"type": "checkbox",
	    	"id": "button_below",
	    	"label": "Button centered below all content",
	    	"default": false,
	    	"info": "If \"True\", button will be aligned with right text"
	    }
	]
}
{% endschema %}