{%- comment -%}
  Custom cart drawer
  - Rendered statically from the layout: {% section 'cart-drawer' %}
  - Re-rendered by assets/cart-drawer.js through the Section Rendering API
    (only [data-cd-content] is swapped, so express checkout buttons keep working)
  - [data-cd-body] is the one scroll area: header sticks, summary + payment icons scroll with the items
  - All text, colors and upsell products live in Theme settings → Cart drawer
{%- endcomment -%}

{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign threshold = settings.cart_drawer_shipping_threshold | default: 0 | times: 100 | round
  assign remaining = threshold | minus: cart.total_price
  assign shipping_bar = false
  if settings.cart_drawer_shipping_enabled and threshold > 0
    assign shipping_bar = true
  endif
  assign shipping_unlocked = false
  if threshold > 0 and remaining <= 0
    assign shipping_unlocked = true
  endif
  assign progress = 0
  if threshold > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  endif
  assign savings = cart.original_total_price | minus: cart.total_price
-%}

<style>
  #CreatedCartDrawer {
    --cd-width: {{ settings.cart_drawer_width | default: 420 }}px;
    --cd-accent: {{ settings.cart_drawer_accent_color | default: '#E25702' }};
    --cd-checkout-bg: {{ settings.cart_drawer_checkout_bg | default: '#0E1F2A' }};
    --cd-checkout-text: {{ settings.cart_drawer_checkout_text | default: '#FFFFFF' }};
    --cd-bar-bg: {{ settings.cart_drawer_bar_bg | default: '#F5F5F5' }};
    --cd-badge-bg: {{ settings.cart_drawer_badge_bg | default: '#0E1F2A' }};
    --cd-text: {{ settings.cart_drawer_text_color | default: '#0E1F2A' }};
    --cd-muted: {{ settings.cart_drawer_muted_color | default: '#6E797F' }};
    --cd-soft: {{ settings.cart_drawer_tile_bg | default: '#F5F5F5' }};
    --cd-line: {{ settings.cart_drawer_line_color | default: '#E7E9EA' }};
    --cd-border: {{ settings.cart_drawer_border_color | default: '#CFD2D4' }};
    --cd-title-size: {{ settings.cart_drawer_title_size | default: 30 }}px;
  }
  {%- unless settings.cart_drawer_provider == 'rebuy' %}
  #rebuy-cart, .rebuy-cart, .rebuy-cart__background { display: none !important; }
  {%- endunless %}
</style>

<created-cart-drawer id="CreatedCartDrawer" class="cd" data-section-id="{{ section.id }}" data-provider="{{ settings.cart_drawer_provider | default: 'custom' }}" aria-hidden="true">
  <div class="cd__overlay" data-cd-close></div>

  <div class="cd__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <form id="CartDrawerForm" action="{{ routes.cart_url }}" method="post" novalidate></form>

    <div class="cd__body" data-cd-body>
    <div class="cd__content" data-cd-content data-item-count="{{ cart.item_count }}">
      <header class="cd__header">
        <h2 id="CartDrawerTitle" class="cd__title font-canela">
          {{ settings.cart_drawer_title | default: 'Your Cart' | escape }}
          <span class="cd__count">({{ cart.item_count }})</span>
        </h2>
        <button type="button" class="cd__close" data-cd-close aria-label="{{ 'accessibility.close' | t }}">
         <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
  <path d="M13.5 4.5L4.5 13.5" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
  <path d="M4.5 4.5L13.5 13.5" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
</svg>
        </button>
      </header>

      {%- comment -%} Free shipping bar: rendered inside the scroll area so it isn't sticky {%- endcomment -%}
      {%- capture shipping_bar_html -%}
        {%- if shipping_bar -%}
          <div class="cd__ship{% if shipping_unlocked %} is-unlocked{% endif %}">
            <p class="cd__ship-text">
              {%- if shipping_unlocked -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 16.5a7.5 7.5 0 100-15 7.5 7.5 0 000 15z" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/><path d="M6.25 9.2l1.9 1.9 3.6-3.8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/></svg>
                <span>{{ settings.cart_drawer_shipping_unlocked | escape }}</span>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
  <path d="M10.5 13.5V4.5C10.5 4.10218 10.342 3.72064 10.0607 3.43934C9.77936 3.15804 9.39782 3 9 3H3C2.60218 3 2.22064 3.15804 1.93934 3.43934C1.65804 3.72064 1.5 4.10218 1.5 4.5V12.75C1.5 12.9489 1.57902 13.1397 1.71967 13.2803C1.86032 13.421 2.05109 13.5 2.25 13.5H3.75" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
  <path d="M11.25 13.5H6.75" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
  <path d="M14.25 13.5H15.75C15.9489 13.5 16.1397 13.421 16.2803 13.2803C16.421 13.1397 16.5 12.9489 16.5 12.75V10.0125C16.4997 9.8423 16.4415 9.67726 16.335 9.5445L13.725 6.282C13.6549 6.19416 13.5659 6.12321 13.4646 6.0744C13.3633 6.02559 13.2524 6.00016 13.14 6H10.5" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
  <path d="M14.25 13.5C14.25 14.3284 13.5784 15 12.75 15C11.9216 15 11.25 14.3284 11.25 13.5C11.25 12.6716 11.9216 12 12.75 12C13.5784 12 14.25 12.6716 14.25 13.5Z" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
  <path d="M6.75 13.5C6.75 14.3284 6.07843 15 5.25 15C4.42157 15 3.75 14.3284 3.75 13.5C3.75 12.6716 4.42157 12 5.25 12C6.07843 12 6.75 12.6716 6.75 13.5Z" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
</svg>
                {%- capture amount_html -%}<strong class="cd__accent">{{ remaining | money }}</strong>{%- endcapture -%}
                <span>{{ settings.cart_drawer_shipping_locked | escape | replace: '[amount]', amount_html }}</span>
              {%- endif -%}
            </p>
            <div class="cd__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}">
              <span style="width: {{ progress }}%;"></span>
            </div>
          </div>
        {%- endif -%}
      {%- endcapture -%}

      <div class="cd__scroll" data-cd-scroll>
        {{ shipping_bar_html }}
        {%- if cart.item_count > 0 -%}
          <ul class="cd__items" role="list">
            {%- for item in cart.items -%}
              <li class="cd-item" data-key="{{ item.key }}">
                <a href="{{ item.url }}" class="cd-item__media" tabindex="-1">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title, class: 'cd-item__img' }}
                  {%- endif -%}
                </a>

                <div class="cd-item__info">
                  <a href="{{ item.url }}" class="cd-item__title">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="cd-item__meta">{{ item.variant.title | escape }}</p>
                  {%- endunless -%}
                  {%- if item.selling_plan_allocation -%}
                    <p class="cd-item__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                  {%- endif -%}
                  {%- for property in item.properties -%}
                    {%- assign first_char = property.first | slice: 0 -%}
                    {%- if property.last != blank and first_char != '_' -%}
                      <p class="cd-item__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- comment -%} Product and order discounts (e.g. "25% OFF · BUNDLE25", "$5 OFF · CODE") {%- endcomment -%}
                  {%- assign item_discount_total = 0 -%}
                  {%- for allocation in item.discount_allocations -%}
                    {%- assign item_discount_total = item_discount_total | plus: allocation.amount -%}
                    {%- assign application = allocation.discount_application -%}
                    {%- if application.target_type == 'shipping_line' -%}{%- continue -%}{%- endif -%}
                    <span class="cd-item__badge">
                      {%- if application.value_type == 'percentage' -%}
                        {{ application.value | round }}% OFF ·
                      {% elsif application.value_type == 'fixed_amount' and application.target_selection == 'all' -%}
                        {{ application.value | times: 100 | money_without_trailing_zeros }} OFF ·
                      {% endif -%}
                      {{ application.title | escape }}
                    </span>
                  {%- endfor -%}

                  <div class="cd-qty">
                    <button type="button" class="cd-qty__btn" data-cd-step="-1" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">
                      <svg width="10" height="2" viewBox="0 0 10 2" aria-hidden="true"><path d="M0 1h10" stroke="currentColor" stroke-width="1.4"/></svg>
                    </button>
                    <input class="cd-qty__input" type="number" inputmode="numeric" min="0" value="{{ item.quantity }}" data-cd-qty aria-label="{{ 'products.product.quantity.label' | t }}">
                    <button type="button" class="cd-qty__btn" data-cd-step="1" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">
                      <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M0 5h10M5 0v10" stroke="currentColor" stroke-width="1.4"/></svg>
                    </button>
                  </div>
                </div>

                <div class="cd-item__side">
                  {%- assign item_price_after = item.original_line_price | minus: item_discount_total -%}
                  <div class="cd-item__price">
                    <span>{{ item_price_after | money }}</span>
                    {%- if item.original_line_price > item_price_after -%}
                      <s>{{ item.original_line_price | money }}</s>
                    {%- endif -%}
                  </div>
                  <button type="button" class="cd-item__remove" data-cd-remove>Remove</button>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="cd__empty">
            <span class="cd__empty-icon" aria-hidden="true">
<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 26 26" fill="none">
  <path d="M6.5 2.16663L3.25 6.49996V21.6666C3.25 22.2413 3.47827 22.7924 3.8846 23.1987C4.29093 23.605 4.84203 23.8333 5.41667 23.8333H20.5833C21.158 23.8333 21.7091 23.605 22.1154 23.1987C22.5217 22.7924 22.75 22.2413 22.75 21.6666V6.49996L19.5 2.16663H6.5Z" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
  <path d="M3.25 6.5H22.75" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
  <path d="M17.3333 10.8334C17.3333 11.9826 16.8767 13.0848 16.0641 13.8975C15.2514 14.7102 14.1492 15.1667 13 15.1667C11.8507 15.1667 10.7485 14.7102 9.93583 13.8975C9.12317 13.0848 8.66663 11.9826 8.66663 10.8334" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
</svg>            </span>
            <p class="cd__empty-title font-canela">{{ settings.cart_drawer_empty_title | escape }}</p>
            {%- if settings.cart_drawer_empty_text != blank -%}
              <p class="cd__empty-text">{{ settings.cart_drawer_empty_text | escape }}</p>
            {%- endif -%}
            {%- if settings.cart_drawer_empty_button_label != blank -%}
              <a href="{{ settings.cart_drawer_empty_button_link | default: routes.all_products_collection_url }}" class="cd__empty-btn">{{ settings.cart_drawer_empty_button_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if settings.cart_drawer_upsell_enabled -%}
          {%- liquid
            assign upsell_limit = settings.cart_drawer_upsell_limit | default: 8
            # Source priority: Cart drawer products → Cart drawer collection → old "Upsell Product 1–6" settings
            assign upsell_handles = ''
            if settings.cart_drawer_upsell_products.size > 0
              assign upsell_handles = settings.cart_drawer_upsell_products | map: 'handle' | join: ','
            elsif settings.cart_drawer_upsell_collection != blank
              assign upsell_handles = settings.cart_drawer_upsell_collection.products | map: 'handle' | join: ','
            else
              for i in (1..6)
                assign legacy_key = 'upsell_product_' | append: i
                assign legacy_product = settings[legacy_key]
                if legacy_product != blank
                  assign legacy_handle = legacy_product.handle | default: legacy_product
                  assign upsell_handles = upsell_handles | append: ',' | append: legacy_handle
                endif
              endfor
            endif
            assign upsell_handles = upsell_handles | split: ','
            assign cart_variant_ids = cart.items | map: 'variant_id' | join: ','
            assign cart_variant_ids = ',' | append: cart_variant_ids | append: ','
            assign upsell_shown = 0
          -%}
          {%- capture upsell_cards -%}
            {%- for upsell_handle in upsell_handles -%}
              {%- if upsell_shown >= upsell_limit -%}{%- break -%}{%- endif -%}
              {%- if upsell_handle == blank -%}{%- continue -%}{%- endif -%}
              {%- assign product = all_products[upsell_handle] -%}
              {%- if product == blank -%}{%- continue -%}{%- endif -%}
              {%- assign pick = false -%}
              {%- for variant in product.variants -%}
                {%- assign variant_key = ',' | append: variant.id | append: ',' -%}
                {%- if variant.available -%}
                  {%- unless cart_variant_ids contains variant_key -%}
                    {%- assign pick = variant -%}
                    {%- break -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if pick -%}
                {%- assign upsell_shown = upsell_shown | plus: 1 -%}
                {%- assign pick_image = pick.featured_image | default: product.featured_image -%}
                <li class="cd-up">
                  <a href="{{ pick.url }}" class="cd-up__media">
                    {%- if pick_image -%}
                      {{ pick_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.title, class: 'cd-up__img' }}
                    {%- endif -%}
                    {%- liquid
                      assign show_badge = false
                      if shipping_bar and shipping_unlocked == false and settings.cart_drawer_upsell_badge != blank
                        if settings.cart_drawer_upsell_badge_rule == 'unlocks'
                          if pick.price >= remaining
                            assign show_badge = true
                          endif
                        else
                          assign show_badge = true
                        endif
                      endif
                    -%}
                    {%- if show_badge -%}
                      <span class="cd-up__badge">{{ settings.cart_drawer_upsell_badge | escape }}</span>
                    {%- endif -%}
                  </a>
                  <a href="{{ pick.url }}" class="cd-up__title">{{ product.title | escape }}</a>
                  <p class="cd-up__meta">
                    {%- unless product.has_only_default_variant -%}{{ pick.title | escape }} · {% endunless -%}
                    {{ pick.price | money }}
                  </p>
                  <button type="button" class="cd-up__add" data-cd-add="{{ pick.id }}">{{ settings.cart_drawer_upsell_button_label | escape }}</button>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}

          {%- if upsell_shown > 0 -%}
            <div class="cd__upsell">
              <div class="cd__upsell-head">
                <h3 class="cd__upsell-title font-canela">{{ settings.cart_drawer_upsell_title | escape }}</h3>
                {%- if settings.cart_drawer_upsell_swipe_label != blank and upsell_shown > 2 -%}
                  <span class="cd__upsell-swipe">{{ settings.cart_drawer_upsell_swipe_label | escape }} <span aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M2.91663 7H11.0833" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
                    <path d="M7 2.91663L11.0833 6.99996L7 11.0833" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
                  </svg></span></span>
                {%- endif -%}
              </div>
              <ul class="cd__upsell-track" role="list" data-cd-track>{{ upsell_cards }}</ul>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="cd__summary">
        <div class="cd__row">
          <span>{{ settings.cart_drawer_shipping_label | escape }}</span>
          {%- if shipping_bar and shipping_unlocked -%}
            <span class="cd__accent">{{ settings.cart_drawer_shipping_free | escape }}</span>
          {%- else -%}
            <span>{{ settings.cart_drawer_shipping_calculated | escape }}</span>
          {%- endif -%}
        </div>

        {%- for application in cart.discount_applications -%}
          {%- if application.target_type == 'line_item' and application.total_allocated_amount > 0 -%}
            <div class="cd__row">
              <span>{{ settings.cart_drawer_discount_label | escape }} ({{ application.title | escape }})</span>
              <span class="cd__accent">&minus;{{ application.total_allocated_amount | money }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <div class="cd__row cd__row--total">
          <span>{{ settings.cart_drawer_subtotal_label | escape }}</span>
          <span class="aks_total_price">
            {%- if savings > 0 -%}<s>{{ cart.original_total_price | money }}</s>{%- endif -%}
            {{ cart.total_price | money }}
          </span>
        </div>

        {%- if savings > 0 and settings.cart_drawer_savings_text != blank -%}
          {%- capture savings_html -%}{{ savings | money }}{%- endcapture -%}
          <p class="cd__savings">{{ settings.cart_drawer_savings_text | escape | replace: '[amount]', savings_html }}</p>
        {%- endif -%}
        {%- if settings.cart_drawer_taxes_text != blank -%}
          <p class="cd__note">{{ settings.cart_drawer_taxes_text | escape }}</p>
        {%- endif -%}

        <button type="submit" name="checkout" form="CartDrawerForm" class="cd__checkout"{% if cart.item_count == 0 %} disabled{% endif %}>
<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
  <path d="M3.33333 7.33325H12.6667C13.403 7.33325 14 7.93021 14 8.66659V13.3333C14 14.0696 13.403 14.6666 12.6667 14.6666H3.33333C2.59695 14.6666 2 14.0696 2 13.3333V8.66659C2 7.93021 2.59695 7.33325 3.33333 7.33325Z" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
  <path d="M4.66667 7.33325V4.66659C4.66667 3.78253 5.01786 2.93468 5.64298 2.30956C6.2681 1.68444 7.11595 1.33325 8 1.33325C8.88406 1.33325 9.73191 1.68444 10.357 2.30956C10.9821 2.93468 11.3333 3.78253 11.3333 4.66659V7.33325" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/>
</svg>          <span>{{ settings.cart_drawer_checkout_label | escape }} · {{ cart.total_price | money }}</span>
        </button>

        {%- comment -%}
          "Shopify buttons" mode: Shopify's real one-tap buttons.
          Empty cart: the same buttons, faded and not clickable (inert).
          Re-rendered with the cart, so they become clickable as soon as a product is added.
        {%- endcomment -%}
        {%- if settings.cart_drawer_show_express and settings.cart_drawer_express_style == 'dynamic' and additional_checkout_buttons -%}
          <div
            class="cd__express cd__express--dynamic{% if cart.item_count == 0 %} is-disabled{% endif %}"
            {% if cart.item_count == 0 %}aria-disabled="true" inert{% endif %}
          >
            {{ content_for_additional_checkout_buttons }}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="cd__after">
      {%- comment -%} "Shopify buttons" mode is rendered inside the summary (above) so it updates with the cart {%- endcomment -%}
      {%- if settings.cart_drawer_show_express and settings.cart_drawer_express_style != 'dynamic' -%}
        {%- comment -%} Design badges: display only (not clickable), always visible — shows the payment methods we accept {%- endcomment -%}
        <div class="cd__express cd__express--static" role="list" aria-label="Accepted payment methods">
          {%- render 'cart-drawer-payment-badges' -%}
        </div>
      {%- endif -%}
      {%- if settings.cart_drawer_secure_text != blank -%}
        <p class="cd__secure">
          <svg width="11" height="12" viewBox="0 0 11 12" fill="none" aria-hidden="true"><path d="M5.5 1L1 2.75v3.1c0 2.6 1.9 4.6 4.5 5.15 2.6-.55 4.5-2.55 4.5-5.15v-3.1L5.5 1z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
          {{ settings.cart_drawer_secure_text | escape }}
        </p>
      {%- endif -%}
    </div>

    </div>

    <p class="cd__toast" role="alert" data-cd-toast hidden></p>
  </div>
</created-cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Edit the cart drawer in Theme settings → Cart drawer."
    }
  ]
}
{% endschema %}
