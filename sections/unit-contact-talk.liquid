{%- comment -%}
  Contact page: "Talk to a person" bar. Each item is a block (icon, label, value, optional link).
  Phone/email values become tel:/mailto: links automatically when no link is set.
{%- endcomment -%}
{{ 'unit-contact.css' | asset_url | stylesheet_tag }}

<section
  id="UnitContactTalk-{{ section.id }}"
  class="uc uc-talk"
  style="
    --uc-pt: {{ section.settings.padding_top }}px;
    --uc-pb: {{ section.settings.padding_bottom }}px;
    --uc-pt-m: {{ section.settings.padding_top_mobile }}px;
    --uc-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --uc-talk-bg: {{ section.settings.bg }};
  "
>
  <div class="uc__container">
    <div class="uc-talk__bar">
      {%- if section.settings.title != blank -%}
        <h2 class="uc-talk__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign href = block.settings.link
          if href == blank
            if block.settings.icon == 'phone'
              assign digits = block.settings.value | remove: ' ' | remove: '.' | remove: '-' | remove: '(' | remove: ')'
              assign href = 'tel:' | append: digits
            elsif block.settings.icon == 'email'
              assign href = 'mailto:' | append: block.settings.value
            endif
          endif
          assign tag = 'div'
          if href != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }} class="uc-talk__item"{% if href != blank %} href="{{ href }}"{% endif %} {{ block.shopify_attributes }}>
          {% render 'unit-contact-icon', icon: block.settings.icon %}
          <span class="uc-talk__label">{{ block.settings.label | escape }}</span>
          <span class="uc-talk__value">{{ block.settings.value | escape }}</span>
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Unit contact: talk to us",
  "tag": "section",
  "class": "section-unit-contact-talk",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Talk to a person" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F5F5F5" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Contact item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "phone", "label": "Phone" },
            { "value": "email", "label": "Email" },
            { "value": "clock", "label": "Clock" },
            { "value": "chat", "label": "Chat" },
            { "value": "pin", "label": "Location" }
          ],
          "default": "phone"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Call" },
        { "type": "text", "id": "value", "label": "Value", "default": "714.869.7416" },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional. Phone and email link automatically." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Unit contact: talk to us",
      "blocks": [
        { "type": "item", "settings": { "icon": "phone", "label": "Call", "value": "714.869.7416" } },
        { "type": "item", "settings": { "icon": "email", "label": "Email", "value": "hello@created.co" } },
        { "type": "item", "settings": { "icon": "clock", "label": "Hours", "value": "Mon-Fri, 8am-5pm PST" } }
      ]
    }
  ]
}
{% endschema %}
