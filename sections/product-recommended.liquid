{%- liquid
  assign background_color = section.settings.background_color

  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom

  assign heading = section.settings.heading
  assign description = section.settings.description
-%}

{%- style -%}
  product-recommendations {
    display: block;
  }

  #product-recommendations-{{ section.id }} {
    background: {{ background_color }};
    padding-block: {{ padding_top_mobile }}px {{ mobile_padding_bottom }}px;
  }
  .product-recommendations__header{
    padding-bottom:24px;
  }

  @media (min-width: 769px) {
    #product-recommendations-{{ section.id }} {
      padding-block: {{ padding_top }}px {{ padding_bottom }}px;
    }
  }

  .product-recommendations__heading h2 {
    color: #0E1F2A;
    font-size: 24px;
    line-height: 26px;
    font-weight: 300;
    text-transform: capitalize;
    margin: 0;
  }

  .product-recommendations__description {
    padding-block-start: 8px;
  }

  .product-recommendations__description p {
    color: #6E797F;
    font-size: 14px;
    line-height: 22px;
    font-weight: 400;
    margin: 0;
  }

  .product-recommendations__main {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }.product-item__image {
    aspect-ratio: 1 / 1;
}

  @media (min-width: 769px) {
 .product-recommendations__header{
    padding-bottom:34px;
  }
    .product-recommendations__heading h2 {
      font-size: 32px;
    }

    .product-recommendations__description {
      padding-block-start: 18px;
    }

    .product-recommendations__description p {
      font-size: 16px;
    }

    .product-recommendations__main {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media (min-width: 990px) {

    .product-recommendations__main {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<product-recommendations
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div id="product-recommendations-{{ section.id }}">
      <div class="product-recommendations__container site-container">
        {%- if heading != blank or description != blank -%}
          <div class="product-recommendations__header">
            {%- if heading != blank -%}
              <div class="product-recommendations__heading">
                <h2>{{ heading }}</h2>
              </div>
            {%- endif -%}

            {%- if description != blank -%}
              <div class="product-recommendations__description">
                {{ description }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- assign skip_style = false -%}

        <div class="product-recommendations__main">
          {%- for recommendation in recommendations.products -%}
            {%- render 'product-item',
              product: recommendation,
              skip_style: skip_style
            -%}

            {%- assign skip_style = true -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</product-recommendations>

{% javascript %}
  class ProductRecommendations extends HTMLElement {
    constructor() {
      super();

      const handleIntersection = (entries, observer) => {
        if (!entries[0].isIntersecting) return;
        observer.unobserve(this);

        fetch(this.dataset.url)
          .then(response => response.text())
          .then(text => {
            const html = document.createElement('div');
            html.innerHTML = text;
            const recommendations = html.querySelector('product-recommendations');
            if (recommendations && recommendations.innerHTML.trim().length) {
              this.innerHTML = recommendations.innerHTML;
            }
          })
          .catch(e => {
            console.error(e);
          });
      }

      new IntersectionObserver(handleIntersection.bind(this), {rootMargin: '0px 0px 200px 0px'}).observe(this);
    }
  }

  customElements.define('product-recommendations', ProductRecommendations);
{% endjavascript %}

{% schema %}
{
  "name": "Product recommended",
  "tag": "section",
  "class": "section-product-recommended",
  "settings": [
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might also like"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Made in the same 18/8 stainless steel, finished in the same colourways.</p>"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Product recommended"
    }
  ]
}
{% endschema %}
