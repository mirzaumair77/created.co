<link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>
<style>
  .okend-review {
    margin-bottom: 10px;
}
  .mobile-review{display:none}

  @media(max-width:789px){
    .desktop-review{display:none;}
     .mobile-review{display:block}
  }
</style>
{% assign productTags = product.tags | join: ', ' %}
{% capture sold_out_text %}
	{% if productTags contains 'coming_soon' %}Coming Soon{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
{% endcapture %}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
<section class="product__main flex flex-wrap tablet:flex-nowrap flex-col-reverse tablet:flex-row items-start px-15 tablet:px-16 pb-36 tablet:pb-72 justify-between pt-24 tablet:pt-100">
  <div class="product-information--desktop w-full tablet:w-6/12 px-15 tablet:px-16 flex flex-col-reverse tablet:block max-w-540">
    {% if product.metafields.info.subtitle != blank %}
      <span class="block hidden tablet:block text-20 text-lightGray tablet:text-black font-grotesque font-semibold uppercase mb-10">
        {{- product.metafields.info.subtitle -}}
      </span>
    {% endif %}
    <h1 class="text-40 tablet:text-72 desktop:text-100 font-canela font-thin hidden tablet:block">
      {{ product.metafields.product_cards.product_card_title | default: product.title }}
    </h1>
    <div class="okend-review desktop-review">
    {% render 'okendo-reviews-product-rating-summary', product: product %}
      </div>
    <div class="text-15 tablet:text-20 leading-snug mb-46 font-semibold">{{ product.description }}</div>
    
    <div class="variant-selectors">
        {% comment %}
        {% if product.metafields.variants.related_product_size_1 != blank %}
            {% render 'product-size-variants' %}
        {% endif %}
        {% endcomment %}
        {% if product.metafields.variants.related_color_swatch_1 != blank %}
            {% render 'product-color-variants' %}
        {% endif %}
    </div>

    <div class="w-full">
		<a class="btn btn--black mb-100 px-32 py-20" href="https://created.co/pages/hubspot-custom-landing-page">Get Started</a>
	</div>
  </div>
  <div class="product-image w-full tablet:w-6/12 px-0 tablet:px-16">
    {% if product.images.size > 1 %}
      <carousel-component
        class="grid__item w-full overflow-hidden relative"
        data-options='{"cellSelector":"[js-carousel-slide]", "cellAlign":"left", "contain":true, "wrapAround":true, "imagesLoaded":true, "prevNextButtons":false, "adaptiveHeight":true, "pageDots":false}'
      >
        <div class="" js-carousel>
          <button
            class="carousel-arrow carousel-arrow--prev w-20 z-10"
            type="button"
            aria-label="Previous"
            js-prev-button
          >
            {% render 'icon-arrow-left' %}
          </button>
          {% for image in product.images %}
            <div class="w-full" js-carousel-slide>
              <div class="carousel-slide__content relative">
                <div class="carousel-slide__image-container w-full">
                  {% render 'lazy-image', image: image %}
                </div>
              </div>
            </div>
          {% endfor %}
          <button class="carousel-arrow carousel-arrow--next w-20 z-10" type="button" aria-label="Next" js-next-button>
            {% render 'icon-arrow-right' %}
          </button>
        </div>
      </carousel-component>
    {% else %}
      {% render 'lazy-image', image: product.featured_image %}
    {% endif %}
  </div>
  <div class="product-information--mobile px-15 tablet:hidden">
    {% if product.metafields.info.subtitle != blank %}
      <span class="block text-12 font-grotesque font-semibold text-lightGray uppercase mb-25">
        {{- product.metafields.info.subtitle -}}
      </span>
    {% endif %}
    <h1 class="text-40 font-canela font-thin">{{ product.title | split: ' - ' | first }}</h1>
    <div class="okend-review mobile-review">
    {% render 'okendo-reviews-product-rating-summary', product: product %}
      </div>
  </div>
   
</section>

