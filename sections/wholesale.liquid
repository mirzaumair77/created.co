<div class="wholesale-page">
  <section class="wholesale__header px-16 tablet:px-32 laptop:pt-16 max-w-screen-desktop mx-auto">
    {% if section.settings.img == blank and section.settings.img_desktop == blank %}
      {% assign no_image = true %}
    {% endif %}
    <div class="wholesale-header__banner relative flex justify-center items-center">
      {% if section.settings.title_one != blank or section.settings.title_two != blank %}
        <div class="wholesale-header__title text-38 tablet:text-70 desktop:text-98 text-center leading-tight w-3/4
          {% if no_image %}text-black{% else %} absolute text-white{% endif %}">
          <span class="font-canela">{{ section.settings.title_one }}</span>
          <span class="font-grotesque text-40 tablet:text-72 desktop:text-100 font-semibold">{{ section.settings.title_two }}</span>
        </div>
      {% endif %}
      {% if no_image != true %}
        <div class="wholesale-header__img w-full">
          {% render 'lazy-image', image: section.settings.img, image_desktop: section.settings.img_desktop %}
        </div>
      {% endif %}
    </div>
    {% if section.settings.text != blank %}
      <p class="wholesale-header__text text-18 py-24 border-b border-black mb-16 laptop:py-38 laptop:mb-20">
        {{ section.settings.text }}
      </p>
    {% endif %}
  </section>
  <section class="wholesale__contact-form px-16 tablet:px-32 max-w-screen-desktop mx-auto">
    <script charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js"></script>
<script>
  hbspt.forms.create({
    region: "na1",
    portalId: "41774798",
    formId: "6973e4c1-e9f7-44c3-a061-72313cd36bf8"
  });
</script>
