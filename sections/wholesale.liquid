{% schema %}
{
  "name": "Wholesale Page",
  "settings": [
      {
        "type": "header",
        "content": "Image"
      },
      {
        "type": "image_picker",
        "id": "img",
        "label": "Image"
      },
      {
        "type": "image_picker",
        "id": "img_desktop",
        "label": "Image - Desktop"
      },
      {
        "type": "header",
        "content": "Title"
      },
      {
        "type": "text",
        "id": "title_one",
        "label": "Title - 1"
      },
      {
        "type": "text",
        "id": "title_two",
        "label": "Title - 2"
      },
      {
        "type": "header",
        "content": "Description"
      },
      {
        "type": "textarea",
        "id": "text",
        "label": "Description"
      }
    ]
}
{% endschema %}