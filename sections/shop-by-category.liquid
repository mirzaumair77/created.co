{% comment %}
  Section: Shop by category ("Drinkware. Simplified.")
  - Top text (eyebrow, heading, text) from section settings
  - Each "Category card" block: image, mobile image, title, collection, 3 products, link label
  - The bar on each card opens a dropdown with the products + "Shop …" link
  - Only one dropdown open at a time; one card can start open on desktop
  - Desktop: 4 columns · Mobile: 2 × 2 grid
{% endcomment %}

{{ 'shop-by-category.css' | asset_url | stylesheet_tag }}
<script src="{{ 'shop-by-category.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #ShopCat-{{ section.id }} {
    --sc-pad-top: {{ section.settings.padding_top }}px;
    --sc-pad-bottom: {{ section.settings.padding_bottom }}px;
    --sc-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --sc-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --sc-panel-bg: {{ section.settings.panel_bg }};
    --sc-panel-text: {{ section.settings.panel_text }};
    --sc-panel-top: {{ section.settings.panel_top }}%;
  }
{%- endstyle -%}

<section id="ShopCat-{{ section.id }}" class="shop-cat">
  <div class="site-container">
    <div class="shop-cat__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="shop-cat__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="shop-cat__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="shop-cat__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="shop-cat__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign card_title = block.settings.title | default: col.title
          assign card_link = col.url | default: '#'
          if block.settings.link_label != blank
            assign link_label = block.settings.link_label
          else
            assign link_label = 'Shop ' | append: card_title
          endif

          assign use_list = false
          if block.settings.products != blank and block.settings.products.size > 0
            assign use_list = true
          endif
        -%}

        <div
          class="shop-cat__card"
          data-open-default="{{ block.settings.open_default }}"
          {{ block.shopify_attributes }}
        >
          <div class="shop-cat__media">
            {%- if block.settings.image != blank -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ block.settings.image_mobile | image_url: width: 600 }} 600w, {{ block.settings.image_mobile | image_url: width: 900 }} 900w"
                    sizes="50vw"
                  >
                {%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'shop-cat__img',
                    widths: '400, 600, 800, 1000',
                    sizes: '(max-width: 749px) 50vw, 25vw',
                    loading: 'lazy',
                    alt: card_title
                }}
              </picture>
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'shop-cat__img shop-cat__placeholder' }}
            {%- endif -%}
          </div>

          <div class="shop-cat__panel js-sc-panel">
            <button
              type="button"
              class="shop-cat__toggle js-sc-toggle"
              aria-expanded="false"
              aria-controls="ShopCatBody-{{ block.id }}"
            >
              <span class="shop-cat__title">{{ card_title }}</span>
              <span class="shop-cat__icon" aria-hidden="true"></span>
            </button>

            <div class="shop-cat__body" id="ShopCatBody-{{ block.id }}">
              <div class="shop-cat__body-inner">
                <ul class="shop-cat__list">
                  {%- if use_list -%}
                    {%- for product in block.settings.products limit: 3 -%}
                      {%- render 'shop-cat-row', product: product -%}
                    {%- endfor -%}
                  {%- elsif col != blank -%}
                    {%- for product in col.products limit: 3 -%}
                      {%- render 'shop-cat-row', product: product -%}
                    {%- endfor -%}
                  {%- else -%}
                    <li class="shop-cat__empty">Pick a collection or products for this card.</li>
                  {%- endif -%}
                </ul>

                {%- if col != blank -%}
                  <a href="{{ card_link }}" class="shop-cat__shop">
                    <span>{{ link_label }}</span>
                    <svg width="6" height="10" viewBox="0 0 6 10" fill="none" aria-hidden="true"><path d="m1 1 4 4-4 4" stroke="currentColor" stroke-width="1.2"/></svg>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "tag": "div",
  "class": "section-shop-category",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Every time is created" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Drinkware. Simplified." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Scout wasn't made for a treadmill life. It's for the sunrise trail, the second pour</p>" },

    { "type": "header", "content": "Dropdown" },
    { "type": "color", "id": "panel_bg", "label": "Background", "default": "#B8CCD8" },
    { "type": "color", "id": "panel_text", "label": "Text", "default": "#0E1F2B" },
    { "type": "range", "id": "panel_top", "label": "Desktop position from top", "min": 20, "max": 100, "step": 1, "unit": "%", "default": 45, "info": "On mobile the bar sits at the bottom of the card." },

    { "type": "header", "content": "Desktop padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },

    { "type": "header", "content": "Mobile padding" },
    { "type": "range", "id": "padding_top_mobile", "label": "Top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection title." },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Used for the Shop link, and for products if none are picked below." },
        { "type": "product_list", "id": "products", "label": "Products in dropdown", "limit": 3 },
        { "type": "text", "id": "link_label", "label": "Link label", "info": "Leave empty for \"Shop\" + title." },
        { "type": "checkbox", "id": "open_default", "label": "Open on desktop when the page loads", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "card", "settings": { "title": "Hydration" } },
        { "type": "card", "settings": { "title": "Coffee", "open_default": true } },
        { "type": "card", "settings": { "title": "Barware" } },
        { "type": "card", "settings": { "title": "Artist Series" } }
      ]
    }
  ]
}
{% endschema %}
