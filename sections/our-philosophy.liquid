
{%- liquid
  assign section_padding_top = section.settings.padding_top
  assign section_padding_bottom = section.settings.padding_bottom
  assign section_bg = section.settings.background_color

  assign image = section.settings.image
  assign overlay_heading = section.settings.overlay_heading

  assign content_label = section.settings.content_label
  assign content_heading = section.settings.content_heading
  assign content_text = section.settings.content_text
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign blob_color = section.settings.blob_color
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pd-padding-top: {{ section_padding_top }}px;
    --pd-padding-bottom: {{ section_padding_bottom }}px;
    --pd-bg: {{ section_bg }};
    --pd-blob-color: {{ blob_color }};
  }

  #shopify-section-{{ section.id }} .philosophy-drinkware {
    padding-top: var(--pd-padding-top);
    padding-bottom: var(--pd-padding-bottom);
    background-color: var(--pd-bg);
  }
</style>

<div class="philosophy-drinkware">
    <div class="site-container">
  <div class="philosophy-drinkware__wrapper">

    <div class="philosophy-drinkware__image-col">
      <div class="philosophy-drinkware__image">
        {%- if image != blank -%}
          {{ image | image_url: width: 1500 | image_tag:
            loading: 'lazy',
            widths: '375, 750, 1100, 1500',
            alt: image.alt | default: overlay_heading,
            class: 'philosophy-drinkware__image-el'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'philosophy-drinkware__image-el philosophy-drinkware__image-el--placeholder' }}
        {%- endif -%}
      </div>

      <div class="philosophy-drinkware__overlay">
        {%- if overlay_heading != blank -%}
          <div class="philosophy-drinkware__overlay-heading">
            <p>{{ overlay_heading }}</p>
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="philosophy-drinkware__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'philosophy_item' -%}
                {%- liquid
                  assign item_number = block.settings.number
                  assign item_title = block.settings.title
                  assign item_text = block.settings.text
                -%}
                <div class="philosophy-drinkware__item" {{ block.shopify_attributes }}>
                  {%- if item_number != blank -%}
                    <div class="philosophy-drinkware__item-number">
                      <span>{{ item_number }}</span>
                    </div>
                  {%- endif -%}
                  <div class="philosophy-drinkware__item-content">
                    {%- if item_title != blank -%}
                      <div class="philosophy-drinkware__item-title">
                        <p>{{ item_title }}</p>
                      </div>
                    {%- endif -%}
                    {%- if item_text != blank -%}
                      <div class="philosophy-drinkware__item-text">
                        <p>{{ item_text }}</p>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="philosophy-drinkware__content-col">
      <div class="philosophy-drinkware__blob">
        <div class="philosophy-drinkware__blob-inner">
          {%- if content_heading != blank -%}
            <div class="philosophy-drinkware__heading">
              <h2>{{ content_heading }}</h2>
            </div>
          {%- endif -%}

          {%- if content_label != blank -%}
            <div class="philosophy-drinkware__label">
              <p>{{ content_label }}</p>
            </div>
          {%- endif -%}

          {%- if content_text != blank -%}
            <div class="philosophy-drinkware__description">
              {{ content_text }}
            </div>
          {%- endif -%}

          {%- if button_label != blank -%}
            <div class="philosophy-drinkware__button">
              <a href="{{ button_link }}">{{ button_label }}</a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

  </div>
</div>
</div>

<style>
  .philosophy-drinkware__wrapper {
    display: flex;
    flex-direction: column;
  }

  /* ---------- Image column ---------- */
  .philosophy-drinkware__image-col {
    position: relative;
    width: 100%;
  }

  .philosophy-drinkware__image {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .philosophy-drinkware__image-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .philosophy-drinkware__overlay {
    border-radius:24px;
    width:100%;
    max-width:100%;
    position: absolute;
    padding: 20px;
    left:16px;
    bottom:18px;
    right:16px;
    background: #0E1F2A26;
    
  }

  .philosophy-drinkware__overlay-heading p {
    margin: 0 0 20px;
    color: #ffffff;
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .philosophy-drinkware__list {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 320px;
  }

  .philosophy-drinkware__item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .philosophy-drinkware__item-number span {
    display: block;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    opacity: 0.75;
    min-width: 22px;
  }

  .philosophy-drinkware__item-title p {
    margin: 0 0 4px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .philosophy-drinkware__item-text p {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
    line-height: 1.5;
  }

  /* ---------- Content column ---------- */
  .philosophy-drinkware__content-col {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .philosophy-drinkware__blob {
    width: 100%;
    aspect-ratio: 1 / 0.9;
    max-height: 420px;
    background: linear-gradient(180deg, #B8CDD8 0%, rgba(246, 241, 236, 0) 100%);
    border-radius: 50% 50% 0 0 / 45% 45% 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 28px 0;
  }

  .philosophy-drinkware__blob-inner {
    max-width: 340px;
    text-align: center;
  }

  .philosophy-drinkware__heading h2 {
    margin: 0 0 18px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 26px;
    line-height: 1.25;
    font-weight: 400;
    color: #1a1a1a;
  }

  .philosophy-drinkware__label p {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #1a1a1a;
  }

  .philosophy-drinkware__description {
    margin: 0 0 24px;
    font-size: 13px;
    line-height: 1.6;
    color: #4a4a4a;
  }

  .philosophy-drinkware__description p {
    margin: 0;
  }

  .philosophy-drinkware__button a {
    display: inline-block;
    padding: 13px 32px;
    border: 1px solid #1a1a1a;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1a1a1a;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .philosophy-drinkware__button a:hover {
    background-color: #1a1a1a;
    color: #ffffff;
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 769px) {
    .philosophy-drinkware__wrapper {
      flex-direction: row;
      align-items: stretch;
      min-height: 600px;
    }

    .philosophy-drinkware__image-col {
      width: 50%;
    }

    .philosophy-drinkware__image {
      height: 100%;
      aspect-ratio: auto;
    }

    .philosophy-drinkware__overlay {
        max-width:417px;
        border-radius:36px;
      padding: 34px;
      backdrop-filter: blur(8px)

    }

    .philosophy-drinkware__overlay-heading p {
      font-size: 13px;
      margin-bottom: 28px;
    }

    .philosophy-drinkware__list {
      gap: 26px;
      max-width: 360px;
    }

    .philosophy-drinkware__content-col {
      width: 50%;
      align-items: center;
    }

    .philosophy-drinkware__blob {
      width: 90%;
      aspect-ratio: 1 / 1;
      max-height: none;
      border-radius: 50%;
      padding: 0 48px;
    }

    .philosophy-drinkware__blob-inner {
      max-width: 380px;
    }

    .philosophy-drinkware__heading h2 {
      font-size: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Our Philosophy",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "overlay_heading",
      "label": "Overlay heading",
      "default": "Our Philosophy"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "content_label",
      "label": "Label",
      "default": "About Created"
    },
    {
      "type": "text",
      "id": "content_heading",
      "label": "Heading",
      "default": "Drinkware, Thoughtfully Designed."
    },
    {
      "type": "richtext",
      "id": "content_text",
      "label": "Description",
      "default": "<p>At Created we believe drinkware should feel simple, intentional and built to last. Every vessel is designed by artists in California and made to be used every single day.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "blob_color",
      "label": "Blob background color",
      "default": "#d9e2e8"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "philosophy_item",
      "name": "Philosophy Item",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Design First"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Rooted in mid-century design, but built for now — drawn and refined by artists in California."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Philosophy",
      "blocks": [
        {
          "type": "philosophy_item",
          "settings": {
            "number": "01",
            "title": "Design First",
            "text": "Rooted in mid-century design, but built for now — drawn and refined by artists in California."
          }
        },
        {
          "type": "philosophy_item",
          "settings": {
            "number": "02",
            "title": "Quality Without Compromise",
            "text": "18/8 stainless steel, double-wall vacuum insulation and a lifetime hardware warranty."
          }
        },
        {
          "type": "philosophy_item",
          "settings": {
            "number": "03",
            "title": "One System, Endlessly Yours",
            "text": "Each Nomad lid is interchangeable with each Nomad base, so the cup changes as you do."
          }
        }
      ]
    }
  ]
}
{% endschema %}
