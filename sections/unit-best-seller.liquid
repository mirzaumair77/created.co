{% comment %}
  Section: Shop By — Bestsellers
  - Tabs = blocks (each tab has its own collection)
  - Each tab renders its own Flickity slider; arrows control the active tab
  - Card title:    product.metafields.product_cards.product_card_title (fallback: product.title)
  - Card subtitle: product.metafields.custom.product_type
  - "+ $price" pill = quick add to cart (first available variant)
{% endcomment %}

{{ 'shop-by-bestsellers.css' | asset_url | stylesheet_tag }}
 <script src="{{ 'shop-by-bestsellers.js' | asset_url }}" defer="defer"></script> 

{%- liquid
  assign tabs = section.blocks | where: 'type', 'tab'
-%}

<style>
  #ShopBy-{{ section.id }} {
    --sb-pad-top: {{ section.settings.padding_top }}px;
    --sb-pad-bottom: {{ section.settings.padding_bottom }}px;
    --sb-card-top: {{ section.settings.card_top_color }};
    --sb-card-bottom: {{ section.settings.card_bottom_color }};
    --sb-star: {{ section.settings.star_color }};
  }
</style>

<section id="ShopBy-{{ section.id }}" class="shop-by" data-section-id="{{ section.id }}">
  <div class="site-container">
    <div class="shop-by__head">
      <div class="shop-by__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="shop-by__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="shop-by__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="shop-by__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="shop-by__arrows">
        <button type="button" class="shop-by__arrow js-sb-prev" aria-label="Previous products" disabled>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="5"
            height="10"
            viewBox="0 0 5 10"
            fill="none"
            aria-hidden="true"
          >
            <path d="M4.78125 9.59375H3.15625L7.45058e-08 4.90625V4.75H1.78125L4.78125 9.59375ZM4.78125 -3.57628e-07L1.78125 4.84375H7.45058e-08V4.6875L3.15625 -3.57628e-07H4.78125Z" fill="currentColor"/>
          </svg>
        </button>
        <button type="button" class="shop-by__arrow js-sb-next" aria-label="Next products">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="5"
            height="10"
            viewBox="0 0 5 10"
            fill="none"
            aria-hidden="true"
          >
            <path d="M7.45058e-08 9.59375L3 4.75H4.78125V4.90625L1.625 9.59375H7.45058e-08ZM7.45058e-08 -3.57628e-07H1.625L4.78125 4.6875V4.84375H3L7.45058e-08 -3.57628e-07Z" fill="currentColor"/>
          </svg>
        </button>
      </div>
    </div>

    {%- if tabs.size > 1 -%}
      <div class="shop-by__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in tabs -%}
          <button
            type="button"
            role="tab"
            class="shop-by__tab js-sb-tab{% if forloop.first %} is-active{% endif %}"
            id="ShopByTab-{{ block.id }}"
            aria-controls="ShopByPanel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.label -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="site-container shop-by__panels" style="overflow: hidden">
    {%- for block in tabs -%}
      {%- assign tab_collection = block.settings.collection -%}
      <div
        class="shop-by__panel js-sb-panel{% if forloop.first %} is-active{% endif %}"
        id="ShopByPanel-{{ block.id }}"
        role="tabpanel"
        aria-labelledby="ShopByTab-{{ block.id }}"
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        <div class="shop-by__slider js-sb-slider">
          {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
            {%- for product in tab_collection.products limit: block.settings.limit -%}
              {%- liquid
                assign variant = product.selected_or_first_available_variant
                assign card_title = product.metafields.product_cards.product_card_title.value | default: product.title
                assign card_sub = product.metafields.custom.product_type.value
                assign rating = product.metafields.reviews.rating.value.rating
                assign rating_count = product.metafields.reviews.rating_count.value | default: 0
                assign rating_pct = 0
                if rating
                  assign rating_pct = rating | times: 1.0 | divided_by: 5 | times: 100
                endif
              -%}
              <div class="shop-by__cell">
                <div class="sb-card">
                  <h3 class="sb-card__title">
                    <a href="{{ product.url }}">{{ card_title }}</a>
                  </h3>

                  {%- if card_sub != blank -%}
                    <span class="sb-card__tag">{{ card_sub }}</span>
                  {%- else -%}
                    <span class="sb-card__tag sb-card__tag--empty" aria-hidden="true">&nbsp;</span>
                  {%- endif -%}

                  <a href="{{ product.url }}" class="sb-card__media" tabindex="-1" aria-hidden="true">
                    {%- if product.featured_media -%}
                      {{
                        product.featured_media
                        | image_url: width: 500
                        | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 45vw, 220px', alt: card_title
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </a>

                  {%- if section.settings.show_rating and rating -%}
                    <p class="sb-card__rating">
                      <span class="sb-card__stars" style="--rating: {{ rating_pct }}%;" aria-hidden="true"></span>
                      <span>{{ rating | round: 1 }}</span>
                      <span>({{ rating_count }})</span>
                      <span class="visually-hidden"
                        >Rated {{ rating | round: 1 }} out of 5 from {{ rating_count }} reviews</span
                      >
                    </p>
                  {%- endif -%}

                  <div class="sb-card__form">
                    <button
                      type="button"
                      class="sb-card__atc js-sb-atc"
                      data-variant-id="{{ variant.id }}"
                      aria-label="{% if variant.available %}Add {{ card_title | escape }} to cart{% else %}{{ card_title | escape }} – {{ 'products.product.sold_out' | t }}{% endif %}"
                      {% unless variant.available %}
                        disabled
                      {% endunless %}
                    >
                      <span class="sb-card__plus" aria-hidden="true">
                        <svg class="sb-icon-plus" width="11" height="11" viewBox="0 0 11 11" fill="none">
                          <path d="M5.5 0v11M0 5.5h11" stroke="currentColor" stroke-width="1.2"/>
                        </svg>
                        <svg class="sb-icon-check" width="12" height="10" viewBox="0 0 12 10" fill="none">
                          <path d="m1 5 3.5 3.5L11 1" stroke="currentColor" stroke-width="1.4"/>
                        </svg>
                        <loading-spinner
                          style="--bg-opacity:100%; --size:1rem; --loading-color:#0e1f2b;"
                        ></loading-spinner>
                      </span>
                      <span class="sb-card__price">
                        {%- if variant.available -%}
                          {{ variant.price | money_without_trailing_zeros }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                    </button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="shop-by__cell">
                <div class="sb-card">
                  <h3 class="sb-card__title">Product title</h3>
                  <span class="sb-card__tag">Type</span>
                  <div class="sb-card__media">{{ 'product-1' | placeholder_svg_tag }}</div>
                  <div class="sb-card__form">
                    <span class="sb-card__atc"
                      ><span class="sb-card__plus">+</span><span class="sb-card__price">$40</span></span
                    >
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <p class="visually-hidden js-sb-status" aria-live="polite"></p>
</section>

{% schema %}
{
  "name": "Shop by bestsellers",
  "tag": "div",
  "class": "section-shop-by",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers . ." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Scout wasn't made for a treadmill life. It's for the sunrise trail, the second pour, the studio session that runs long. Wherever the day takes you — take it with you.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true,
      "info": "Uses the standard reviews.rating and reviews.rating_count metafields."
    },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "card_top_color", "label": "Card gradient top", "default": "#BCCFDB" },
    { "type": "color", "id": "card_bottom_color", "label": "Card gradient bottom", "default": "#FFFFFF" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#E3560E" },

    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "All" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by bestsellers",
      "blocks": [
        { "type": "tab", "settings": { "label": "All" } },
        { "type": "tab", "settings": { "label": "Stainless" } },
        { "type": "tab", "settings": { "label": "Ceramic" } },
        { "type": "tab", "settings": { "label": "Glass" } }
      ]
    }
  ]
}
{% endschema %}
