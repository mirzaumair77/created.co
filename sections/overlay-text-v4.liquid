<style>
  
 .ot_{{ section.id }} .ot_heading {
    margin-bottom: 30px;
    font-family: canela, serif;
    line-height: normal;
    font-size: 50px;
    font-weight: 100;
    text-align: center;
}
 .ot_{{ section.id }} .overlay_area {
    position: relative;
}
 .ot_{{ section.id }} .overlay-text-area {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    
}
 .ot_{{ section.id }} .overlay_true{
    background: rgba(0, 0, 0, {{section.settings.opacity}}%);
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1; 
  }
 .ot_{{ section.id }} .ota_heading {
    font-family: grotesque, sans-serif;
    font-weight: 600;
    font-size: 100px;
    color: #fff;
}
.ot_{{ section.id }} .image_mb{
  display:none;
}
.ot_{{ section.id }}  img.overlay_image {
    max-width: 100%;
    width: 100%;
}


 
  @media(max-width:700px){
  .ot_{{ section.id }}  .ota_heading {
    font-size: 60px;
} 
.ot_{{ section.id }} .ot_heading {
   font-size: 40px;
 }  
 .ot_{{ section.id }} .image_dk{
  display:none;  
  } 
  .ot_{{ section.id }}  .image_mb{
  display:block;
}
  }
    @media(max-width:375px){
   .ot_{{ section.id }} .ota_heading {
    font-size: 35px;
} 
  }
</style>

<section class=" overlay-text ot_{{ section.id }}">
  <div class="overlay-main">
    {% if section.settings.main_heading != blank %}<h3 class="ot_heading">{{ section.settings.main_heading }}</h3>{% endif %}
    <!-- overlay area -->
    <div class="overlay_area">
      <!-- overlay image -->
      {% if  section.settings.image_dk != blank %}
        <div class="overlay-image-area image_dk">
          <img src="{{ section.settings.image_dk | image_url }}" class="overlay_image ">
        </div>
      {% endif %}
      {% if  section.settings.image_mb != blank %}
        <div class="overlay-image-area image_mb">
          <img src="{{ section.settings.image_mb | image_url }}" class="overlay_image ">
        </div>
      {% else %} 
        {% if  section.settings.image_dk != blank %}
        <div class="overlay-image-area image_mb">
          <img src="{{ section.settings.image_dk | image_url }}" class="overlay_image ">
        </div>
      {% endif %}
      {% endif %}

      
      <!-- overlay text -->
      {% if section.settings.heading != blank %}
      <div class="overlay-text-area {% if section.settings.show_overlay == true %} overlay_true {% endif %}">
        <h3 class="ota_heading">{{ section.settings.heading }}</h3>
      </div>
      {% endif %}  
    </div>
  </div>
</section>

{% schema %}
  {
  "name": "Overlay text v4",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Color Your World with Created"
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_dk",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mb",
      "label": "Mobile Image"
    },
    {
      "type": "header",
      "content": "Overlay Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lavender"
    },
   {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "show overlay",
      "default": false
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "Opacity overlay",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 10,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Overlay text v4"
    }
  ]
}  
{% endschema %}