<style>
.pursuit_description_{{ section.id }} {
  background-color: {{ section.settings.background_color }};
}

.pursuit_description_{{ section.id }} .pursuit_description_main .description p {
  color: {{ section.settings.description_color }};
}

@media only screen and (max-width: 768px) {
  
  .pursuit_description_{{ section.id }} {
    background-color: {{ section.settings.background_color_mobile }};
  }
}

.pursuit_description_section {
  padding: 88px 0;
}

.pursuit_description_section .page__width {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 1rem;
}
  
.pursuit_description_main .description p {
  font-weight: 400;
  line-height: 40px;
  font-size: 35px;
  text-align: center;
  margin: 0;
}
@media only screen and (max-width: 768px) {
  .pursuit_description_section {
    padding: 61px 0 11px;
  }
  .pursuit_description_main .description p {
    font-size: 24px;
  }
}
</style>

<div id="explore" class="pursuit_description_section pursuit_description_{{ section.id }}">
  <div class="page__width">
    <div class="pursuit_description_main">
      {% if section.settings.description != blank %}
      <div class="description font-canela">
        {{ section.settings.description }}
      </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Pursuit Description",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#F7F2EE"
      },
      {
        "type": "color",
        "id": "background_color_mobile",
        "label": "Background Color Mobile",
        "default": "#F7F2EE"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Description"
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "color",
        "id": "description_color",
        "label": "Description Color",
        "default": "#000000"
      }
    ],
    "presets": [
      {
        "name": "Pursuit Description"
      }
    ]
  }
{% endschema %}