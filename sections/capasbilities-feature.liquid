<style>
.capasbilities_{{ section.id }} {
  background-color: {{ section.settings.background_color }};
}

.capasbilities_section {
  padding: 78px 0px 100px;
  margin-top:88px;
}

.capasbilities_section .main_heading h2 {
  font-family: grotesque, sans-serif;
  color: #000000;
  font-size: 36px;
  line-height: normal;
  font-weight: 400;
  text-transform: uppercase;
  text-align: center;
}

.capasbilities_section .capasbilities_main {
  display: grid;
  grid-template-columns: repeat(2, 487px);
  justify-content: space-around;
  column-gap: 20px;
  row-gap: 52px;
  padding-top: 75px;
}

.capasbilities_main .capasbilities_list {
  display: flex;
  flex-direction: column;
  row-gap: 22px;
}

.capasbilities_list .icon_heading {
  display: grid;
  grid-template-columns: 48px 1fr;
  align-items: center;
  column-gap: 35px;
}

.icon_heading .icon img {
  display: flex;
  max-width: 100%;
}

.icon_heading .heading h4 {
  font-family: grotesque, sans-serif;
  color: #000000;
  font-size: 24px;
  line-height: normal;
  font-weight: 400;
  text-transform: uppercase;
}

.capasbilities_list .description p {
  font-family: grotesque, sans-serif;
  color: #000000;
  font-size: 18px;
  line-height: 1.5;
  font-weight: 400;
}

@media only screen and (max-width: 768px) {

  .capasbilities_section {
    padding: 68px 23px;
    margin-top:20px;
  }

  .capasbilities_section .main_heading h2 {
    font-size: 32px;
  }

  .capasbilities_section .capasbilities_main {
    grid-template-columns: 1fr;
    row-gap: 43px;
    padding-top: 68px;
  }
}
</style>

<div class="capasbilities_section capasbilities_{{ section.id }}">
  <div class="site-container">
    <div class="main_heading">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="capasbilities_main">
      {% for block in section.blocks %}
      <div class="capasbilities_list">
        {% if block.settings.icon != blank %}
        <div class="icon_heading">
          <div class="icon">
            <img src="{{ block.settings.icon | img_url:''  }}" alt="{{ shop.name }}">
          </div>
          {% if block.settings.heading != blank %}
          <div class="heading">
            <h4>{{ block.settings.heading }}</h4>
          </div>
          {% endif %}
        </div>
        {% endif %}
        {% if block.settings.description != blank %}
        <div class="description">
          {{ block.settings.description }}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Capasbilities Feature",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#F5F5F5"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      }
    ],
    "blocks": [
      {
        "type": "feature",
        "name": "Icon Text",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Select Icon"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "richtext",
            "id": "description",
            "label": "Description"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Capasbilities Feature"
      }
    ]
  }
{% endschema %}