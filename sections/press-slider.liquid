<style>
  .press_slide_inner {
    padding: 75px 0 32px 0;
}
 

  .press_heading {
    text-align: center;
    margin-bottom: 30px;
}
/* .slide_image_main {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
      justify-items: center;
} */
  .slide_image_main .flickity-slider{
        display: flex;
    align-items: flex-end;
  }
  
.slide_image_inner{
   max-width: 20%;
  width:100%;
}
.slide_image {
    max-width: 118px;
  width:100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
      border-bottom: 2px solid transparent;
}
.slide_image:hover {
    border-bottom: 2px solid #000;
}
  .slide_image_inner.is-selected .slide_image{
     border-bottom: 2px solid #000;
  }
.slide_image img {
    max-width: 100%;
    width: 100%;
}
  .slide_text {
    max-width: 100%;
    margin: 0 auto;
    padding:40px 100px;
    width: 100%;
}
  .slide_text p{
    font-size:16px;
font-weight:400;
line-height:22.4px;
    text-align:center;
    color:#000;
  }
  @media(max-width:769px){
    .slide_text {
    padding:40px 50px 0 50px;
}
  }
    @media(max-width:550px){
    .slide_text {
    padding:40px 40px 0px 40px;
}
      .slide_image_inner{
   max-width: 33.3%;
}
  }

</style>
<section class="press_section_{{ section.id }}">
<div class="press_slide_inner">
  <div class="site-container">
    <div class="press_slide_main">
      {% if section.settings.heading != blank %}<h3 class="press_heading  text-32 font-grotesque uppercase order-1 tablet:order-1">{{ section.settings.heading }}</h3>{% endif %}
      <div class="slide_image_main img_slider_ak">
       <carousel-component class="grid__item w-full mx-auto overflow-hidden" data-options='{"cellSelector":"[js-carousel-slide-text]", "wrapAround":true, "imagesLoaded":true, "prevNextButtons":false, "autoPlay":true, "adaptiveHeight":false, "pageDots":false}'>
        <div class="" js-carousel> 
      {% for block in section.blocks %}
      {% if block.settings.img_slide != blank %}  
      <div class="slide_image_inner" js-carousel-slide-text>  
        <div class="slide_image" >
          <img src="{{ block.settings.img_slide | img_url: "master" }}">
        </div>
      </div>  
      {% endif %}  
     {% endfor %}
     </div>  
       </carousel-component>   
     </div>  
      
      <div class="slide_text_main text_slider">
        <carousel-component class="grid__item w-full mx-auto overflow-hidden" data-options='{"cellSelector":"[js-carousel-slide-text]", "wrapAround":true, "imagesLoaded":true, "prevNextButtons":false, "autoPlay":true, "adaptiveHeight":false, "pageDots":false}'>
        <div class="" js-carousel>
        {% for block in section.blocks %}
        {% if block.settings.text_slide != blank %}  
        <div class="slide_text" js-carousel-slide-text>
          {{ block.settings.text_slide }}
        </div>
        {% endif %}  
        {% endfor %}  
        </div>  
       </carousel-component>
      </div>
       
    </div>
  </div>
</div>
</section>




{% schema %}
  {
    "name": "Press Slider",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      }
    ],
     "blocks": [
    {
      "name": "Slide",
      "type": "slide",
      "settings": [
         {
          "type": "image_picker",
          "id": "img_slide",
          "label": "Select Image"
        },
        {
          "type": "richtext",
          "id": "text_slide",
          "label": "Text"
        }

      ]
    },   
  ],
    "presets": [
      {
        "name": "Press Slider"
      }
    ]
  }
{% endschema %}