{%- liquid
  assign background = section.settings.background
  assign heading = section.settings.heading
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile

  assign shop_heading_highlight = section.settings.shop_heading_highlight
  assign shop_heading = section.settings.shop_heading
  assign shop_text = section.settings.shop_text
  assign shop_image_1 = section.settings.shop_image_1
  assign shop_image_2 = section.settings.shop_image_2
  assign shop_button_label = section.settings.shop_button_label
  assign shop_button_link = section.settings.shop_button_link
  assign shop_link_label = section.settings.shop_link_label
  assign shop_link = section.settings.shop_link

  assign custom_heading_highlight = section.settings.custom_heading_highlight
  assign custom_heading = section.settings.custom_heading
  assign custom_text = section.settings.custom_text
  assign custom_button_label = section.settings.custom_button_label
  assign custom_button_link = section.settings.custom_button_link

  assign shop_heading_plain = shop_heading_highlight | append: ' ' | append: shop_heading | strip
  assign shop_image_1_alt = shop_image_1.alt | default: shop_heading_plain
  assign shop_image_2_alt = shop_image_2.alt | default: shop_heading_plain
-%}

<style>
  #shopify-section-{{ section.id }} .live-inspired {
    --live-inspired-bg: {{ background }};
    --live-inspired-pt: {{ padding_top }}px;
    --live-inspired-pb: {{ padding_bottom }}px;
    --live-inspired-pt-mobile: {{ padding_top_mobile }}px;
    --live-inspired-pb-mobile: {{ padding_bottom_mobile }}px;
  }

  .live-inspired {
    padding-top: var(--live-inspired-pt-mobile);
    padding-bottom: var(--live-inspired-pb-mobile);
    background: var(--live-inspired-bg);
    color: #111;
  }

  .live-inspired__heading {
    padding: 0 20px 20px;
    text-align: center;
  }

  .live-inspired__heading h2 {
    margin: 0;
    font-family: var(--font-canela), var(--font-body-family);
    color: #000;
    font-size: 34px;
    line-height: 34px;
    letter-spacing: -0.68px;
    font-weight: 100;
  }

  .live-inspired__panel {
    padding: 28px;
    background: #F5F5F5;
    color: #000;
  }

  .live-inspired__panel--dark {
    background: #000;
    color: #fff;
  }

  .live-inspired__panel-heading {
    padding-block-end: 20px;
  }

  .live-inspired__panel-heading h3 {
    margin: 0;
    font-family: var(--font-canela), var(--font-body-family);
    color: inherit;
    font-size: 24px;
    line-height: 23.845px;
    letter-spacing: -0.24px;
    font-weight: 100;
  }

  .live-inspired__panel-heading strong {
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    font-size: 21.677px;
    line-height: 23.845px;
    letter-spacing: -0.65px;
    font-weight: 700;
  }

  .live-inspired__products {
    display: none;
  }

  .live-inspired__panel-text {
    padding-block-end: 20px;
  }

  .live-inspired__panel-text p {
    margin: 0;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #6E797F;
    font-size: 15px;
    line-height: 22.5px;
    font-weight: 400;
  }

  .live-inspired__panel--dark .live-inspired__panel-text p {
    color: #ffffffbf;
  }

  .live-inspired__panel-text a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .live-inspired__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .live-inspired__button a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    border: 1px solid #000;
    border-radius: 999px;
    background: #000;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #FFF;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 0.14px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .live-inspired__button a:hover {
    background: #2b2b2b;
  }

  .live-inspired__button--outline a {
    border-color: #fff;
    background: none;
    color: #fff;
  }

  .live-inspired__button--outline a:hover {
    background: #fff;
    color: #000;
  }

  .live-inspired__link a {
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #000;
    font-size: 14px;
    line-height: normal;
    font-weight: 700;
    text-underline-position: from-font;
    text-decoration: underline;
  }

  .live-inspired__link a:hover {
    text-decoration-thickness: 2px;
  }

  .live-inspired__button a:focus-visible,
  .live-inspired__link a:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
  }

  .live-inspired__panel--dark .live-inspired__button a:focus-visible {
    outline-color: #fff;
  }

  @media (min-width: 769px) {
    .live-inspired {
      padding-top: var(--live-inspired-pt);
      padding-bottom: var(--live-inspired-pb);
    }

    .live-inspired__heading {
      padding-bottom: 48px;
    }

    .live-inspired__heading h2 {
      font-size: 51px;
      line-height: 51px;
      letter-spacing: -1.02px;
      font-weight: 300;
    }

    .live-inspired__panels {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .live-inspired__panel {
      display: flex;
      align-items: center;
      padding: 64px clamp(36px, 8vw, 100px);
    }

    .live-inspired__panel-content {
      width: 100%;
      max-width: 540px;
    }

    .live-inspired__panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      margin-bottom: 16px;
    }

    .live-inspired__panel-heading {
      padding-block-end: 20px;
    }
    
    .live-inspired__panel-header .live-inspired__panel-heading {
      padding-block-end: 0px;
    }

    .live-inspired__panel-heading h3 {
      font-size: 28.9px;
      letter-spacing: -0.32px;
      font-weight: 300;
    }

    .live-inspired__panel-heading strong {
      font-size: 28.903px;
      line-height: 31.794px;
      letter-spacing: -0.867px; 
      font-weight: 500;
    }

    .live-inspired__products {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: 8px;
    }

    .live-inspired__product {
      width: 64px;
      height: 80px;
      overflow: hidden;
      border-radius: 6px;
    }

    .live-inspired__product img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .live-inspired__panel-text {
      max-width: 540px;
    }

    .live-inspired__panel--dark .live-inspired__panel-text p {
      font-size: 16px;
      line-height: 24px;
    }

    .live-inspired__button a,
    .live-inspired__link a {
      font-weight: 500;
    }
  }
</style>

<section class="live-inspired">
  {%- if heading != blank -%}
    <div class="live-inspired__heading">
      <h2>{{ heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="live-inspired__panels">
    <div class="live-inspired__panel">
      <div class="live-inspired__panel-content">
        <div class="live-inspired__panel-header">
          {%- if shop_heading_highlight != blank or shop_heading != blank -%}
            <div class="live-inspired__panel-heading">
              <h3>
                {%- if shop_heading_highlight != blank -%}
                  <strong>{{ shop_heading_highlight | escape }}</strong>
                  {%- if shop_heading != blank %}<br>{% endif -%}
                {%- endif -%}
                {{- shop_heading | escape -}}
              </h3>
            </div>
          {%- endif -%}

          {%- if shop_image_1 != blank or shop_image_2 != blank -%}
            <div class="live-inspired__products">
              {%- if shop_image_1 != blank -%}
                <div class="live-inspired__product">
                  {{
                    shop_image_1
                    | image_url: width: 200
                    | image_tag:
                      loading: 'lazy',
                      widths: '100, 200',
                      sizes: '64px',
                      alt: shop_image_1_alt
                  }}
                </div>
              {%- endif -%}

              {%- if shop_image_2 != blank -%}
                <div class="live-inspired__product">
                  {{
                    shop_image_2
                    | image_url: width: 200
                    | image_tag:
                      loading: 'lazy',
                      widths: '100, 200',
                      sizes: '64px',
                      alt: shop_image_2_alt
                  }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if shop_text != blank -%}
          <div class="live-inspired__panel-text">
            <p>{{ shop_text }}</p>
          </div>
        {%- endif -%}

        {%- if shop_button_label != blank or shop_link_label != blank -%}
          <div class="live-inspired__actions">
            {%- if shop_button_label != blank -%}
              <div class="live-inspired__button">
                <a {% if shop_button_link != blank %}href="{{ shop_button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                  {{- shop_button_label | escape -}}
                </a>
              </div>
            {%- endif -%}

            {%- if shop_link_label != blank -%}
              <div class="live-inspired__link">
                <a {% if shop_link != blank %}href="{{ shop_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                  {{- shop_link_label | escape -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="live-inspired__panel live-inspired__panel--dark">
      <div class="live-inspired__panel-content">
        {%- if custom_heading_highlight != blank or custom_heading != blank -%}
          <div class="live-inspired__panel-heading">
            <h3>
              {%- if custom_heading_highlight != blank -%}
                <strong>{{ custom_heading_highlight | escape }}</strong>
                {%- if custom_heading != blank %}<br>{% endif -%}
              {%- endif -%}
              {{- custom_heading | escape -}}
            </h3>
          </div>
        {%- endif -%}

        {%- if custom_text != blank -%}
          <div class="live-inspired__panel-text">
            <p>{{ custom_text }}</p>
          </div>
        {%- endif -%}

        {%- if custom_button_label != blank -%}
          <div class="live-inspired__actions">
            <div class="live-inspired__button live-inspired__button--outline">
              <a {% if custom_button_link != blank %}href="{{ custom_button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                {{- custom_button_label | escape -}}
              </a>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Live inspired",
  "tag": "div",
  "class": "section-live-inspired",
  "settings": [
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Live inspired."
    },
    {
      "type": "header",
      "content": "Left panel"
    },
    {
      "type": "text",
      "id": "shop_heading_highlight",
      "label": "Heading first line",
      "default": "Find your",
      "info": "Shown in bold sans-serif."
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Heading second line",
      "default": "everyday cup.",
      "info": "Shown in serif."
    },
    {
      "type": "inline_richtext",
      "id": "shop_text",
      "label": "Text",
      "default": "Tumblers, mugs, and bottles built to go everywhere you do."
    },
    {
      "type": "image_picker",
      "id": "shop_image_1",
      "label": "Product image 1",
      "info": "Desktop only. Use a cut-out product image."
    },
    {
      "type": "image_picker",
      "id": "shop_image_2",
      "label": "Product image 2",
      "info": "Desktop only. Use a cut-out product image."
    },
    {
      "type": "text",
      "id": "shop_button_label",
      "label": "Button label",
      "default": "Shop best sellers"
    },
    {
      "type": "url",
      "id": "shop_button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "shop_link_label",
      "label": "Text link label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Text link"
    },
    {
      "type": "header",
      "content": "Right panel"
    },
    {
      "type": "text",
      "id": "custom_heading_highlight",
      "label": "Heading first line",
      "default": "Make something",
      "info": "Shown in bold sans-serif."
    },
    {
      "type": "text",
      "id": "custom_heading",
      "label": "Heading second line",
      "default": "fully you.",
      "info": "Shown in serif."
    },
    {
      "type": "inline_richtext",
      "id": "custom_text",
      "label": "Text",
      "default": "Custom drinkware for your cafe, your team, or your next drop. We handle sourcing, materials, and production."
    },
    {
      "type": "text",
      "id": "custom_button_label",
      "label": "Button label",
      "default": "Start a custom order"
    },
    {
      "type": "url",
      "id": "custom_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Live inspired"
    }
  ]
}
{% endschema %}
