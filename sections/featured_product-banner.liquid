<style>
  .featured_product_banner.banner__section_{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }

  .featured_product_banner.banner__section_{{ section.id }} .banner_content .subheading h4 {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
  }

  .featured_product_banner.banner__section_{{ section.id }} .banner_content .heading h2 {
    font-size: {{section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
  }

  .featured_product_banner.banner__section_{{ section.id }} .banner_content .description p {
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
  }

  @media only screen and (max-width: 500px) {
  .featured_product_banner.banner__section_{{ section.id }} .banner_content .subheading h4 {
    font-size: {{ section.settings.subheading_size_mb }}px;
  }

  .featured_product_banner.banner__section_{{ section.id }} .banner_content .heading h2 {
    font-size: {{section.settings.heading_size_mb }}px;
  }

  .featured_product_banner.banner__section_{{ section.id }} .banner_content .description p {
    font-size: {{ section.settings.description_size_mb }}px;
  }
  }

  .featured_product_banner {
    padding: 80px 16px 50px;
  }
  
  .featured_product_banner .container {
    max-width: 1080px;
    margin: 0 auto;
  }

  .featured_product_banner .banner_content .subheading h4 {
    font-weight: 600;
    font-style: normal;
    line-height: normal;
    padding-bottom: 16px;
  }

  .featured_product_banner .banner_content .heading h2 {
    font-family: canela, serif;
    font-style: normal;
    text-align: center;
    line-height: normal;
  }

  .featured_product_banner .banner_content .description p {
    font-family: grotesque, sans-serif;
    font-weight: 400;
    line-height: normal;
    padding-top: 16px;
  }
@media only screen and (max-width: 767px) {
.featured_product_banner {
    padding-top: 50px;
}
}  
</style>

<div class="featured_product_banner banner__section_{{ section.id }}">
  <div class="container">
    <div class="banner_content">
      {% if section.settings.subheading != blank %}
        <div class="subheading">
          <h4>{{ section.settings.subheading }}</h4>
        </div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <div class="heading">
          <h2 class="font-thin">{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Product Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subheading_size_mb",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 45
    },
    {
      "type": "range",
      "id": "heading_size_mb",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size Mobile",
      "default": 32
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 0,
      "max": 42,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "description_size_mb",
      "min": 0,
      "max": 42,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size Mobile",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Featured Product Banner"
    }
  ]
}
{% endschema %}
