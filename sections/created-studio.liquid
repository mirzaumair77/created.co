{{ 'created-studio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'created-studio.js' | asset_url }}" defer="defer"></script>

{% style %}
  #CreatedStudio-{{ section.id }} {
    --created-studio-bg-color: {{ section.settings.color_background }}px;
    --created-studio-top: {{ section.settings.padding_top }}px;
    --created-studio-bottom: {{ section.settings.padding_bottom }}px;
    --created-studio-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --created-studio-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  }



  #CreatedStudio-{{ section.id }} {
    padding: var(--created-studio-top-mobile) 0 var(--created-studio-bottom-mobile);
    background: var(--created-studio-bg-color);
  }

    @media screen and (min-width: 768px) {
     #CreatedStudio-{{ section.id }} {
      padding-top: var(--created-studio-top);
      padding-bottom: var(--created-studio-bottom);
    }

}

{% endstyle %}




<div id="CreatedStudio-{{ section.id }}" class="created-studio">
  {%- if section.settings.subtitle != blank or section.settings.heading != blank -%}
    <div class="created-studio__header">
      {%- if section.settings.subtitle != blank -%}
        <div class="created-studio__subtitle"><p>{{ section.settings.subtitle | escape }}</p></div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <div class="created-studio__heading"><h2>{{ section.settings.heading | escape }}</h2></div>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="created-studio__track">
      <div class="created-studio__slider" role="region" aria-label="{{ section.settings.heading | default: section.settings.subtitle | default: section.type | escape }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign desktop_image = block.settings.image_desktop | default: block.settings.image_mobile
            assign mobile_image = block.settings.image_mobile
            assign title = block.settings.title
            assign description = block.settings.description
            assign image_alt = desktop_image.alt | default: title
          -%}
          <div class="created-studio__card" {{ block.shopify_attributes }}>
            <div class="created-studio__image">
              {%- if desktop_image != blank -%}
                <picture>
                  {%- if mobile_image != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 280 }} 280w, {{ mobile_image | image_url: width: 560 }} 560w, {{ mobile_image | image_url: width: 840 }} 840w" sizes="70.89vw">
                  {%- endif -%}
                  {{ desktop_image | image_url: width: 1386 | image_tag: widths: '280, 355, 462, 710, 924, 1386', sizes: '(min-width: 750px) 32.09vw, 70.89vw', height: nil, loading: 'lazy', alt: image_alt }}
                </picture>
              {%- endif -%}
            </div>
            <div class="created-studio__text">
              {%- if title != blank -%}
                <div class="created-studio__title"><h3>{{ title | escape }}</h3></div>
              {%- endif -%}
              {%- if description != blank -%}
                <div class="created-studio__description">{{ description }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Created Studio",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Journals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Created Studio"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 53
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Created Studio",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "Designed by artists",
            "description": "<p>Each release is drawn and refined in California.</p>"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Built for daily use",
            "description": "<p>18/8 stainless steel with double-wall vacuum insulation.</p>"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Pure flavour, every time",
            "description": "<p>Ceramic interiors keep the taste of your drink unchanged.</p>"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Cove glassware",
            "description": "<p>Clear, simple forms for the table and the bar.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}


