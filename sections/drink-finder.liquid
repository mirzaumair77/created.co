<div
  class="drink-finder"
  id="drink-finder-{{ section.id }}"
  data-drink-finder
  data-height="{{ section_height }}"
  data-mobile-height="{{ mobile_section_height }}"
  data-autoplay="{{ autoplay }}"
  data-autoplay-speed="{{ autoplay_speed }}"
>
  {%- if bg_image -%}
    <div class="drink-finder__background">
      {{
        bg_image
        | image_url: width: 2550
        | image_tag:
          class: 'drink-finder__background-image mobile-hide',
          loading: 'lazy',
          widths: '750, 1200, 1920, 2550',
          sizes: '100vw'
      }}
      {{
        bg_image_mobile
        | image_url: width: 1200
        | image_tag:
          class: 'drink-finder__background-image desktop-hide',
          loading: 'lazy',
          widths: '375, 550, 750, 1200',
          sizes: '100vw'
      }}
      {%- if overlay == true -%}
        <div class="drink-finder__overlay"></div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="drink-finder__container">
    {%- if eyebrow_text != blank or heading != blank -%}
      <div class="drink-finder__header">
        {%- if eyebrow_text != blank -%}
          <div class="drink-finder__eyebrow">
            <span>{{ eyebrow_text }}</span>
          </div>
        {%- endif -%}
        {%- if heading != blank -%}
          <div class="drink-finder__heading">
            <h2>{{ heading }}</h2>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="drink-finder__finder">
      <div class="drink-finder__search-bar">
        <div class="drink-finder__search-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
            <path d="M10.01 16.72C11.7896 16.72 13.4963 16.0131 14.7547 14.7547C16.013 13.4964 16.72 11.7897 16.72 10.01C16.72 8.23045 16.013 6.52373 14.7547 5.26536C13.4963 4.00699 11.7896 3.30005 10.01 3.30005C8.23039 3.30005 6.52367 4.00699 5.2653 5.26536C4.00693 6.52373 3.29999 8.23045 3.29999 10.01C3.29999 11.7897 4.00693 13.4964 5.2653 14.7547C6.52367 16.0131 8.23039 16.72 10.01 16.72Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18.26 18.26L14.74 14.74" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <label class="visually-hidden" for="drink-finder-search-{{ section.id }}">
          {{- search_placeholder | default: 'Search' | escape -}}
        </label>
        <textarea
          class="drink-finder__search-input"
          id="drink-finder-search-{{ section.id }}"
          rows="1"
          placeholder="{{ active_placeholder | escape }}"
          data-default-placeholder="{{ search_placeholder | escape }}"
          data-typing-phrases="{{ typing_phrases | escape }}"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          data-drink-finder-input
        ></textarea>
        <button class="drink-finder__search-submit" type="button" aria-label="Search" data-drink-finder-submit>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4.19995 10H15.2" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M11.2 6L15.2 10L11.2 14" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div
          class="drink-finder__pills"
          role="group"
          aria-label="Quick filters"
          data-drink-finder-pills
          {% unless active_pill_found %}hidden{% endunless %}
        >
          {{ pills_markup }}
        </div>
      {%- endif -%}
    </div>

    <div class="drink-finder__results" data-drink-finder-results hidden>
      <button
        class="drink-finder__results-arrow drink-finder__results-arrow--prev"
        type="button"
        aria-label="Previous products"
        data-drink-finder-prev
        disabled
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3.5L5.5 8L10 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="drink-finder__results-list">
        <div class="drink-finder__results-track" data-drink-finder-track></div>
      </div>
      <button
        class="drink-finder__results-arrow drink-finder__results-arrow--next"
        type="button"
        aria-label="Next products"
        data-drink-finder-next
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 3.5L10.5 8L6 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <p class="drink-finder__results-empty" data-drink-finder-empty hidden>{{ empty_text | escape }}</p>
    <p class="visually-hidden" data-drink-finder-status aria-live="polite"></p>

    <div class="drink-finder__pick" data-drink-finder-pick hidden>
      <div class="drink-finder__pick-icon" data-drink-finder-pick-icon></div>
      <div class="drink-finder__pick-info">
        <div class="drink-finder__pick-label">
          <span>{{ pick_label | escape }}</span>
        </div>
        <div class="drink-finder__pick-product">
          <span data-drink-finder-pick-product></span>
        </div>
      </div>
      <div class="drink-finder__pick-button">
        <a href="#" data-drink-finder-pick-button>
          <span class="drink-finder__pick-button-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M9.9998 3.40039L11.4498 7.15039L15.1998 8.60039L11.4498 10.0504L9.9998 13.8004L8.5498 10.0504L4.7998 8.60039L8.5498 7.15039L9.9998 3.40039Z" stroke="white" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M15.3001 13.0996L15.9201 14.6996L17.5201 15.3196L15.9201 15.9396L15.3001 17.5396L14.6801 15.9396L13.0801 15.3196L14.6801 14.6996L15.3001 13.0996Z" stroke="white" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="drink-finder__pick-button-text">{{ pick_button_label | escape }}</span>
        </a>
      </div>
    </div>
  </div>

  {%- comment -%}
    paginate lifts the default 50 product limit of collection.products to 250.
  {%- endcomment -%}
  <script type="application/json" data-drink-finder-products>
    [
      {%- paginate source_collection.products by 250 -%}
        {%- for product in source_collection.products -%}
          {%- assign df_keywords = product.metafields.custom.search_keywords.value -%}
          {
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "image": {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 160 | json }}{%- else -%}""{%- endif -%},
            "price": {{ product.price | money_without_trailing_zeros | strip_html | json }},
            "type": {{ product.type | json }},
            "text": {{ product.description | strip_html | strip_newlines | json }},
            "keywords": {%- if df_keywords != blank -%}{{ df_keywords | json }}{%- else -%}[]{%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- endpaginate -%}
    ]
  </script>
</div>

<script>
  (function () {
    // Field order = ranking. Any score > 0 means the product is shown.
    var FIELDS = ['keywords', 'title', 'type', 'text'];
    var FIELD_WEIGHTS = { keywords: 4, title: 3, type: 2, text: 1 };
    var STOPWORDS = toSet(
      'a all an and any are at be but by can do for from get have i im in is it its just keep keeps like looking me my need of on or please should so some something that the this to want which with you your'.split(
        ' '
      )
    );
    var BOUNDARY = (function () {
      try {
        new RegExp('[^\\p{L}\\p{N}]', 'u');
        return { cls: '[^\\p{L}\\p{N}]', flags: 'u' };
      } catch (e) {
        return { cls: '[^a-z0-9\\u00c0-\\u024f]', flags: '' };
      }
    })();

    // Typing placeholder timing (ms).
    var TYPE_MS = 55;
    var DELETE_MS = 25;
    var HOLD_MS = 1800;
    var NEXT_MS = 400;

    function toSet(list) {
      var set = {};
      list.forEach(function (word) {
        set[word] = true;
      });
      return set;
    }

    function normalize(value) {
      var str = String(value == null ? '' : value).toLowerCase();
      if (str.normalize) str = str.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      return str.replace(/\s+/g, ' ').trim();
    }

    function valueList(value) {
      if (Array.isArray(value)) return value;
      if (value == null || value === '') return [];
      return [value];
    }

    function escapeRegExp(str) {
      return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // Matches at a word start ("tumb" finds "tumbler", "ice" does not find "price").
    // wholeWord: exact word only (used by the quick filter pills).
    function termRegExp(term, wholeWord) {
      return new RegExp(
        '(?:^|' + BOUNDARY.cls + ')' + escapeRegExp(term) + (wholeWord ? '(?=$|' + BOUNDARY.cls + ')' : ''),
        BOUNDARY.flags
      );
    }

    function tokenize(query) {
      return query.split(new RegExp(BOUNDARY.cls + '+', BOUNDARY.flags)).filter(function (token) {
        return token.length > 1 && !STOPWORDS[token];
      });
    }

    function fieldScore(index, re) {
      var score = 0;
      for (var i = 0; i < FIELDS.length; i++) {
        if (re.test(index[FIELDS[i]])) score += FIELD_WEIGHTS[FIELDS[i]];
      }
      return score;
    }

    // Free text: full phrase first, then single meaningful words
    // ("I need something that keeps ice all day" -> "ice", "day").
    function searchMatcher(rawQuery) {
      var query = normalize(rawQuery);
      if (!query) return null;
      var phrase = termRegExp(query, false);
      var tokens = tokenize(query);
      var useTokens = tokens.length > 1 || (tokens.length === 1 && tokens[0] !== query);
      var tokenRes = useTokens
        ? tokens.map(function (token) {
            return termRegExp(token, false);
          })
        : [];
      return function (index) {
        var score = fieldScore(index, phrase) * 10;
        for (var i = 0; i < tokenRes.length; i++) score += fieldScore(index, tokenRes[i]);
        return score;
      };
    }

    function splitTerms(rawTerms) {
      return String(rawTerms || '')
        .split(',')
        .map(normalize)
        .filter(Boolean);
    }

    // Pill: comma separated terms, whole word match in any of the 4 fields.
    function pillMatcher(terms) {
      var res = terms.map(function (term) {
        return termRegExp(term, true);
      });
      if (!res.length) return null;
      return function (index) {
        var score = 0;
        for (var i = 0; i < res.length; i++) score += fieldScore(index, res[i]);
        return score;
      };
    }

    function initDrinkFinder(root) {
      if (!root || root.getAttribute('data-drink-finder-ready') === 'true') return;
      root.setAttribute('data-drink-finder-ready', 'true');

      var dataScript = root.querySelector('[data-drink-finder-products]');
      var input = root.querySelector('[data-drink-finder-input]');
      var submit = root.querySelector('[data-drink-finder-submit]');
      var pills = Array.prototype.slice.call(root.querySelectorAll('[data-drink-finder-pill]'));
      var resultsWrap = root.querySelector('[data-drink-finder-results]');
      var track = root.querySelector('[data-drink-finder-track]');
      var prevBtn = root.querySelector('[data-drink-finder-prev]');
      var nextBtn = root.querySelector('[data-drink-finder-next]');
      var emptyEl = root.querySelector('[data-drink-finder-empty]');
      var statusEl = root.querySelector('[data-drink-finder-status]');
      var pickWrap = root.querySelector('[data-drink-finder-pick]');
      var pickIcon = root.querySelector('[data-drink-finder-pick-icon]');
      var pickProduct = root.querySelector('[data-drink-finder-pick-product]');
      var pickButton = root.querySelector('[data-drink-finder-pick-button]');
      var pillsWrap = root.querySelector('[data-drink-finder-pills]');
      var reduceMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

      var products = [];
      try {
        products = JSON.parse(dataScript ? dataScript.textContent : '[]');
      } catch (e) {
        products = [];
      }
      if (!Array.isArray(products)) products = [];

      var catalog = products.map(function (product, order) {
        return {
          product: product,
          order: order,
          index: {
            keywords: valueList(product.keywords).map(normalize).join(' | '),
            title: normalize(product.title),
            type: normalize(product.type),
            text: normalize(product.text),
          },
        };
      });

      // Per pill: its filter (which products belong to the tab) and its words (to recognise it in a search).
      var pillData = pills.map(function (pill) {
        var terms = splitTerms(pill.getAttribute('data-filter-tag'));
        var labelEl = pill.querySelector('.drink-finder__pill-label');
        var labelWords = tokenize(normalize(labelEl ? labelEl.textContent : ''));
        var words = tokenize(terms.join(' ')).concat(labelWords);
        return {
          el: pill,
          scorer: terms.length ? pillMatcher(terms) : null,
          termRes: terms.map(function (term) {
            return termRegExp(term, true);
          }),
          labelRes: labelWords.map(function (word) {
            return termRegExp(word, true);
          }),
          words: words,
        };
      });

      var defaultPlaceholder = input.getAttribute('data-default-placeholder') || input.getAttribute('placeholder') || '';
      var activePill = null;
      var matches = [];
      var debounceId = null;
      var arrowFrame = null;
      var sizer = null;
      var desktopMq = null;
      var inView = true;
      var inputFocused = false;

      // ---------- Typing placeholder ----------
      var typingPhrases = String(input.getAttribute('data-typing-phrases') || '')
        .split(/\r?\n/)
        .map(function (line) {
          return line.trim();
        })
        .filter(Boolean);
      var longestPhrase = typingPhrases.reduce(function (longest, phrase) {
        return phrase.length > longest.length ? phrase : longest;
      }, '');
      var typing = { timer: null, running: false, phrase: 0, chars: 0, deleting: false };

      function setPlaceholder(text) {
        if (input.getAttribute('placeholder') !== text) input.setAttribute('placeholder', text);
      }

      function canType() {
        return (
          typingPhrases.length > 0 &&
          !reduceMotion &&
          !activePill &&
          !input.value &&
          !inputFocused &&
          inView &&
          !document.hidden
        );
      }

      function stopTyping() {
        window.clearTimeout(typing.timer);
        typing.timer = null;
        typing.running = false;
      }

      function typeTick() {
        if (!canType()) {
          stopTyping();
          refreshPlaceholder();
          return;
        }
        var phrase = typingPhrases[typing.phrase];
        if (!typing.deleting) {
          typing.chars += 1;
          setPlaceholder(phrase.slice(0, typing.chars));
          if (typing.chars >= phrase.length) {
            typing.deleting = true;
            typing.timer = window.setTimeout(typeTick, HOLD_MS);
          } else {
            typing.timer = window.setTimeout(typeTick, TYPE_MS);
          }
        } else {
          typing.chars -= 1;
          setPlaceholder(phrase.slice(0, Math.max(0, typing.chars)));
          if (typing.chars <= 0) {
            typing.deleting = false;
            typing.chars = 0;
            typing.phrase = (typing.phrase + 1) % typingPhrases.length;
            typing.timer = window.setTimeout(typeTick, NEXT_MS);
          } else {
            typing.timer = window.setTimeout(typeTick, DELETE_MS);
          }
        }
      }

      // Placeholder priority: active tab sentence > typing phrases > static placeholder.
      function refreshPlaceholder() {
        if (activePill) {
          stopTyping();
          setPlaceholder(activePill.getAttribute('data-search-text') || defaultPlaceholder);
        } else if (!typingPhrases.length) {
          setPlaceholder(defaultPlaceholder);
        } else if (canType()) {
          if (!typing.running) {
            typing.running = true;
            typing.chars = 0;
            typing.deleting = false;
            setPlaceholder('');
            typing.timer = window.setTimeout(typeTick, NEXT_MS);
          }
          return;
        } else {
          // Paused (focused, off screen, reduced motion): show the current phrase in full.
          stopTyping();
          setPlaceholder(typingPhrases[typing.phrase]);
        }
        if (!input.value) fitInput();
      }

      function dataFor(pill) {
        for (var i = 0; i < pillData.length; i++) {
          if (pillData[i].el === pill) return pillData[i];
        }
        return null;
      }

      // Active tab -> "I need something that keeps [filter]" in the search field.
      function setActivePill(pill) {
        activePill = pill || null;
        pills.forEach(function (item) {
          var on = item === activePill;
          item.classList.toggle('drink-finder__pill--active', on);
          item.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        refreshPlaceholder();
        syncPills();
      }

      // Filters stay hidden until the customer types; they stay visible while a filter is selected.
      function syncPills() {
        if (!pillsWrap) return;
        var show = !!normalize(input.value) || !!activePill;
        if (pillsWrap.hidden === !show) return;
        pillsWrap.hidden = !show;
      }

      // How strongly a search names a tab: filter term (3), label word (2), typed start of a word (1).
      function directPillScore(data, query, tokens) {
        var score = 0;
        var i;
        for (i = 0; i < data.termRes.length; i++) {
          if (data.termRes[i].test(query)) score += 3;
        }
        for (i = 0; i < data.labelRes.length; i++) {
          if (data.labelRes[i].test(query)) score += 2;
        }
        for (i = 0; i < tokens.length; i++) {
          for (var j = 0; j < data.words.length; j++) {
            if (data.words[j].indexOf(tokens[i]) === 0) {
              score += 1;
              break;
            }
          }
        }
        return score;
      }

      // Best score wins, on a tie the current tab stays.
      function choosePill(candidates) {
        if (!candidates.length) return null;
        var best = 0;
        candidates.forEach(function (c) {
          if (c.score > best) best = c.score;
        });
        var top = candidates.filter(function (c) {
          return c.score === best;
        });
        for (var i = 0; i < top.length; i++) {
          if (top[i].data.el === activePill) return activePill;
        }
        return top[0].data.el;
      }

      // Search -> tab: 1) the text names a tab, 2) else the tab that contains the top result, 3) else none.
      function resolvePill(rawQuery, topEntry) {
        var query = normalize(rawQuery);
        var tokens = tokenize(query);
        var named = [];
        pillData.forEach(function (data) {
          var score = directPillScore(data, query, tokens);
          if (score > 0) named.push({ data: data, score: score });
        });
        if (named.length) return choosePill(named);
        if (!topEntry) return null;
        var containing = [];
        pillData.forEach(function (data) {
          if (data.scorer && data.scorer(topEntry.index) > 0) containing.push({ data: data, score: 1 });
        });
        return choosePill(containing);
      }

      // ---------- Autoplay ----------
      var autoplayOn = root.getAttribute('data-autoplay') === 'true';
      var autoplayMs = Math.max(2, parseFloat(root.getAttribute('data-autoplay-speed')) || 5) * 1000;
      var autoplayTimer = null;
      var hoverPause = false;
      var focusPause = false;

      function canAutoplay() {
        return (
          autoplayOn &&
          !reduceMotion &&
          !resultsWrap.hidden &&
          track.scrollWidth - track.clientWidth > 2 &&
          !hoverPause &&
          !focusPause &&
          inView &&
          !document.hidden
        );
      }

      function stopAutoplay() {
        window.clearTimeout(autoplayTimer);
        autoplayTimer = null;
      }

      // (Re)starts the countdown, so a manual slide or swipe gets the full interval.
      function scheduleAutoplay() {
        stopAutoplay();
        if (!canAutoplay()) return;
        autoplayTimer = window.setTimeout(function () {
          autoplayTimer = null;
          if (!canAutoplay()) return;
          var max = track.scrollWidth - track.clientWidth;
          if (track.scrollLeft >= max - 2) {
            scrollToStart();
          } else {
            slide(1);
          }
          scheduleAutoplay();
        }, autoplayMs);
      }

      function hideAll() {
        matches = [];
        track.innerHTML = '';
        resultsWrap.hidden = true;
        emptyEl.hidden = true;
        pickWrap.hidden = true;
        statusEl.textContent = '';
        stopAutoplay();
      }

      function selectItem(position) {
        var product = matches[position];
        if (!product) return;
        Array.prototype.forEach.call(track.children, function (item, i) {
          var on = i === position;
          item.classList.toggle('is-selected', on);
          item.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        pickIcon.innerHTML = '';
        if (product.image) {
          var img = document.createElement('img');
          img.src = product.image;
          img.alt = '';
          img.width = 56;
          img.height = 56;
          pickIcon.appendChild(img);
        } else {
          var letter = document.createElement('span');
          letter.textContent = (product.title || '').charAt(0).toUpperCase();
          pickIcon.appendChild(letter);
        }
        pickProduct.textContent = product.title + ' — ' + product.price;
        pickButton.setAttribute('href', product.url);
        pickWrap.hidden = false;
      }

      function buildItem(product, position) {
        var item = document.createElement('button');
        item.type = 'button';
        item.className = 'drink-finder__results-item';
        item.setAttribute('aria-pressed', 'false');

        var thumb = document.createElement('span');
        thumb.className = 'drink-finder__results-thumb';
        if (product.image) {
          var img = document.createElement('img');
          img.src = product.image;
          img.alt = '';
          img.width = 32;
          img.height = 32;
          img.loading = 'lazy';
          thumb.appendChild(img);
        }

        var text = document.createElement('span');
        text.className = 'drink-finder__results-text';
        var name = document.createElement('span');
        name.className = 'drink-finder__results-name';
        name.textContent = product.title;
        var price = document.createElement('span');
        price.className = 'drink-finder__results-price';
        price.textContent = product.price;
        text.appendChild(name);
        text.appendChild(price);

        item.appendChild(thumb);
        item.appendChild(text);
        item.addEventListener('click', function () {
          selectItem(position);
        });
        return item;
      }

      function updateArrows() {
        var max = track.scrollWidth - track.clientWidth;
        prevBtn.disabled = track.scrollLeft <= 2;
        nextBtn.disabled = track.scrollLeft >= max - 2;
      }

      function gapSize() {
        var styles = window.getComputedStyle(track);
        return parseFloat(styles.columnGap || styles.gap) || 0;
      }

      // One click = one page of 3 cards.
      function slide(direction) {
        var distance = (track.clientWidth + gapSize()) * direction;
        if (typeof track.scrollBy === 'function') {
          track.scrollBy({ left: distance, behavior: reduceMotion ? 'auto' : 'smooth' });
        } else {
          track.scrollLeft += distance;
        }
      }

      function scrollToStart() {
        if (typeof track.scrollTo === 'function') {
          track.scrollTo({ left: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
        } else {
          track.scrollLeft = 0;
        }
      }

      function render(list) {
        matches = list;
        track.innerHTML = '';
        if (!list.length) {
          resultsWrap.hidden = true;
          pickWrap.hidden = true;
          emptyEl.hidden = false;
          statusEl.textContent = emptyEl.textContent.trim();
          stopAutoplay();
          return;
        }
        emptyEl.hidden = true;
        var fragment = document.createDocumentFragment();
        list.forEach(function (product, position) {
          fragment.appendChild(buildItem(product, position));
        });
        track.appendChild(fragment);
        resultsWrap.classList.toggle('has-slider', list.length > 3);
        resultsWrap.hidden = false;
        track.scrollLeft = 0;
        statusEl.textContent = list.length + (list.length === 1 ? ' product found' : ' products found');
        selectItem(0);
        updateArrows();
        scheduleAutoplay();
      }

      function run() {
        var searchScorer = searchMatcher(input.value);
        var activeData = activePill ? dataFor(activePill) : null;
        var scorer = searchScorer || (activeData ? activeData.scorer : null);
        if (!scorer) {
          hideAll();
          return;
        }
        var ranked = [];
        catalog.forEach(function (entry) {
          var score = scorer(entry.index);
          if (score > 0) ranked.push({ entry: entry, score: score });
        });
        ranked.sort(function (a, b) {
          return b.score - a.score || a.entry.order - b.entry.order;
        });
        if (searchScorer) setActivePill(resolvePill(input.value, ranked.length ? ranked[0].entry : null));
        render(
          ranked.map(function (row) {
            return row.entry.product;
          })
        );
      }

      function runNow() {
        window.clearTimeout(debounceId);
        run();
      }

      // Mobile: search text wraps to max 2 lines (like the design), desktop stays 1 line via CSS.
      desktopMq = window.matchMedia ? window.matchMedia('(min-width: 769px)') : null;
      sizer = document.createElement('div');
      sizer.setAttribute('aria-hidden', 'true');
      sizer.style.cssText =
        'position:absolute;left:-9999px;top:0;visibility:hidden;pointer-events:none;white-space:pre-wrap;overflow-wrap:break-word;';
      root.appendChild(sizer);

      function fitInput() {
        if (!sizer) return;
        if (desktopMq && desktopMq.matches) {
          input.style.height = '';
          return;
        }
        var styles = window.getComputedStyle(input);
        var line = parseFloat(styles.lineHeight) || 21;
        sizer.style.width = input.clientWidth + 'px';
        sizer.style.fontFamily = styles.fontFamily;
        sizer.style.fontSize = styles.fontSize;
        sizer.style.fontWeight = styles.fontWeight;
        sizer.style.letterSpacing = styles.letterSpacing;
        sizer.style.lineHeight = styles.lineHeight;
        // While phrases type in and out, size for the longest one so the field doesn't jump.
        var placeholderText = !activePill && longestPhrase ? longestPhrase : input.getAttribute('placeholder');
        sizer.textContent = input.value || placeholderText || ' ';
        var lines = Math.max(1, Math.min(2, Math.round(sizer.scrollHeight / line)));
        input.style.height = lines * line + 'px';
      }

      // Typing searches all products and selects the matching tab, a tab click clears the text.
      input.addEventListener('input', function () {
        syncPills();
        refreshPlaceholder();
        fitInput();
        window.clearTimeout(debounceId);
        debounceId = window.setTimeout(run, 200);
      });
      input.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' || event.isComposing) return;
        event.preventDefault();
        runNow();
      });
      input.addEventListener('focus', function () {
        inputFocused = true;
        refreshPlaceholder();
      });
      input.addEventListener('blur', function () {
        inputFocused = false;
        refreshPlaceholder();
      });
      submit.addEventListener('click', runNow);

      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          var hadText = !!normalize(input.value);
          input.value = '';
          fitInput();
          setActivePill(pill === activePill && !hadText ? null : pill);
          runNow();
        });
      });

      fitInput();
      if ('ResizeObserver' in window) {
        var lastInputWidth = 0;
        new ResizeObserver(function () {
          if (input.clientWidth === lastInputWidth) return;
          lastInputWidth = input.clientWidth;
          fitInput();
        }).observe(input);
      } else {
        window.addEventListener('resize', fitInput);
      }
      if (desktopMq && desktopMq.addEventListener) desktopMq.addEventListener('change', fitInput);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitInput);

      prevBtn.addEventListener('click', function () {
        slide(-1);
        scheduleAutoplay();
      });
      nextBtn.addEventListener('click', function () {
        slide(1);
        scheduleAutoplay();
      });
      track.addEventListener(
        'scroll',
        function () {
          if (arrowFrame) return;
          arrowFrame = window.requestAnimationFrame(function () {
            arrowFrame = null;
            updateArrows();
          });
        },
        { passive: true }
      );
      if ('ResizeObserver' in window) {
        new ResizeObserver(updateArrows).observe(track);
      } else {
        window.addEventListener('resize', updateArrows);
      }

      // Autoplay pauses: hover (desktop), keyboard focus inside the slider. A swipe restarts the countdown.
      resultsWrap.addEventListener('mouseenter', function () {
        hoverPause = true;
        stopAutoplay();
      });
      resultsWrap.addEventListener('mouseleave', function () {
        hoverPause = false;
        scheduleAutoplay();
      });
      resultsWrap.addEventListener('focusin', function (event) {
        var keyboard = false;
        try {
          keyboard = event.target.matches(':focus-visible');
        } catch (e) {
          keyboard = false;
        }
        focusPause = keyboard;
        if (keyboard) stopAutoplay();
      });
      resultsWrap.addEventListener('focusout', function (event) {
        if (event.relatedTarget && resultsWrap.contains(event.relatedTarget)) return;
        focusPause = false;
        scheduleAutoplay();
      });
      track.addEventListener('touchstart', scheduleAutoplay, { passive: true });

      // Off screen or background tab: stop typing and autoplay, resume when back.
      function onVisibilityChange() {
        refreshPlaceholder();
        scheduleAutoplay();
      }
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          inView = entries[0].isIntersecting;
          onVisibilityChange();
        }).observe(root);
      }
      document.addEventListener('visibilitychange', onVisibilityChange);

      // Page load: nothing selected and no results, unless "Show results on page load" set a default tab.
      var defaultPill = null;
      pills.forEach(function (pill) {
        if (!defaultPill && pill.getAttribute('aria-pressed') === 'true') defaultPill = pill;
      });
      setActivePill(defaultPill);
      if (defaultPill) run();
    }

    function initAll() {
      Array.prototype.forEach.call(document.querySelectorAll('[data-drink-finder]'), function (root) {
        initDrinkFinder(root);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
    document.addEventListener('shopify:section:load', function (event) {
      var root = event.target.querySelector('[data-drink-finder]');
      if (root) initDrinkFinder(root);
    });
  })();
</script>

