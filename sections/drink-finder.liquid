{%- comment -%}
  Section: Drink Finder
  BEM Root: drink-finder__

  Search: a product is shown if the term exists in ANY of these fields
    1. custom.search_keywords (metafield, list of single line text)
    2. title
    3. product type
    4. description
  Ranking (highest first): keywords > title > type > description (see FIELD_WEIGHTS in the script).

  Page load: only header and search show, centered in the section. Filters, results and
  "Our pick" appear (with a short pop-in) once the customer types or picks a filter, unless "Show results on page load" is on.

  Placeholder: while the field is empty, unfocused and no filter is selected, the example phrases
  type themselves in and out (setting "Typing phrases", one per line).

  Filters: the selected filter writes "I need something that keeps [filter]" into the search field.
  Typing a search selects the filter named in the text, else the filter that contains the top result.

  Results: more than 3 matches turn into a slider.
    Desktop: 3 per view, prev/next arrows outside the tray.
    Mobile: swipe, 2 cards + peek, tray bleeds to the right screen edge.
    Autoplay: moves one page every X seconds and loops back to the start. Pauses on hover,
    keyboard focus, when off screen and with reduced motion. Restarts after a swipe or arrow click.
{%- endcomment -%}

{%- liquid
  assign bg_image = section.settings.background_image
  assign bg_image_mobile = section.settings.mobile_background_image | default: section.settings.background_image
  assign overlay = section.settings.overlay

  assign section_height = section.settings.section_height
  assign mobile_section_height = section.settings.mobile_section_height

  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign mobile_padding_top = section.settings.mobile_padding_top
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom

  assign eyebrow_text = section.settings.eyebrow_text
  assign heading = section.settings.heading
  assign search_placeholder = section.settings.search_placeholder
  assign typing_phrases = section.settings.typing_phrases
  assign pill_search_template = section.settings.pill_search_template
  assign show_on_load = section.settings.show_results_on_load
  assign empty_text = section.settings.empty_text | default: 'No matches found. Try another search.'
  assign pick_label = section.settings.pick_label
  assign pick_button_label = section.settings.pick_button_label

  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed | default: 5

  assign source_collection = section.settings.collection
  if source_collection == blank
    assign source_collection = collections.all
  endif
-%}

{%- style -%}
#drink-finder-{{ section.id }} {
  padding-block: {{ mobile_padding_top }}px {{ mobile_padding_bottom }}px;
}

#drink-finder-{{ section.id }} [hidden] {
  display: none !important;
}

#drink-finder-{{ section.id }}[data-mobile-height='small'] {
  min-height: 420px;
}

#drink-finder-{{ section.id }}[data-mobile-height='medium'] {
  min-height: 600px;
}

#drink-finder-{{ section.id }}[data-mobile-height='large'] {
  min-height: 760px;
}

#drink-finder-{{ section.id }}[data-mobile-height='fit_screen'] {
  min-height: 100vh;
}

#drink-finder-{{ section.id }}[data-mobile-height='auto'] {
  min-height: 0;
}
@media (min-width: 769px) {
  #drink-finder-{{ section.id }} {
    padding-block: {{ padding_top }}px {{ padding_bottom }}px;
  }

  #drink-finder-{{ section.id }}[data-height='small'] {
    min-height: 480px;
  }

  #drink-finder-{{ section.id }}[data-height='medium'] {
    min-height: 680px;
  }

  #drink-finder-{{ section.id }}[data-height='large'] {
    min-height: 860px;
  }

  #drink-finder-{{ section.id }}[data-height='fit_screen'] {
    min-height: 100vh;
  }

  #drink-finder-{{ section.id }}[data-height='auto'] {
    min-height: 0;
  }
}

/* ---------- Base ---------- */
.drink-finder {
  --df-ink: #0e1f2a;
  --df-glass: #ffffff24;
  --df-glass-hover: #ffffff38;
  --df-line: #ffffff38;
  --df-line-soft: #ffffff2e;
  --df-line-strong: #ffffff66;
  --df-tray: #0e1f2a38;
  --df-blur: 12px;
  --df-gap: 9px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.drink-finder *,
.drink-finder *::before,
.drink-finder *::after {
  box-sizing: border-box;
}

.drink-finder button:focus-visible,
.drink-finder a:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 2px;
}

.drink-finder .visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.drink-finder__background {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.drink-finder__background-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.drink-finder .mobile-hide {
  display: none;
}

.drink-finder__overlay {
  position: absolute;
  inset: 0;
  background: #0E1F2A66;
}

.drink-finder__container {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 640px;
  margin-inline: auto;
  padding-inline: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* ---------- Header ---------- */
.drink-finder__header {
  padding-block-end: 24px;
}

.drink-finder__eyebrow {
  padding-block-end: 12px;
}

.drink-finder__eyebrow span {
  display: block;
  color: #fff;
  font-size: 11px;
  line-height: 16.5px;
  letter-spacing: 2.4px;
  font-weight: 600;
  text-transform: uppercase;
}

.drink-finder__heading {
  width: 100%;
  max-width: 315px;
}

.drink-finder__heading h2 {
  margin: 0;
  font-family: canela, serif;
  color: #fff;
  font-size: 28px;
  line-height: 36.4px;
  font-weight: 300;
  letter-spacing: -0.3px;
  text-transform: capitalize;
}

/* ---------- Finder box ---------- */
.drink-finder__finder {
  border-radius: 18px;
  background: #f5f5f538;
  width: 100%;
  display: flex;
  flex-direction: column;
  row-gap: 16px;
  padding: 16px;
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}

/* Search bar */
.drink-finder__search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
}

.drink-finder__search-icon {
  display: flex;
  flex-shrink: 0;
  width: 18px;
}

.drink-finder__search-icon svg {
  display: block;
  width: 100%;
  height: auto;
}

.drink-finder .drink-finder__search-input {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  outline: 0;
  background: transparent;
  box-shadow: none;
  color: #fff;
  font-size: 13px;
  line-height: 21px;
  font-weight: 600;
  text-align: left;
  resize: none;
  overflow: hidden;
  -webkit-appearance: none;
  appearance: none;
}

.drink-finder .drink-finder__search-input:focus {
  outline: 0;
  box-shadow: none;
}

.drink-finder .drink-finder__search-input::placeholder {
  color: rgba(255, 255, 255, 0.92);
  opacity: 1;
}

.drink-finder__search-submit {
  -webkit-appearance: none;
  appearance: none;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  margin: 0;
  padding: 0;
  background: #ffffff24;
  border-radius: 999px;
  color: #fff;
  cursor: pointer;
  -webkit-backdrop-filter: blur(9px);
  backdrop-filter: blur(9px);
  transition: background-color 0.2s ease;
}

.drink-finder__search-submit:hover {
  background: var(--df-glass-hover);
}

.drink-finder__search-submit svg {
  display: block;
  width: 18px;
  height: 18px;
}

/* Quick filter pills (mobile: above the search, wrapped, rounded tray) */
.drink-finder__pills {
  order: -1;
  display: flex;
  flex-wrap: wrap;
  gap: 8px 7px;
  background: #0e1f2a38;
  border: 1px solid #ffffff38;
  border-radius: 12px;
  padding: 9px;
}

.drink-finder__pill {
  -webkit-appearance: none;
  appearance: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 0;
  padding: 8px 12px;
  background: #ffffff24;
  border-radius: 999px;
  cursor: pointer;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.drink-finder__pill--active {
  border-color: #FFF;
  background: #fff;
}

.drink-finder__pill--active .drink-finder__pill-label,
.drink-finder__pill--active .drink-finder__pill-icon svg {
  color: #0E1F2A;
}

.drink-finder__pill-icon {
  display: flex;
  flex-shrink: 0;
  width: 16px;
}

.drink-finder__pill-icon svg {
  display: block;
  width: 100%;
  height: auto;
}

.drink-finder__pill-label {
  color: #FFF;
  font-size: 12px;
  line-height: 16px;
  font-weight: 500;
  white-space: nowrap;
}

/* ---------- Results (mobile: swipe, 2 + peek, bleeds right) ---------- */
.drink-finder__results {
  align-self: stretch;
  width: auto;
  margin-block-start: 28px;
  margin-inline-end: calc(50% - 50vw);
}

.drink-finder__results-list {
  overflow: hidden;
  border: 1px solid #ffffff38;
  background: #0e1f2a38;
  border-radius: 999px;
  padding: 10px;
}

.drink-finder__results-track {
  display: flex;
  gap: var(--df-gap);
  overflow-x: auto;
  overscroll-behavior-x: contain;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.drink-finder__results-track::-webkit-scrollbar {
  display: none;
}

.drink-finder__results-track::after {
  content: '';
  flex: 0 0 1px;
}

.drink-finder__results-item {
  -webkit-appearance: none;
  appearance: none;
  flex: 0 0 auto;
  width: clamp(150px, 41vw, 190px);
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0;
  padding: 7px 12px 7px 8px;
  border: 1px solid var(--df-line-strong);
  border-radius: 999px;
  background: var(--df-glass);
  color: #fff;
  font: inherit;
  text-align: left;
  scroll-snap-align: start;
  cursor: pointer;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.drink-finder__results-item:hover {
  background: var(--df-glass-hover);
}

.drink-finder__results-item.is-selected {
  background: #fff;
  border-color: #fff;
  color: var(--df-ink);
}

.drink-finder__results-thumb {
  flex-shrink: 0;
  width: 30px;
  height: 30px;
  overflow: hidden;
  border-radius: 999px;
  background: #ffffff2e;
}

.drink-finder__results-item.is-selected .drink-finder__results-thumb {
  background: transparent;
}

.drink-finder__results-thumb img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.drink-finder__results-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.drink-finder__results-name {
  display: block;
  overflow: hidden;
  color: inherit;
  font-size: 14px;
  line-height: 16px;
  font-weight: 500;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.drink-finder__results-price {
  display: block;
  color: #ffffffbf;
  font-size: 12px;
  line-height: 14px;
  font-weight: 500;
}

.drink-finder__results-item.is-selected .drink-finder__results-price {
  color: #0e1f2abf;
}

.drink-finder__results-arrow {
  -webkit-appearance: none;
  appearance: none;
  display: none;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  margin: 0;
  padding: 0;
  background: #f5f5f538;
  border-radius: 999px;
  color: #fff;
  cursor: pointer;
  transition: background-color 0.2s ease, opacity 0.2s ease;
}

.drink-finder__results-arrow:hover:not(:disabled) {
  background: var(--df-glass-hover);
}

.drink-finder__results-arrow:disabled {
  opacity: 0.35;
  cursor: default;
}

.drink-finder__results-arrow svg {
  display: block;
  width: 16px;
  height: 16px;
}

.drink-finder__results-empty {
  margin: 24px 0 0;
  color: #fff;
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
}

/* ---------- Our pick (mobile: icon left, text + button stacked) ---------- */
.drink-finder__pick {
  width: 100%;
  margin-block-start: 24px;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr);
  grid-template-areas:
    'icon info'
    'icon button';
  align-items: center;
  gap: 12px;
  background: #ffffff1a;
  border-radius: 12px;
  padding: 12px;
  text-align: left;
  -webkit-backdrop-filter: blur(1px);
  backdrop-filter: blur(1px);
}

.drink-finder__pick-icon {
  grid-area: icon;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  flex: 0 0 52px;
  overflow: hidden;
  border-radius: 999px;
  background: #fff;
}

.drink-finder__pick-icon img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.drink-finder__pick-icon span {
  color: var(--df-ink);
  font-family: canela, serif;
  font-size: 22px;
  line-height: 1;
}

.drink-finder__pick-info {
  grid-area: info;
  min-width: 0;
}

.drink-finder__pick-label span {
  display: block;
  color: #fff;
  font-size: 10px;
  line-height: 13px;
  letter-spacing: 0.8px;
  font-weight: 600;
  text-transform: uppercase;
}

.drink-finder__pick-product {
  padding-block-start: 12px;
}

.drink-finder__pick-product span {
  display: block;
  font-family: canela, serif;
  color: #fff;
  font-size: 20px;
  line-height: 26px;
  letter-spacing: -0.4px;
  font-weight: 300;
}

.drink-finder__pick-button {
  grid-area: button;
  justify-self: start;
}

.drink-finder__pick-button a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #ffffff24;
  border-radius: 999px;
  padding: 8px 14px;
  color: #fffffff2;
  text-decoration: none;
  white-space: nowrap;
  transition: background-color 0.2s ease;
}

.drink-finder__pick-button a:hover {
  background: var(--df-glass-hover);
}

.drink-finder__pick-button-icon {
  display: flex;
  flex-shrink: 0;
  width: 16px;
}

.drink-finder__pick-button-icon svg {
  display: block;
  width: 100%;
  height: auto;
}

.drink-finder__pick-button-text {
  font-size: 11px;
  line-height: 16.5px;
  font-weight: 700;
  text-transform: uppercase;
}

/* ---------- Pop-in when results / pick / empty message appear ---------- */
@keyframes drink-finder-pop {
  from {
    opacity: 0;
    transform: translateY(14px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.drink-finder__pills:not([hidden]),
.drink-finder__results:not([hidden]),
.drink-finder__results-empty:not([hidden]),
.drink-finder__pick:not([hidden]) {
  animation: drink-finder-pop 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
}

.drink-finder__pick:not([hidden]) {
  animation-delay: 0.08s;
}

/* ---------- Desktop ---------- */
@media (min-width: 769px) {
  .drink-finder .desktop-hide {
    display: none;
  }

  .drink-finder .mobile-hide {
    display: block;
  }

  .drink-finder__container {
    max-width: 768px;
  }

  .drink-finder__header {
    padding-block-end: 42px;
  }

  .drink-finder__eyebrow {
    padding-block-end: 18px;
  }

  .drink-finder__eyebrow span {
    font-size: 12px;
    line-height: 14px;
  }

  .drink-finder__heading h2 {
    font-size: 32px;
    line-height: 34px;
  }

  .drink-finder__finder {
    row-gap: 24px;
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  .drink-finder__search-bar {
    gap: 22px;
  }

  .drink-finder__search-icon {
    width: 22px;
  }

  .drink-finder .drink-finder__search-input {
    font-size: 15px;
    white-space: nowrap;
  }

  .drink-finder__search-submit {
    width: 40px;
    height: 40px;
  }

  .drink-finder__search-submit svg {
    width: 20px;
    height: 20px;
  }

  .drink-finder__pills {
    order: 0;
    flex-wrap: nowrap;
    gap: 8px;
    padding: 12px;
    border-radius: 99px;
  }

  .drink-finder__pill {
    flex: 1 1 auto;
    gap: 10px;
    padding: 18px 6px 18px 20px;
  }

  .drink-finder__pill:hover {
    border-color: #FFF;
    background: #fff;
  }

  .drink-finder__pill--active:hover {
    border-color: #FFF;
    background: #fff;
  }

  .drink-finder__pill-icon {
    width: 20px;
  }

  .drink-finder__pill-label {
    font-size: 14px;
  }

  .drink-finder__pill:hover .drink-finder__pill-label,
  .drink-finder__pill--active:hover .drink-finder__pill-label,
  .drink-finder__pill:hover .drink-finder__pill-icon svg,
  .drink-finder__pill--active:hover .drink-finder__pill-icon svg {
    color: #0E1F2A;
  }

  /* Results: [prev] [tray 624px, 3 per view] [next] */
  .drink-finder__results {
    align-self: center;
    width: 100%;
    margin-block-start: 29px;
    margin-inline-end: 0;
    display: grid;
    grid-template-columns: 40px minmax(0, 624px) 40px;
    column-gap: 12px;
    align-items: center;
    justify-content: center;
  }

  .drink-finder__results-arrow {
    display: flex;
    visibility: hidden;
    grid-row: 1;
  }

  .drink-finder__results.has-slider .drink-finder__results-arrow {
    visibility: visible;
  }

  .drink-finder__results-arrow--prev {
    grid-column: 1;
  }

  .drink-finder__results-list {
    grid-row: 1;
    grid-column: 2;
    padding: 12px;
  }

  .drink-finder__results-arrow--next {
    grid-column: 3;
  }

  .drink-finder__results-track::after {
    display: none;
  }

  .drink-finder__results:not(.has-slider) .drink-finder__results-track {
    justify-content: center;
  }

  /* 3 cards + 2 gaps = exactly one page, so each slide lands on the next 3 */
  .drink-finder__results-item {
    width: calc((100% - 2 * var(--df-gap)) / 3);
    padding: 11px 14px;
    gap: 9px;
  }

  .drink-finder__results-thumb {
    width: 32px;
    height: 32px;
  }

  .drink-finder__pick {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 618px;
    margin-block-start: 29px;
    border-radius: 999px;
    padding: 16px;
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }

  .drink-finder__pick-icon {
    width: 56px;
    height: 56px;
    flex: 0 0 56px;
  }

  .drink-finder__pick-info {
    flex: 1 1 auto;
  }

  .drink-finder__pick-product {
    padding-block-start: 5px;
  }

  .drink-finder__pick-product span {
    font-size: 22px;
  }

  .drink-finder__pick-button {
    flex-shrink: 0;
  }

  .drink-finder__pick-button a {
    padding: 13px 18px;
  }

  .drink-finder__pick-button-icon {
    width: 20px;
  }

  .drink-finder__pick-button-text {
    font-size: 14px;
    line-height: 16px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .drink-finder *,
  .drink-finder *::before,
  .drink-finder *::after {
    transition: none !important;
    animation: none !important;
  }
}
{%- endstyle -%}

{%- comment -%}
  Pills are captured first so the search field can start with the sentence of the default pill.
  A pill only starts active when "Show results on page load" is on.
{%- endcomment -%}
{%- liquid
  assign active_pill_found = false
  assign active_placeholder = search_placeholder
-%}
{%- capture pills_markup -%}
  {%- comment -%}
    Search sentence per pill: its own text, else the section template with [filter] = pill label (first letter lowercase).
  {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'filter_pill' -%}
      {%- liquid
        assign pill_icon = block.settings.icon
        assign pill_label = block.settings.label
        assign pill_filter = block.settings.filter_tag | default: pill_label

        assign pill_active = false
        if show_on_load and block.settings.default_active and active_pill_found == false
          assign pill_active = true
        endif

        assign pill_text = block.settings.search_text
        if pill_text == blank and pill_search_template != blank
          assign pill_name_first = pill_label | slice: 0 | downcase
          assign pill_name_rest = pill_label | slice: 1, 250
          assign pill_name = pill_name_first | append: pill_name_rest
          assign pill_text = pill_search_template | replace: '[filter]', pill_name
        endif
        if pill_text == blank
          assign pill_text = search_placeholder
        endif

        if pill_active
          assign active_pill_found = true
          assign active_placeholder = pill_text
        endif
      -%}
      <button
        class="drink-finder__pill{% if pill_active %} drink-finder__pill--active{% endif %}"
        type="button"
        data-drink-finder-pill
        data-filter-tag="{{ pill_filter | escape }}"
        data-search-text="{{ pill_text | escape }}"
        aria-pressed="{{ pill_active }}"
        {{ block.shopify_attributes }}
      >
