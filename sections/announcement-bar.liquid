{% comment %}
  Section: Announcement bar
  - Messages = blocks (text + optional link), joined with a separator
  - Desktop: one centred line
  - Mobile: wraps onto 2 lines (like Figma) or scrolls as a marquee (setting)
  - Sets --ab-h / --ab-offset on <html> so a fixed/overlay header sits below the bar
  - Single file: CSS + JS included (no asset files needed)
{% endcomment %}

{% style %}
/* ================= Announcement bar — mobile first ================= */
.ab {
  position: relative;
  z-index: 51;                 /* above the header (50) */
  background: var(--ab-bg);
  color: var(--ab-text);
  overflow: hidden;
}

.ab__inner {
  padding: 10px 20px;
}

.ab__text {
  margin: 0;
  font-family: var(--font-body, 'Inter', sans-serif);
  font-size: 12px;
  font-weight: 400;
 line-height: 16.8px;
  letter-spacing: 0;
  text-align: center;
}

.ab__sep {
  display: inline-block;
  margin: 0 8px;
  opacity: 0.7;
}

.ab__link {
  color: inherit;
  text-decoration: none;
}
.ab__link:hover { text-decoration: underline; text-underline-offset: 2px; }
.ab__link:focus-visible { outline: 1px solid currentColor; outline-offset: 2px; }

.ab__text--clone { display: none; }

/* ---------- Mobile marquee (optional) ---------- */
@media (max-width: 768px) {
  .ab--mobile-marquee .ab__inner {
    display: flex;
    width: max-content;
    padding: 10px 0;
    animation: abMarquee 22s linear infinite;
  }
  .ab--mobile-marquee .ab__text {
    flex-shrink: 0;
    white-space: nowrap;
  }
  /* both copies end with a separator, so the loop joins seamlessly */
  .ab--mobile-marquee .ab__text::after {
    content: attr(data-sep);
    display: inline-block;
    margin: 0 8px;
    opacity: 0.7;
  }
  .ab--mobile-marquee .ab__text--clone { display: block; }
  .ab--mobile-marquee:hover .ab__inner,
  .ab--mobile-marquee:focus-within .ab__inner { animation-play-state: paused; }
}

@keyframes abMarquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* ================= Desktop ================= */
@media (min-width: 769px) {
  .ab__inner { padding: 12px 20px; }
  .ab__text {
    font-size: 14px;
    line-height: 19.6px;
    white-space: nowrap;
  }
  .ab__sep { margin: 0 10px; }
}

@media (prefers-reduced-motion: reduce) {
  .ab--mobile-marquee .ab__inner { animation: none; width: auto; }
  .ab--mobile-marquee .ab__text { white-space: normal; }
  .ab--mobile-marquee .ab__text--clone { display: none; }
  .ab--mobile-marquee .ab__text::after { content: none; }
}
{% endstyle %}

{%- assign messages = section.blocks | where: 'type', 'message' -%}

{%- if section.settings.show and messages.size > 0 -%}
  <style>
    #AnnouncementBar-{{ section.id }} {
      --ab-bg: {{ section.settings.bg }};
      --ab-text: {{ section.settings.text_color }};
    }
  </style>

  {%- capture ab_items -%}
    {%- for block in messages -%}
      <span class="ab__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="ab__link">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </span>
      {%- unless forloop.last -%}
        <span class="ab__sep" aria-hidden="true">{{ section.settings.separator }}</span>
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  <div
    id="AnnouncementBar-{{ section.id }}"
    class="ab ab--mobile-{{ section.settings.mobile_layout }}"
    role="region"
    aria-label="Announcement"
    data-announcement-bar
  >
    <div class="ab__inner">
      <p class="ab__text" data-sep="{{ section.settings.separator | escape }}">{{ ab_items }}</p>

      {%- comment -%} Second copy only used by the mobile marquee, for a seamless loop {%- endcomment -%}
      {%- if section.settings.mobile_layout == 'marquee' -%}
        <p class="ab__text ab__text--clone" data-sep="{{ section.settings.separator | escape }}" aria-hidden="true">{{ ab_items }}</p>
      {%- endif -%}
    </div>
  </div>

  <script>
    (function () {
      var bar = document.getElementById('AnnouncementBar-{{ section.id }}');
      if (!bar) return;
      var root = document.documentElement;
      var ticking = false;

      function update() {
        ticking = false;
        var h = bar.offsetHeight;
        var visible = Math.max(0, h - window.scrollY);
        root.style.setProperty('--ab-h', h + 'px');          /* full bar height */
        root.style.setProperty('--ab-offset', visible + 'px'); /* part still on screen */
      }
      function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }

      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      if ('ResizeObserver' in window) new ResizeObserver(onScroll).observe(bar);
    })();
  </script>
{%- else -%}
  <script>
    document.documentElement.style.setProperty('--ab-h', '0px');
    document.documentElement.style.setProperty('--ab-offset', '0px');
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "class": "section-announcement-bar",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "show", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "separator", "label": "Separator", "default": "·" },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "wrap", "label": "Wrap onto two lines" },
        { "value": "marquee", "label": "Scroll (marquee)" }
      ],
      "default": "wrap"
    },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0E1F2A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $75" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping over $75" } },
        { "type": "message", "settings": { "text": "Lifetime hardware warranty" } },
        { "type": "message", "settings": { "text": "Designed in California" } }
      ]
    }
  ]
}
{% endschema %}
