{%- liquid
  assign background = section.settings.background
  assign image = section.settings.image
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign secondary_text = section.settings.secondary_text
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile

  assign image_loading = 'lazy'
  if section.index <= 2
    assign image_loading = 'eager'
  endif

  assign image_alt = image.alt | default: heading | strip_html
  assign stats_markup = ''
-%}

{%- for block in section.blocks -%}
  {%- liquid
    assign stat_value = block.settings.value
    assign stat_label = block.settings.label
  -%}

  {%- capture stat_html -%}
    <li class="giving-back__stat" {{ block.shopify_attributes }}>
      {%- if stat_value != blank -%}
        <div class="giving-back__stat-value">
          <p>{{ stat_value | escape }}</p>
        </div>
      {%- endif -%}

      {%- if stat_label != blank -%}
        <div class="giving-back__stat-label">
          <p>{{ stat_label | escape }}</p>
        </div>
      {%- endif -%}
    </li>
  {%- endcapture -%}

  {%- assign stats_markup = stats_markup | append: stat_html -%}
{%- endfor -%}

<style>
  #shopify-section-{{ section.id }} .giving-back {
    --giving-back-bg: {{ background }};
    --giving-back-pt: {{ padding_top }}px;
    --giving-back-pb: {{ padding_bottom }}px;
    --giving-back-pt-mobile: {{ padding_top_mobile }}px;
    --giving-back-pb-mobile: {{ padding_bottom_mobile }}px;
  }

  .giving-back {
    padding-top: var(--giving-back-pt-mobile);
    padding-bottom: var(--giving-back-pb-mobile);
    background: var(--giving-back-bg);
    color: #111;
  }

  .giving-back__container {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 18px;
  }

  .giving-back__media {
    order: -1;
    aspect-ratio: 9 / 7;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: 6px;
    background: #ececec;
  }

  .giving-back__media img,
  .giving-back__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .giving-back__content {
    display: contents;
  }

  .giving-back__heading {
    order: -2;
  }

  .giving-back__heading h2 {
    margin: 0;
    font-family: var(--font-canela), var(--font-body-family);
    color: #000;
    font-size: 34px;
    line-height: 34px;
    letter-spacing: -0.34px;
    font-weight: 100;
  }

  .giving-back__heading strong {
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    font-size: 30.222px;
    letter-spacing: -0.907px;
    font-weight: 700;
  }

  .giving-back__text p,
  .giving-back__secondary-text p {
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    font-size: 15px;
    line-height: 24.75px;
    font-weight: 400;
  }

  .giving-back__secondary-text p {
    color: #7a7f87;
  }

  .giving-back__text p,
  .giving-back__secondary-text p {
    margin: 0;
  }

  .giving-back__text p + p,
  .giving-back__secondary-text p + p {
    margin-top: 0.8em;
  }

  .giving-back__text a,
  .giving-back__secondary-text a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .giving-back__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    padding: 18px 0;
    border-top: 1px solid #E7E9EA;
    border-bottom: 1px solid #E7E9EA;
    list-style: none;
  }

  .giving-back__stat-value {
    padding-block-end: 4px;
  }

  .giving-back__stat-value p {
    margin: 0;
    color: #000;
    font-family: var(--font-canela), var(--font-body-family);
    font-size: 40px;
    line-height: normal;
    font-weight: 100;
  }

  .giving-back__stat-label p {
    margin: 0;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #6E797F;
    font-size: 13px;
    line-height: normal;
    font-weight: 400;
  }

  .giving-back__button a {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    border: 1px solid #000;
    border-radius: 999px;
    font-family: var(--font-basis-grotesque), var(--font-body-family);
    color: #000;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 0.14px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .giving-back__button a:hover {
    background: #000;
    color: #fff;
  }

  .giving-back__button a:focus-visible {
    outline: 2px solid #000;
    outline-offset: 3px;
  }

  @media (min-width: 769px) {
    .giving-back {
      padding-top: var(--giving-back-pt);
      padding-bottom: var(--giving-back-pb);
    }

    .giving-back__container {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(40px, 5vw, 72px);
      padding: 0 36px;
    }

    .giving-back__media {
      order: 0;
      margin-bottom: 0;
    }

    .giving-back__content {
      display: flex;
      flex-direction: column;
      row-gap: 20px;
      max-width: 660px;
    }

    .giving-back__heading h2 {
      font-size: 51px;
      line-height: 51px;
      letter-spacing: -0.51px;
      font-weight: 300;
    }

    .giving-back__heading strong {
      font-size: 45.486px;
      letter-spacing: -1.365px;
      font-weight: 500;
    }

    .giving-back__text,
    .giving-back__secondary-text {
      max-width: 550px;
    }

    .giving-back__text p,
    .giving-back__secondary-text p {
      font-size: 16px;
      line-height: 26.4px;
    }

    .giving-back__stats {
      gap: 16px 40px;
      padding: 20px 0;
    }

    .giving-back__stat-value p {
      font-size: clamp(36px, 2.9vw, 42px);
    }
    
    .giving-back__button a {
      width: auto;
    }
  }
</style>

<section class="giving-back">
  <div class="giving-back__container">
    <div class="giving-back__content">
      {%- if heading != blank -%}
        <div class="giving-back__heading">
          <h2>{{ heading }}</h2>
        </div>
      {%- endif -%}

      {%- if text != blank -%}
        <div class="giving-back__text">
          {{ text }}
        </div>
      {%- endif -%}

      {%- if secondary_text != blank -%}
        <div class="giving-back__secondary-text">
          {{ secondary_text }}
        </div>
      {%- endif -%}

      {%- if stats_markup != blank -%}
        <ul class="giving-back__stats">
          {{ stats_markup }}
        </ul>
      {%- endif -%}

      {%- if button_label != blank -%}
        <div class="giving-back__button">
          <a {% if button_link != blank %}href="{{ button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
            {{- button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="giving-back__media">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 1400
          | image_tag:
            loading: image_loading,
            widths: '375, 550, 750, 1000, 1400',
            sizes: '(min-width: 769px) 46vw, calc(100vw - 36px)',
            alt: image_alt
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Giving back",
  "tag": "div",
  "class": "section-giving-back",
  "settings": [
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Giving <strong>back.</strong>",
      "info": "Bold text uses the sans-serif style."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We were created to do good in the world. One of the best ways we know how is by giving our dollar to charity: water. Every time you support us, we help bring safe and clean drinking water to people in developing countries around the world.</p>"
    },
    {
      "type": "richtext",
      "id": "secondary_text",
      "label": "Secondary text",
      "default": "<p>We chose charity: water because they share our values: transparency, relationship, and a long-term commitment to positive change.</p>",
      "info": "Shown in a lighter grey."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn about charity: water"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "2016"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Partners since"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Giving back",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "2016",
            "label": "Partners since"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "10,000+",
            "label": "People with clean water"
          }
        }
      ]
    }
  ]
}
{% endschema %}
