<style>
{% if section.settings.image != blank %}  
.pursuit_content_{{ section.id }} {
  background: linear-gradient(45deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 70%), url('{{ section.settings.image | img_url: 'master' }}') no-repeat center center fixed; 
  -webkit-background-size: cover;
  -moz-background-size: cover;
  -o-background-size: cover;
  background-size: cover;
}
{% else %}
.pursuit_content_{{ section.id }} {
  background-color: {{ section.settings.background_color }};
}
{% endif %}
.pursuit_content_{{ section.id }} .pursuit_content_main .description p {
  color: {{ section.settings.description_color }};
}

.pursuit_content_{{ section.id }} .pursuit_content_main .heading h2 {
  color: {{ section.settings.heading_color }};
}

.pursuit_content_{{ section.id }} {
  padding: 172px 0;
}

.pursuit_content_{{ section.id }} .page__width {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 1rem;
}

.pursuit_content_{{ section.id }} .pursuit_content_main {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 44px;
  text-align: center;
}

.pursuit_content_{{ section.id }} .pursuit_content_main .heading h2 {
  font-size: 24px;
  line-height: normal;
  font-style: normal;
}
  
.pursuit_content_{{ section.id }} .pursuit_content_main .description p {
      /* font-weight: 400; */
    line-height: 40px;
    font-size: 36px;
    margin: 0;
    /* font-family: canela, serif; */
}

@media only screen and (max-width: 768px) {

  .pursuit_content_{{ section.id }} {
    padding: 109px 0;
  }

  .pursuit_content_{{ section.id }} .pursuit_content_main {
    gap: 33px;
  }

 .pursuit_content_{{ section.id }} .pursuit_content_main .heading h2 {
    font-size: 18px;
  }

 .pursuit_content_{{ section.id }} .pursuit_content_main .description p {
    font-size: 24px;
  }
}
</style>

<div class="pursuit_content_section pursuit_content_{{ section.id }}">
  <div class="page__width">
    <div class="pursuit_content_main">
      {% if section.settings.heading != blank %}
      <div class="heading">
        <h2 >{{ section.settings.heading }}</h2>
      </div>
      {% endif %}
      {% if section.settings.description != blank %}
      <div class="description font-canela font-thin">
        {{ section.settings.description }}
      </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Pursuit Content",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#909090"
      },
      {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Description"
      },
      {
        "type": "header",
        "content": "Style"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading Color",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "description_color",
        "label": "Description Color",
        "default": "#FFFFFF"
      }
    ],
    "presets": [
      {
        "name": "Pursuit Content"
      }
    ]
  }
{% endschema %}