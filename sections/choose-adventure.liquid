<style>
  
.ca_{{ section.id }} .choose-heading {
    margin-bottom: 30px;
    font-family: canela, serif;
    line-height: normal;
    font-size: 50px;
    font-weight: 100;
    text-align: center;
}
  .choose-adventure{
    margin-bottom:20px;
  }
 .ca_{{ section.id }}  .width-100{
    width:100%;
    max-width:100%;
  }
 .ca_{{ section.id }}  .width-50{
    width:100%;
    max-width:50%;
  }
 .ca_{{ section.id }}  .width-33{
    width:100%;
    max-width:calc(33% - 20px);
  }
 .ca_{{ section.id }}  .choose-row {
    gap: 20px;
    display: flex;
    justify-content: center;
   flex-wrap: wrap;
}
  .ca_{{ section.id }} .choose-item {
    /* padding: 32px 32px 32px; */
    border: 2px solid #000000;
}
  .ca_{{ section.id }} .choose-item-icon {
    text-align: center;
    max-width: 100%;
    margin: 0 auto;
}
  .ca_{{ section.id }} .choose-item-heading h3 {
    margin-bottom: 15px;
    font-family: canela, serif;
    line-height: normal;
    font-size: 40px;
    font-weight: 100;
    text-align: center;
    margin-top: 20px;
}
  .ca_{{ section.id }} .choose-item-txt p {
    font-family: grotesque, sans-serif;
    font-weight: 400;
    line-height: normal;
    font-size: 20px;
    text-align: center;
}
  .ca_{{ section.id }} .dark_item {
    background: #000;
    color: #fff;
}

.ca_{{ section.id }} .choose-btn-v4 {
    display: block;
}
 .ca_{{ section.id }} .choose-item-txt {
    margin-bottom: 15px;
}
  .choose-btn-section {
    display: flex;
    justify-content: center;
}
  .choose-content {
    padding: 32px;
}
  @media(max-width:990px){
    .ca_{{ section.id }} .width-33{
    max-width:calc(50% - 20px);
  }
 .ca_{{ section.id }} .choose-btn-v4 {
    font-size: 12px;
       padding: 24px;
}
  }
   @media(max-width:600px){
    .ca_{{ section.id }} .width-33{
    max-width:calc(100% - 20px);
  }
     .choose-heading span {
    font-size: 20px;
}
    .ca_{{ section.id }} .choose-item {
       /* padding: 32px 15px 32px; */
     }
       .choose-content {
    padding: 32px 15px;
}
     .ca_{{ section.id }} .choose-heading {
    font-size: 40px;
}
       .ca_{{ section.id }} .choose-item-txt p {
    font-size: 18px;
}
  }
</style>

<section class="mt-60 choose-adventure ca_{{ section.id }}">
  <div class="choose-main site-container ">
    {% if section.settings.heading != blank %}<h2 class="choose-heading">{{ section.settings.heading }}</h2>{% endif %}
    <div class="choose-row">
      {% for block in section.blocks %}
        <div class="choose-item {% if block.settings.dark_block == true %} dark_item {% endif %} {% if forloop.length == 1 %} width-100 {% elsif forloop.length == 2 %} width-50 {% else %} width-33{% endif %}">
          {% if block.settings.heading != blank %}<div class="choose-item-heading"><h3>{{ block.settings.heading }}</h3></div>{% endif %}
          {% if block.settings.select == "image" %}
            {% if block.settings.icon != blank %}<div class="choose-item-icon"><img src="{{ block.settings.icon | image_url }}" class="choose-icon "></div>{% endif %}
          {% else %}
            <video width="100%" height="" controls>
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
          {% endif %}
          
          <div class="choose-content">
          {% if block.settings.text != blank %}<div class="choose-item-txt">{{ block.settings.text }}</div>{% endif %}
          {% if block.settings.button_text != blank %}
            <div class="choose-btn-section">
              <a href="{{ block.settings.button_url }}" class="choose-btn-v4  {% if block.settings.button_dark == true %}btn btn--black {% else %}btn-bigger btn--filled-white{% endif %} text-16  font-grotesque font-bold ">{{ block.settings.button_text }}</a>
            </div>
          {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>



{% schema %}
  {
  "name": "Choose Adventure",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default":"Choose Your Own Adventure"
    }
  ],
  "blocks": [
    {
      "name": "Item",
      "type": "item",
      "settings": [
        {
          "type": "checkbox",
          "id": "dark_block",
          "label": "Dark Block",
          "default": false
        },
        {
          "type": "select",
          "id": "select",
          "label": "Select",
          "options": [
            {
              "value": "video",
              "label": "Video"
            },
            {
              "value": "image",
              "label": "Image"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Image"
        },
        {
          "type": "html",
          "id": "video_url",
          "label": "Video URL"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Label"
        },
        {
          "type": "richtext",
          "label": "Text",
          "id": "text"
        },
         {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Start Now"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "checkbox",
          "id": "button_dark",
          "label": "Dark Button",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Choose Adventure"
    }
  ]
}  
{% endschema %}