<style>
.collection_list_{{ section.id }} {
  background-color: {{ section.settings.bg_color }};
}

.collection_list_section {
  padding-bottom: 64px;
}

.collection_list_section .page__width {
  max-width: 1450px;
  margin: 0 auto;
  padding: 0 1rem;
}

.collection_list_section .sec_heading {
  margin-bottom: min(2.5rem, calc(1.375rem + 1.5vw));
}

.collection_list_section .list_main {
  display: grid;
  grid-template-columns: auto auto auto auto auto auto;
  gap: 10px;
}

.list_main .collection_list {
  position: relative;
  overflow: hidden;
}

.collection_list a::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  background: linear-gradient(
    0deg,
    rgb( 0 0 0 / 100% ),
    rgb( 0 0 0 / 100% ),
    rgb( 0 0 0 / 75% ),
    rgb( 0 0 0 / 45% ),
    rgb( 0 0 0 / 20% ),
    rgb( 0 0 0 / 0% )
  );
  border-radius: 4px;
  opacity: 0.3;
  z-index: 1;
}

.collection_list a .collec_image {
  width: 100%;
  height: 100%;
  min-height: 240px;
}

.collection_list a .collec_image img {
  width: 100%;
  height: 100%;
  min-height: 100%;
  object-fit: cover;
  border-radius: 4px;
  display: flex;
  transition: 0.8s ease;
}

.collection_list:hover .collec_image img {
  transform: scale(1.1);
}
  
.collection_list a .collec_title {
  position: absolute;
  bottom: 0px;
  text-align: center;
  width: 100%;
  z-index: 2; 
  padding: 2rem;
}

.collection_list a .collec_title h4 {
  color: #fff;
}

@media only screen and (max-width: 1400px) {
  
  .collection_list_section .list_main {
    grid-template-columns: auto auto auto auto auto;
  }
}

@media only screen and (max-width: 1200px) {
  
  .collection_list_section .list_main {
    grid-template-columns: auto auto auto auto;
  }
}

@media only screen and (max-width: 992px) {
  
  .collection_list_section .list_main {
    grid-template-columns: auto auto auto;
  }
}

@media only screen and (max-width: 768px) {

  /* .collection_list_section .sec_heading h2 {
    font-size: 31px;
    line-height: 37px;
  } */
  
  .collection_list_section .list_main {
    grid-template-columns: auto auto;
  }

  .collection_list a .collec_title {
    padding: 1rem;
  }
}

</style>

<div class="collection_list_section collection_list_{{ section.id }}">
  <div class="page__width">
    {% if section.settings.heading != blank %}
    <div class="sec_heading">
        <h2 class="text-30 desktop:text-46 font-grotesque font-bold uppercase">{{ section.settings.heading }}</h2>
    </div>
    {% endif %}
    <div class="list_main">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
        <div class="collection_list">
          <a href="{{ block.settings.collection_link }}">
            <div class="collec_image">
              <img src="{{ block.settings.image | img_url: 'master' }}">
            </div>
            {% if block.settings.title != blank %}
            <div class="collec_title">
                <h4 class="font-semibold text-14 tablet:text-17">{{ block.settings.title }}</h4>
            </div>
            {% endif %}
          </a>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Collection Lists",
    "settings": [
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      }
    ],
    "blocks": [
      {
        "type": "collectionlist",
        "name": "Row",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Select image"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "url",
            "id": "collection_link",
            "label": "Collection Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Collection Lists"
      }
    ]
  }
{% endschema %}