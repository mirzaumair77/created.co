{%- comment -%}
  Background image for Stacked story tiles.
  Usage: {% render 'stk-image', image: img, image_mobile: img_mobile %}
{%- endcomment -%}
{%- assign mob = image_mobile | default: image -%}
{%- if image != blank -%}
  {{ image | image_url: width: 1600 | image_tag: class: 'stk__img stk__img--desktop', loading: 'lazy', widths: '800, 1100, 1400, 1600', sizes: '50vw', alt: image.alt }}
{%- endif -%}
{%- if mob != blank -%}
  {{ mob | image_url: width: 1000 | image_tag: class: 'stk__img stk__img--mobile', loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '100vw', alt: mob.alt }}
{%- endif -%}
{%- if image == blank and mob == blank -%}
  {{ 'lifestyle-1' | placeholder_svg_tag: 'stk__img' }}
{%- endif -%}
