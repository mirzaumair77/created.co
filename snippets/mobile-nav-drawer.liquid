<drawer-component id="MobileNavDrawer" class="overflow-y-scroll" position='right' open="[js-open-mobile-nav]" close="[js-close-mobile-nav]">
  <button js-close-mobile-nav class="hideen">{% render 'icon-close' %}</button>
  <ul>
    
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'menu_item' %}

          <li class="new_single_item_mbl">
            <a href="{{ block.settings.menu_link }}" class="top_item">
              {{- block.settings.menu_item_text -}}
            </a>
          </li>
          

        {% when 'mega_menu' %}
          <li class="new_megamenu_item_mbl">
            <div  class="top_item mega_item">
              <a href="{{ block.settings.menu_link }}">{{- block.settings.menu_item_text -}}</a>
              <span class="open_headings">{% render 'icon-caret' %}</span>


              {% liquid

                  assign ch = "column_heading_"
                  assign hl = "heading_link_"
                  assign cm = "column_menu_"
                
                %}

                <div class="new_mbl_menu_headings_list">
                   <div class="new_mbl_prev">
                      <div class="new_mbl_prev_inner">
                        {% render 'icon-caret' %}
                        <span>{{- block.settings.menu_item_text -}}</span>
                      </div>
                    </div>
                    {% for i in (1..5) %} 
    
                      {% liquid
    
                        assign column_heading = ch | append:i
                        assign heading_link = hl | append:i
                        assign column_menu = cm | append:i
                      
                      %} 

                      {% if block.settings[column_menu] != blank %}

                        <div class="headings_menus top_item">
                          <a href="{{ block.settings[heading_link] }}" class="top_heading">
                            {{- block.settings[column_heading] -}}
                          </a>
                          <span class="open_inner_menu">
                            {% render 'icon-caret' %}
                          </span>

                          <div class="mbl_inner_menu">
                            
                            <div class="new_mbl_prev_inner_menu"> 
                                {% render 'icon-caret' %}
                                <span>{{- block.settings[column_heading] -}}</span> 
                            </div>

                            
                                <ul class="mbl_inner_menu_menu">
                                  {% for link in block.settings[column_menu].links %}
                                    {% if link.type == 'product_link' %}
                                      <li class="{% if link.object.metafields.custom.new_menu_icon != blank  or link.object.featured_image %} new_megamenu_mbl_icon {% endif %}">
                                        <a href="{{ link.url }}">
                                          <span>{{ link.title }}</span>
                                          {% if link.object.metafields.custom.new_menu_icon != blank %}
                                            <img src="{{ link.object.metafields.custom.new_menu_icon | img_url:'x100' }}"/>
                                          {% elsif  link.object.featured_image != blank%}
                                             <img src="{{ link.object.featured_image | img_url:'x100' }}"/>
                                          {% endif %}
                                        </a>
                                      </li>
                                      {% else %}
                                      <li>
                                        <a href="{{ link.url }}">
                                          <span>{{ link.title }}</span>
                                        </a>
                                      </li> 
                                    {% endif %}
                                  {% endfor %}
                                </ul>
                            
                          </div>
                        </div> 
                      {% endif %}
     
    
                    {% endfor %}
                </div>
            </div>
          </li>
          {% when 'mega_menu_v2' %}
          <li class="new_megamenu_item_mbl">
            <div  class="top_item mega_item">
              <a href="{{ block.settings.menu_link }}">{{- block.settings.menu_item_text -}}</a>
              <span class="open_headings">{% render 'icon-caret' %}</span>


                <div class="new_mbl_menu_headings_list">
                   <div class="new_mbl_prev">
                      <div class="new_mbl_prev_inner">
                        {% render 'icon-caret' %}
                        <span>{{- block.settings.menu_item_text -}}</span>
                      </div>
                    </div>
                     {% for link in block.settings.column_menu_v2.links %}
                        <div class="headings_menus top_item">
                          <a href="{{ link.url }}" class="top_heading">
                            {{- link.title -}}
                          </a>
                        </div> 
    
                    {% endfor %}
                </div>
            </div>
          </li>

        
      {% endcase %}
    {% endfor %}
    
  </ul>
</drawer-component>
