{% comment %}
    Renders a product card

    Accepts:
    - product_card_product: {Object} Product Liquid object (optional)
    - media_size: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
    - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
    - add_image_padding: {Boolean} Enables padding on the image to space out the grid
    - show_vendor: {Boolean} Show the product vendor. Default: false
    - show_price: {Boolean} Show the product price.
    - show_button: {Boolean} Show the buy button.
    - show_badge: {Boolean} Show product card badges.
    - name_font_family: {String}: Name of font family to use for product name
    - name_font_size: {String}: Font size in pixels to use for product name
    - name_font_weight: {String}: Font weight to use for product name
    - price_font_family: {String}: Name of font family to use for product price
    - price_font_size: {String}: Font size in pixels to use for product price
    - price_font_weight: {String}: Font weight to use for product price

    Usage:
    {% render 'product-card', show_vendor: section.settings.show_vendor %}
{% endcomment %}

<product-card class="card-wrapper">
  <a href="{{ product_card_product.url | default: '#' }}" class="block">
    <span class="visually-hidden sr-only">{{ product_card_product.title | escape }}</span>
  </a>
  <div class="card card--product{% if product_card_product.featured_media == nil %} card--text-only card--soft{% endif %}" tabindex="-1">
    <div class="card__inner">
      <a href="{{ product_card_product.url | default: '#' }}" class="block">
        {%- if product_card_product.featured_media -%}
          {%- liquid
            assign featured_media_aspect_ratio = product_card_product.featured_media.aspect_ratio

            if product_card_product.featured_media.aspect_ratio == nil
              assign featured_media_aspect_ratio = 1
            endif
          -%}

          <div{% if add_image_padding %} class="card__media-full-spacer"{% endif %}>
            <div class="media media--transparent media--{{ media_size }} media--hover-effect"
              {% if media_size == 'adapt' and product_card_product.featured_media %} style="padding-bottom: {{ 1 | divided_by: featured_media_aspect_ratio | times: 100 }}%;"{% endif %}
            >
              {% render 'lazy-image' image: product_card_product.featured_image %}

              {%- if product_card_product.media[1] != nil and show_secondary_image -%}
                {% render 'lazy-image' image: product_card_product.images[1] %}
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          <div class="card__content"><h2 class="card__text h2">{{ product_card_product.metafields.product_cards.product_card_title | default: product_card_product.title }}</h2></div>
        {%- endif -%}

        {% if show_badge %}
          <div class="card__badge">
            {%- if product_card_product.available == false -%}
              <span class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}" aria-hidden="true">
                {{ 'products.product.sold_out' | t }}
              </span>
            {%- elsif product_card_product.compare_at_price > product_card_product.price and product_card_product.available -%}
              <span class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}" aria-hidden="true">
                {{ 'products.product.on_sale' | t }}
              </span>
            {%- endif -%}
          </div>
        {% endif %}
      </a>
    </div>
  </div>

  <div class="card-information mt-70">
    <div class="card-information__wrapper text-center">
      {%- if show_vendor -%}
        <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
        <div class="caption-with-letter-spacing light">{{ product_card_product.vendor }}</div>
      {%- endif -%}

      {% if shop.metafields.okendo.settings.isWidgetPlusEnabled == true %}
          {% assign renderWidgetPlusContent = true %}
      {% elsif shop.metafields.okendo.settings.isWidgetPlusAdminEnabled == true %}
          {% if request.design_mode or theme.role == "unpublished" %}
      	{% assign renderWidgetPlusContent = true %}
          {% endif %}
      {% endif %}
      
      {% if renderWidgetPlusContent == true %}
          <div data-oke-star-rating data-oke-reviews-product-id="shopify-{{ product_card_product.id }}">
              {{ product.metafields.okendo.StarRatingSnippet }}
          </div>
      {% else %}
          <div data-oke-reviews-product-listing-rating>
              {{ product.metafields.okendo.ProductListingSnippet }}
          </div>
      {% endif %}
      
      <a href="{{ product_card_product.url | default: '#' }}" class="block">
        {%- if product_card_product.featured_media -%}
          <span class="card-information__text{% if name_font_family %} font-{{ name_font_family }}{% endif %} {% if name_font_size %} text-{{ name_font_size }}{% else %} text-24{% endif %}{% if name_font_weight %} font-{{ name_font_weight }}{% endif %}">
            {{- product_card_product.metafields.product_cards.product_card_title | default: product_card_product.title -}}
          </span>
        {%- endif -%}

        <span class="card-information__text block font-grotesque text-16 font-normal">{{ product_card_product.metafields.product_cards.product_card_details | upcase }}</span>
      </a>

      {% if show_price %}
          {% assign money_price = product_card_product.price_max | money_without_trailing_zeros | strip %}
          {% assign compare_at_price = product_card_product.compare_at_price_max | money_without_trailing_zeros | strip %}
          <span {% if product_card_product.tags contains 'hide_atc' %}style="visibility:hidden;"{%- endif -%} class="product-card__price block {% if price_font_family %} font-{{ price_font_family }}{% endif %} {% if price_font_size %} text-{{ price_font_size }}{% else %} text-22{% endif %}{% if price_font_weight %} font-{{ price_font_weight }}{% endif %} mt-20">
            
            {%- if product.price_varies -%}
              {% if product_card_product.compare_at_price_max > product_card_product.price_max %}
                <span class="compare-price comparedPPC">
                  <s>{{ compare_at_price }}</s>
                </span>
                <span class="current-price">
                  {{ 'products.product.price.from_price_html' | t: price: money_price }}
                </span>
              {% else %}
                {{ 'products.product.price.from_price_html' | t: price: money_price }}
              {% endif %}
            {%- else -%}
              {% if product_card_product.compare_at_price_max > product_card_product.price_max %}
                <span class="compare-price comparedPPC">
                  <s>{{ compare_at_price }}</s>
                </span>
                <span class="current-price">
                  {{ money_price }}
                </span>
              {% else %}
                {{ money_price }}
              {% endif %}
            {%- endif %}
      
          </span>
      {% endif %}

      {% if product_card_product.tags contains 'hide_atc' %}
        <a class="btn mt-20 relative" href="{{ product_card_product.url }}">Learn More</a>
      {% else %}
      {% if show_button %}
        {% assign current_variant = product_card_product.selected_or_first_available_variant  %}
		{% assign productTags = product_card_product.tags | join: ', ' %}
        <button class="btn mt-20 relative" data-variant-id="{{ current_variant.id }}" {% unless current_variant.available %} disabled {% endunless %} js-add-to-cart>
          {% if current_variant.available %}BUY NOW{% elsif productTags contains 'coming_soon' %}COMING SOON{% else %}SOLD OUT{% endif %}
          <loading-spinner style="--bg-opacity: 100%; --size: 1.5rem;"></loading-spinner>
        </button>
        <noscript class="no-js">
          <a href="{{ product_card_product.url | within: collection }}" class="btn mt-20">BUY NOW</a>
        </noscript>
      {% endif %}
      {% endif %}

      {% comment %} TODO: metafield {% endcomment %}
      <span class="caption-large light">{{ block.settings.description | escape }}</span>
    </div>
  </div>
  </a>
</product-card>
