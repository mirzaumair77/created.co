{%- comment -%}
  Product item
  Accepts:
  - product: {Object} product
  - layout: {String} 'card' renders the arched bestseller card (search drawer).
    Leave empty for the default layout (product recommendations).
  - skip_style: {Boolean} skip loading product-item.css / product-form.js

  Card layout:
  - Title:    product.metafields.product_cards.product_card_title (fallback: product.title)
  - Subheading: product.metafields.custom.product_type
  - Rating:   product.metafields.reviews.rating / rating_count
  - "+ $price" pill is a product form; search-drawer.js submits it via AJAX
    (.disable-rebuy keeps Rebuy Smart Cart from taking over the submit)
{%- endcomment -%}

{%- liquid
  assign first_variant = product.selected_or_first_available_variant
  assign featured_image = product.featured_image
  assign title = product.title
  assign color_name = product.metafields.custom.color_name
  assign price = first_variant.price
  assign product_form_id = 'product-item-form-' | append: section.id | append: '-' | append: product.id
-%}

{%- if layout == 'card' -%}
  {%- liquid
    assign card_title = product.metafields.product_cards.product_card_title.value | default: title
    assign subheading = product.metafields.custom.product_type.value
    assign rating = product.metafields.reviews.rating.value.rating
    assign rating_count = product.metafields.reviews.rating_count.value | default: 0
    assign rating_pct = 0
    if rating
      assign rating_pct = rating | times: 1.0 | divided_by: 5 | times: 100
    endif
  -%}

  {%- unless skip_style -%}
    {{ 'product-item.css' | asset_url | stylesheet_tag }}
  {%- endunless -%}

  <div class="product-item product-item--card">
    <h3 class="product-item__title">
      <a href="{{ product.url }}" class="product-item__link">{{ card_title | escape }}</a>
    </h3>

    {%- if subheading != blank -%}
      <span class="product-item__tag">{{ subheading | escape }}</span>
    {%- else -%}
      <span class="product-item__tag product-item__tag--empty" aria-hidden="true">&nbsp;</span>
    {%- endif -%}

    <div class="product-item__image">
      {%- if featured_image != blank -%}
        {{
          featured_image
          | image_url: width: 400
          | image_tag:
            widths: '200, 300, 400',
            sizes: '160px',
            loading: 'lazy',
            alt: card_title
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="product-item__content">
      {%- if rating -%}
        <p class="product-item__rating">
          <span class="product-item__stars" style="--rating: {{ rating_pct }}%;" aria-hidden="true"></span>
          <span aria-hidden="true">{{ rating | round: 1 }}</span>
          <span aria-hidden="true">({{ rating_count }})</span>
          <span class="visually-hidden">Rated {{ rating | round: 1 }} out of 5 from {{ rating_count }} reviews</span>
        </p>
      {%- endif -%}

      {%- comment -%}
        disable-rebuy: Rebuy Smart Cart binds a submit handler to every form[action*="/cart"]
        that adds via Rebuy and stops propagation, so search-drawer.js (spinner, checkmark,
        closing the drawer) would never run.
      {%- endcomment -%}
      {%- form 'product', product, class: 'product-item__form disable-rebuy', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" value="{{ first_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button
          type="submit"
          name="add"
          class="product-item__atc"
          aria-label="{% if first_variant.available %}Add {{ card_title | escape }} to cart{% else %}{{ card_title | escape }} – {{ 'products.product.sold_out' | t }}{% endif %}"
          {% unless first_variant.available %}
            disabled
          {% endunless %}
        >
          <span class="product-item__plus" aria-hidden="true">
            <svg class="product-item__icon-plus" width="11" height="11" viewBox="0 0 11 11" fill="none">
              <path d="M5.5 0v11M0 5.5h11" stroke="currentColor" stroke-width="1.2"/>
            </svg>
            <svg class="product-item__icon-check" width="12" height="10" viewBox="0 0 12 10" fill="none">
              <path d="m1 5 3.5 3.5L11 1" stroke="currentColor" stroke-width="1.4"/>
            </svg>
            <span class="product-item__spinner"></span>
          </span>
          <span class="product-item__price">
            {%- if first_variant.available -%}
              {{ price | money_without_trailing_zeros }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>
        </button>
      {%- endform -%}
    </div>
  </div>
{%- else -%}

{%- unless skip_style -%}
  {{ 'product-item.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<a href="{{ product.url }}" class="product-item">
  <div class="product-item__image">
    {%- if featured_image != blank -%}
      {{
        featured_image
        | image_url: width: 600
        | image_tag:
          widths: '240, 320, 400, 480, 600',
          sizes: '(min-width: 750px) 406px, calc(100vw - 40px)',
          loading: 'lazy',
          alt: featured_image.alt
        | default: title
      }}
    {%- endif -%}
  </div>

  <div class="product-item__content">
    <div class="product-item__title">
      <h3>{{ title | escape }}</h3>
    </div>

    {%- if color_name != blank -%}
      <div class="product-item__title">
        <span>
          {{ color_name | escape }}
        </span>
      </div>
    {%- endif -%}

    <div class="product-item__price">
      <span>{{ price | money }}</span>
    </div>

    <product-form class="product-item__product-form">
      {%- form 'product',
        product,
        id: product_form_id,
        class: 'product-item__form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ first_variant.id }}"
          class="product-item__variant"
          {% unless first_variant.available %}
            disabled
          {% endunless %}
        >

        <button
          type="submit"
          name="add"
          class="product-item__button"
          {% unless first_variant.available %}
            disabled
          {% endunless %}
        >
          <span class="product-item__button-text">
            {%- if first_variant.available -%}
              Add to bag
            {%- else -%}
              Sold out
            {%- endif -%}
          </span>

          {%- if first_variant.available -%}
            <svg
              class="product-recommendations__spinner"
              viewBox="0 0 50 50"
              aria-hidden="true"
            >
              <circle
                class="product-recommendations__spinner-circle"
                cx="25"
                cy="25"
                r="20"
                fill="none"
                stroke="currentColor"
                stroke-width="4"
              ></circle>
            </svg>
          {%- endif -%}
        </button>
      {%- endform -%}
    </product-form>
  </div>
</a>
{%- endif -%}
