    "pursuit_description_ABtpfh": {
      "type": "pursuit-description",
      "settings": {
        "background_color": "#ffffff",
        "background_color_mobile": "#f7f2ee",
        "description": "<h3></h3><h3><strong>1. Durability Issues:</strong> Many of their ceramic wares chipped, cracked, or faded with frequent use, leading to costly and frequent replacements.</h3><h3><strong>2. Customization Limitations:</strong> They wanted drinkware that reflected their brand’s modern yet inviting aesthetic, but most suppliers couldn’t provide a truly customized solution.</h3><h3><strong>3. Inconsistency in Supply: </strong>With cafés across multiple cities, they struggled to find a supplier who could consistently deliver high-quality, custom-branded ceramics at scale.</h3>",
        "description_color": "#000000"
      }
    },
