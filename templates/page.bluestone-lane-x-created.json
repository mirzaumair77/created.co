        "image": "shopify://shop_images/Blue_Stone_Blog_Page_35559b91-269d-4cff-9e09-e4aa432d4b78.png",
        "heading": "OUR SOLUTION",
        "description": "<p>At Created Co., we specialize in providing restaurant-grade ceramics designed specifically for the hospitality industry. Our team worked closely with Bluestone Lane to develop a line of custom ceramics that not only met their durability requirements but also strengthened their brand presence.</p>",
        "heading_color": "#ffffff",
        "description_color": "#ffffff"
      }
