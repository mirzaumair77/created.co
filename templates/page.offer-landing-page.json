            "button_url": "#catalog",
            "button_dark": false,
            "banner_image": "shopify://shop_images/AbbyCox-CreatedCo-JoshuaTree24-227_30.png_1.png"
          }
        },
        "indstrieserved_3qNfD4": {
          "type": "indstrieserved",
          "settings": {
            "heading": "Public & Resort Courses",
            "text": "<p>Turn a round into something guests take with them. Custom drinkware gives the shop a margin-friendly item that markets the course long after checkout.</p>",
            "button_text": "Get Started",
            "button_url": "#catalog",
            "button_dark": false,
            "banner_image": "shopify://shop_images/AbbyCox-CreatedCo-JoshuaTree24-227_30.png_2_42333f53-e40c-4ca1-8ba8-2ecf74ba08e4.png"
          }
        },
        "indstrieserved_zqRtab": {
          "type": "indstrieserved",
          "settings": {
            "heading": "Hospitality & F&B",
            "text": "<p>Outfit the turn, the halfway house and the clubhouse bar with drinkware built for commercial service and designed to match the rest of the property.</p>",
            "button_text": "Get Started",
            "button_url": "#catalog",
            "button_dark": false,
            "banner_image": "shopify://shop_images/CC_CustomLP_Industry_Hospitality.jpg"
