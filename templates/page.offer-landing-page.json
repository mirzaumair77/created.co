      "type": "industrie-served-v4",
      "blocks": {
        "indstrieserved_penEA6": {
          "type": "indstrieserved",
          "settings": {
            "heading": "Private Clubs",
            "text": "<p>Member gifts, tournament prizes and pro shop inventory that carry your club's identity without looking like promotional product. Pieces members use at home, not just on property.</p>",
