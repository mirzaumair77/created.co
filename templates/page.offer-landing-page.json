        },
        "indstrieserved_9TUM9b": {
          "type": "indstrieserved",
          "settings": {
            "heading": "Tournaments & Events",
            "text": "<p>Sponsor gifts and player packages that don't end up in a drawer. Our team handles art, production and delivery against a fixed event date.</p>",
