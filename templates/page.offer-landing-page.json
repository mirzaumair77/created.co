    "how_it_work_J3L9T7": {
      "type": "how-it-work",
      "blocks": {
        "item_DhLJmC": {
          "type": "item",
          "settings": {
            "heading": "Concept",
            "text": "<p>Share your club's marks and colors. From initial sketches to digital mockups, we make sure every detail aligns before anything is produced.</p>"
          }
        },
        "item_bPp4hj": {
          "type": "item",
          "settings": {
            "heading": "Craft",
            "text": "<p>Our team helps select the right material and printing method, so your logo holds up to a full season in a cart and a clubhouse dishwasher.</p>"
          }
        },
        "item_P7PNMQ": {
          "type": "item",
          "settings": {
            "heading": "Create",
            "text": "<p>We produce and ship on the timeline your season, member event or shop reset requires.</p>"
          }
        }
      },
