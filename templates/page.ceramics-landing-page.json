    "limitless_solution_mbGLRm": {
      "type": "limitless-solution",
      "blocks": {
        "content_AydVp9": {
          "type": "content",
          "settings": {
            "heading": "CUSTOM GLAZES",
            "description": "<p>Our story begins with coffee, where we learned firsthand how the perfect vessel elevates every coffee moment. We partner with master baristas and Michelin Star restaurants to develop beautiful ceramics. No detail is too small—from the curve of the lip to the weight in hand—each element enhances the art of service.</p>"
          }
        },
        "content_3bMzpM": {
          "type": "content",
          "settings": {
            "heading": "Complete Creative Control",
            "description": "<p>From concept to creation, we bring your vision to life. Whether you're launching a signature piece unique to your brand or want to push the boundaries with our industry-leading techniques, our customization options ensure your ceramics stand out.</p>"
          }
        },
        "content_7HjwLU": {
          "type": "content",
          "settings": {
            "heading": "Dream Bigger with our Custom Solutions",
            "description": "<p>From boutique cafés to international chains, we bring ambitious visions to life. Our expertise in large-scale hospitality projects means we can deliver custom ceramic collections that maintain exceptional quality whether you need hundreds or hundreds of thousands of pieces.</p>"
          }
        }
      },
      "block_order": [
        "content_AydVp9",
