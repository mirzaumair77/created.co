    "capasbilities_feature_iPTjpg": {
      "type": "capasbilities-feature",
      "blocks": {
        "feature_bUdpXW": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/restaurant.png",
            "heading": "Restaurant Grade Quality",
            "description": "<p>Our professional-grade ceramics combine the <strong>durability demanded by commercial </strong>kitchens with elegant design, ensuring your dinnerware maintains its pristine appearance through years of intensive use.</p>"
          }
        },
        "feature_m3zT7T": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/restaurant.png",
            "heading": "High Fire Printing",
            "description": "<p>Our process allows <strong>permanent designs and rich</strong> colors to become fully vitrified with the ceramic surface, creating <strong>fade-resistant</strong>, commercial dishwasher-safe pieces that maintain brilliance.</p>"
          }
        },
        "feature_cwqDYK": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/quality_design.png",
            "heading": "Quality DESIGNS",
            "description": "<p>Each piece is crafted from premium clay and personalized using food-safe glazes, exceeding industry standards for <strong>chip resistance and performance.</strong></p>"
          }
        },
        "feature_6hCCkf": {
          "type": "feature",
          "settings": {
            "icon": "shopify://shop_images/crafted.png",
            "heading": "Crafted by INDUSTRY Experts",
            "description": "<p>We began with coffee, where we learned how the perfect vessel elevates every coffee moment. Now, we partner with master baristas and Michelin Star restaurants to <strong>develop hospitality grade </strong>wares where each element enhances the art of service.</p>"
          }
        }
      },
