        },
        "857cb31f-88de-458a-af2a-9efced5e966e": {
          "type": "icon_text",
          "settings": {
            "svg_icon": "",
            "title": "<p>SUBMIT YOUR DESIGN</p>",
            "body_text": "We’ll give you the details when it comes to what we need, but this is where you get to have some fun. From logos to full wrap prints, we’ve got you (and your cup) covered."
          }
        },
        "6a5d6dc4-da81-4d49-97ca-9cdf5ba14be9": {
          "type": "icon_text",
          "settings": {
            "svg_icon": "",
            "title": "<p>PLACE YOUR ORDER</p>",
            "body_text": "You’ve done your part and now it’s our turn. While every custom order’s different, we always do our best to create your product as quickly and with as much care as possible."
          }
        }
