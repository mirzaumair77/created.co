    "half-text": {
      "type": "half-text",
      "disabled": true,
      "settings": {
        "big_text": "We love your creativity and working with you to bring it to life is our favorite thing. From merch to gear for your crew, we know what you’re up to.",
        "main_text": "<p>Custom orders are usually for brands or individuals looking to make something that doesn’t exist anywhere else. We take all the same care and attention we put into our own products and point it directly at yours. From big bold prints to logos and color matched, well, anything, we take you through the process of making it yours. Learn more about our materials, printing options, laser etching, and more.</p>",
        "font": "serif",
        "main_text_padding": true,
        "link_text": "Download Catalog",
