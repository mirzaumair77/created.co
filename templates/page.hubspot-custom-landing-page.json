          "type": "item",
          "settings": {
            "heading": "Concept",
            "text": "<p>Share your vision with us. From initial sketches to digital mockups, we ensure every detail aligns with your goals.</p>"
          }
        },
        "item_bPp4hj": {
          "type": "item",
          "settings": {
            "heading": "Craft",
            "text": "<p>Bring your design to life. Our team helps select the perfect printing method to transform your concept into a stunning product.</p>"
          }
        },
        "item_P7PNMQ": {
          "type": "item",
          "settings": {
            "heading": "Create",
            "text": "<p>Our logistics ensure your custom drinkware order arrives quickly, ready to make an impact for your business.</p>"
          }
        }
      },
