            "banner_image": "shopify://shop_images/AbbyCox-CreatedCo-JoshuaTree24-227_30.png"
          }
        },
        "indstrieserved_3qNfD4": {
          "type": "indstrieserved",
          "settings": {
            "heading": "RETAIL",
            "text": "<p>Transform retail offerings with custom drinkware that turns an everyday item into a must-have. Whether you're a boutique gift shop or a national chain, Created products are designed to inspire.</p>",
