      "blocks": {
        "indstrieserved_penEA6": {
          "type": "indstrieserved",
          "settings": {
            "heading": "BREWERIES",
            "text": "<p> Whether it’s for the merch wall, a limited release, or a community event, Created drinkware helps reinforce your identity, extend your taproom experience, and give your patrons something they’ll reach for every day.</p>",
