            "button_url": "#catalog",
            "button_dark": false,
            "banner_image": "shopify://shop_images/CC_CustomLP_Industry_Retail.jpg"
          }
        },
        "indstrieserved_zqRtab": {
          "type": "indstrieserved",
          "settings": {
            "heading": "Hospitality",
            "text": "<p>Enhance your café's brand presence with our custom drinkware. Create additional touchpoints with customers, reinforce brand loyalty, and open new avenues for customer engagement and revenue growth.</p>",
            "button_text": "Get Started",
            "button_url": "#catalog",
            "button_dark": false,
            "banner_image": "shopify://shop_images/CC_CustomLP_Industry_Hospitality.jpg"
          }
        },
        "indstrieserved_9TUM9b": {
