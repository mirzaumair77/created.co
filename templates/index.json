            "question": "Which lids fit which bases?",
            "answer": "<p>Every Nomad lid fits every Nomad base, so you can mix and match as you go.</p>"
          }
        },
        "faq_KiLmYP": {
          "type": "faq",
          "settings": {
            "question": "Is Created drinkware dishwasher safe?",
            "answer": "<p>Lids are top-rack dishwasher safe. We recommend hand washing the bases to protect the finish.</p>"
          }
        },
        "faq_EecTaz": {
