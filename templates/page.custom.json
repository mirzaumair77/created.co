          "settings": {
            "svg_icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"61.375\" height=\"71.473\" viewbox=\"0 0 61.375 71.473\">\n  <g id=\"Group_59\" data-name=\"Group 59\" transform=\"translate(-741.389 -5475.073)\">\n    <g id=\"Group_58\" data-name=\"Group 58\">\n      <path id=\"Path_81\" data-name=\"Path 81\" d=\"M772.076,5546.046a30.222,30.222,0,0,1-30.187-30.188v-40.285h60.375v40.285a30.222,30.222,0,0,1-30.188,30.188\" fill=\"none\" stroke=\"#12100b\" stroke-miterlimit=\"10\" stroke-width=\"1\"></path>\n      <circle id=\"Ellipse_8\" data-name=\"Ellipse 8\" cx=\"8.06\" cy=\"8.06\" r=\"8.06\" transform=\"translate(764.018 5498.748)\" fill=\"none\" stroke=\"#12100b\" stroke-miterlimit=\"10\" stroke-width=\"1\"></circle>\n      <line id=\"Line_20\" data-name=\"Line 20\" y2=\"36.549\" transform=\"translate(772.076 5487.827)\" fill=\"none\" stroke=\"#12100b\" stroke-miterlimit=\"10\" stroke-width=\"1\"></line>\n      <line id=\"Line_21\" data-name=\"Line 21\" x1=\"36.178\" transform=\"translate(754.51 5506.808)\" fill=\"none\" stroke=\"#12100b\" stroke-miterlimit=\"10\" stroke-width=\"1\"></line>\n    </g>\n  </g>\n</svg>",
