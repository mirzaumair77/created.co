    "half-text": {
      "type": "half-text",
      "settings": {
        "big_text": "We love your creativity and working with you to bring it to life is our favorite thing. From merch to gear for your crew, we know what you’re up to.",
        "main_text": "<p>Custom orders are usually for brands or individuals looking to make something that doesn’t exist anywhere else. We take all the same care and attention we put into our own products and point it directly at yours. From big bold prints to logos and color matched, well, anything, we take you through the process of making it yours. Learn more about our materials, printing options, laser etching, and more.</p>",
        "font": "serif",
        "main_text_padding": true,
        "link_text": "Download Catalog",
        "link_url": "https://cdn.shopify.com/s/files/1/0662/7045/files/Custom_Catalog_NEW_2026_3_V2_c5e36911-d96c-4f30-ae4f-ba83e8bf02a4.pdf?v=1770333492",
        "extra_spacing": true,
        "button_below": true
      }
    },
    "embed": {
      "type": "embed",
      "settings": {
        "title_text": "<p>Ready to get started? <br>Download our catalog and <br>drop us a line.</p>",
        "bg_color": "#f5f5f5",
        "detail_text": "",
        "form_id": "<div class=\"my_form_style\">\n    <script charset=\"utf-8\" type=\"text/javascript\" src=\"//js.hsforms.net/forms/embed/v2.js\"></script> <script>\n      hbspt.forms.create({\n        region: \"na1\",\n        portalId: \"41774798\",\n        formId: \"6a37c195-8d44-430f-a4d8-cbcd43820000\"\n      });\n    </script>\n</div>",
        "button_text": "",
        "button_link": "",
        "dark_btn": true
      }
    },
    "icons-text": {
      "type": "icons-with-text",
      "blocks": {
        "1592b420-e950-4c11-98a9-f2e160658116": {
          "type": "icon_text",
          "settings": {
            "svg_icon": "",
            "title": "<p>PICK A PRODUCT</p>",
            "body_text": "Start here. Are you creating something for at home or on the go? For your cafe, business, or personal? Is it hot or cold? Don’t worry, the answer can be yes to all."
          }
        },
        "857cb31f-88de-458a-af2a-9efced5e966e": {
          "type": "icon_text",
          "settings": {
            "svg_icon": "",
            "title": "<p>SUBMIT YOUR DESIGN</p>",
            "body_text": "We’ll give you the details when it comes to what we need, but this is where you get to have some fun. From logos to full wrap prints, we’ve got you (and your cup) covered."
          }
        },
        "6a5d6dc4-da81-4d49-97ca-9cdf5ba14be9": {
          "type": "icon_text",
          "settings": {
            "svg_icon": "",
            "title": "<p>PLACE YOUR ORDER</p>",
            "body_text": "You’ve done your part and now it’s our turn. While every custom order’s different, we always do our best to create your product as quickly and with as much care as possible."
          }
        }
      },
