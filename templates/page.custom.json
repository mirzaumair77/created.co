            "svg_icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"61.376\" height=\"71.473\" viewbox=\"0 0 61.376 71.473\">\n  <g id=\"Group_57\" data-name=\"Group 57\" transform=\"translate(-230.579 -5475.255)\">\n    <g id=\"Group_56\" data-name=\"Group 56\">\n      <path id=\"Path_79\" data-name=\"Path 79\" d=\"M261.267,5546.228a30.222,30.222,0,0,1-30.188-30.187v-40.286h60.376v40.286a30.222,30.222,0,0,1-30.188,30.187\" fill=\"none\" stroke=\"#12100b\" stroke-miterlimit=\"10\" stroke-width=\"1\"></path>\n      <path id=\"Path_80\" data-name=\"Path 80\" d=\"M274.516,5514.649a13.249,13.249,0,1,1-26.5,0c0-9.452,13.249-24.929,13.249-24.929S274.516,5505.2,274.516,5514.649Z\" fill=\"none\" stroke=\"#12100b\" stroke-miterlimit=\"10\" stroke-width=\"1\"></path>\n    </g>\n  </g>\n</svg>",
